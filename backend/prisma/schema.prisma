model PesEventoAvaliacao {
  id              String   @id @default(uuid())
  tenantId        String
  trabalhoId      String
  avaliadorUserId String
  avaliadorNome   String?
  prazo           DateTime?
  concluida       Boolean  @default(false)
  nota            Float?
  recomendacao    String?   // APROVAR | APROVAR_COM_AJUSTES | REPROVAR
  parecer         String?
  concluidaEm     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trabalho        PesEventoTrabalho @relation(fields: [trabalhoId], references: [id], onDelete: Cascade)

  @@unique([trabalhoId, avaliadorUserId])
  @@index([tenantId, avaliadorUserId, concluida])
}

// ---- edu/regulatorio.prisma ----
// ============================================================
// EDUMASTER PRO — REGULATÓRIO (MEC/INEP) — prefixo Reg
// ============================================================

enum RegTipoProcesso {
  CREDENCIAMENTO
  RECREDENCIAMENTO
  AUTORIZACAO_CURSO
  RECONHECIMENTO_CURSO
  RENOVACAO_RECONHECIMENTO
  ADITAMENTO_VAGAS
  ADITAMENTO_ENDERECO
  ADITAMENTO_POLO_EAD
  TRANSFERENCIA_MANTENCA
  OUTRO
}

enum RegEtapa {
  PREPARACAO
  PROTOCOLADO
  EM_ANALISE
  DILIGENCIA
  AVALIACAO_IN_LOCO
  DECISAO
  PUBLICADO
  ARQUIVADO
}

enum RegResultado {
  PENDENTE
  DEFERIDO
  INDEFERIDO
  ARQUIVADO
}

model RegProcesso {
  id              String   @id @default(uuid())
  tenantId        String
  tipo            RegTipoProcesso
  etapa           RegEtapa @default(PREPARACAO)
  resultado       RegResultado @default(PENDENTE)
  titulo          String
  programId       String?       // AcademicProgram (sem relation)
  cursoNome       String?
  protocoloEmec   String?
  numeroProcesso  String?
  responsavelId   String?
  vagasSolicitadas Int?
  enderecoNovo    String?
  conceitoObtido  Int?
  protocoladoEm   DateTime?
  prazoProtocolo  DateTime?     // prazo interno/legal para protocolar
  avaliacaoPrevistaEm DateTime?
  decisaoPrevistaEm DateTime?
  publicadoEm     DateTime?
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  historico       RegProcessoHistorico[]
  diligencias     RegDiligencia[]
  checklists      RegChecklist[]

  @@index([tenantId, etapa])
  @@index([tenantId, tipo])
  @@index([tenantId, programId])
}

model RegProcessoHistorico {
  id          String   @id @default(uuid())
  tenantId    String
  processoId  String
  etapaDe     RegEtapa?
  etapaPara   RegEtapa
  userId      String?
  observacao  String?
  createdAt   DateTime @default(now())

  processo    RegProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@index([tenantId, processoId])
}

enum RegDiligenciaStatus {
  ABERTA
  RESPONDIDA
  CUMPRIDA
  VENCIDA
  CANCELADA
}

model RegDiligencia {
  id            String   @id @default(uuid())
  tenantId      String
  processoId    String
  descricao     String
  exigencias    Json?          // [{texto, atendida}]
  recebidaEm    DateTime @default(now())
  prazoResposta DateTime
  status        RegDiligenciaStatus @default(ABERTA)
  responsavelId String?
  resposta      String?
  respondidaEm  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  processo      RegProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, prazoResposta])
  @@index([tenantId, processoId])
}

enum RegTipoAto {
  PORTARIA_CREDENCIAMENTO
  PORTARIA_RECREDENCIAMENTO
  PORTARIA_AUTORIZACAO
  PORTARIA_RECONHECIMENTO
  PORTARIA_RENOVACAO
  PORTARIA_ADITAMENTO
  RESOLUCAO
  PARECER
  OUTRO
}

// Repositório de atos regulatórios (portarias/DOU)
model RegAto {
  id              String   @id @default(uuid())
  tenantId        String
  tipo            RegTipoAto
  numero          String
  orgao           String   @default("MEC")
  dataPublicacao  DateTime
  referenciaDou   String?
  programId       String?
  cursoNome       String?
  escopo          String   @default("CURSO")   // CURSO | INSTITUICAO
  processoId      String?
  vigenciaInicio  DateTime?
  vencimento      DateTime?       // fim da vigência (nulo = sem prazo)
  vagasAutorizadas Int?
  cicloAvaliativoAnos Int?
  conceito        Int?
  revogado        Boolean  @default(false)
  anexos          Json?            // [{nome,url,dataUrl,mime}]
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, tipo, numero])
  @@index([tenantId, vencimento])
  @@index([tenantId, programId])
}

enum RegInstrumento {
  INSTITUCIONAL
  CURSO_AUTORIZACAO
  CURSO_RECONHECIMENTO
  CURSO_RENOVACAO
  DOCUMENTAL
}

enum RegDimensao {
  ORGANIZACAO_DIDATICO_PEDAGOGICA
  CORPO_DOCENTE_TUTORIAL
  INFRAESTRUTURA
  DOCUMENTAL
  GESTAO_INSTITUCIONAL
}

model RegChecklistModelo {
  id          String   @id @default(uuid())
  tenantId    String
  chave       String
  nome        String
  tipoProcesso RegTipoProcesso?
  instrumento RegInstrumento @default(DOCUMENTAL)
  descricao   String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens       RegChecklistModeloItem[]

  @@unique([tenantId, chave])
  @@index([tenantId, tipoProcesso])
}

model RegChecklistModeloItem {
  id          String   @id @default(uuid())
  tenantId    String
  modeloId    String
  ordem       Int      @default(0)
  dimensao    RegDimensao @default(DOCUMENTAL)
  titulo      String
  descricao   String?
  obrigatorio Boolean  @default(true)
  peso        Int      @default(1)
  prazoDias   Int?             // prazo relativo (dias após criação do checklist)
  responsavelRole String?

  modelo      RegChecklistModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@index([tenantId, modeloId])
}

model RegChecklist {
  id          String   @id @default(uuid())
  tenantId    String
  nome        String
  modeloId    String?
  instrumento RegInstrumento @default(DOCUMENTAL)
  processoId  String?
  programId   String?
  prontidao   Float    @default(0)      // 0..100 (cache)
  prazo       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  processo    RegProcesso? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  itens       RegChecklistItem[]

  @@index([tenantId, processoId])
  @@index([tenantId, programId])
}

enum RegItemStatus {
  PENDENTE
  EM_ANDAMENTO
  ATENDIDO
  NAO_APLICAVEL
}

model RegChecklistItem {
  id            String   @id @default(uuid())
  tenantId      String
  checklistId   String
  ordem         Int      @default(0)
  dimensao      RegDimensao @default(DOCUMENTAL)
  titulo        String
  descricao     String?
  obrigatorio   Boolean  @default(true)
  peso          Int      @default(1)
  status        RegItemStatus @default(PENDENTE)
  responsavelId String?
  prazo         DateTime?
  evidenciaUrl  String?
  evidenciaTexto String?
  evidencias    Json?            // [{nome,url,dataUrl}]
  conferenciaIA Json?            // última conferência por IA/manual
  concluidoEm   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checklist     RegChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([tenantId, checklistId])
  @@index([tenantId, status, prazo])
}

// Autoavaliação por indicador (conceito 1-5)
model RegIndicador {
  id            String   @id @default(uuid())
  tenantId      String
  instrumento   RegInstrumento
  dimensao      RegDimensao
  codigo        String           // ex.: 1.1
  nome          String
  programId     String?
  conceito      Int?             // 1..5
  justificativa String?
  planoMelhoria String?
  responsavelId String?
  prazoMelhoria DateTime?
  avaliadoEm    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, instrumento, dimensao])
  @@index([tenantId, programId])
}

model RegSimulacao {
  id          String   @id @default(uuid())
  tenantId    String
  tipo        String           // CPC | CC
  programId   String?
  rotulo      String?
  entrada     Json
  resultado   Json
  userId      String?
  createdAt   DateTime @default(now())

  @@index([tenantId, tipo, createdAt])
}

model RegAnaliseDocumento {
  id          String   @id @default(uuid())
  tenantId    String
  tipoDocumento String           // PORTARIA | RELATORIO_AVALIACAO | DILIGENCIA | OUTRO
  titulo      String?
  processoId  String?
  texto       String
  modo        String   @default("MANUAL")   // IA | HEURISTICO | MANUAL
  resumo      String?
  prazos      Json?
  exigencias  Json?
  tarefasCriadas Json?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([tenantId, processoId])
  @@index([tenantId, createdAt])
}

// ---- edu/reitoria.prisma ----
// ============================================================
// EDUMASTER PRO — REITORIA (prefixo Rei)
// Metas/OKRs institucionais, histórico de indicadores (snapshots),
// relatórios executivos salvos e log do assistente executivo.
// ============================================================

enum ReiStatusObjetivo {
  RASCUNHO
  ATIVO
  CONCLUIDO
  CANCELADO
}

enum ReiFonteResultado {
  MANUAL
  INDICADOR
}

enum ReiSentido {
  MAIOR_MELHOR
  MENOR_MELHOR
}

enum ReiConfianca {
  VERDE
  AMARELO
  VERMELHO
}

// Objetivo (O de OKR): qualitativo, com ciclo, dono e nível (instituição, curso, área).
model ReiObjetivo {
  id               String   @id @default(uuid())
  tenantId         String
  codigo           String
  titulo           String
  descricao        String?
  ciclo            String        // ex.: "2026", "2026-S2", "2026-T4"
  nivel            String   @default("INSTITUCIONAL")   // INSTITUCIONAL | CURSO | AREA
  programId        String?       // curso (sem @relation: módulo acadêmico)
  area             String?       // financeiro, secretaria, biblioteca...
  responsavelUserId String?
  responsavelNome  String?
  inicio           DateTime
  fim              DateTime
  status           ReiStatusObjetivo @default(RASCUNHO)
  progresso        Float    @default(0)      // cache 0..100 (média ponderada dos KRs)
  ativadoEm        DateTime?
  concluidoEm      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  resultados       ReiResultadoChave[]

  @@unique([tenantId, codigo])
  @@index([tenantId, ciclo, status])
  @@index([tenantId, programId])
}

// Resultado-chave (KR): mensurável; alimentado manualmente (check-ins) ou
// automaticamente por um indicador do painel (indicadorChave).
model ReiResultadoChave {
  id               String   @id @default(uuid())
  tenantId         String
  objetivoId       String
  titulo           String
  unidade          String?
  sentido          ReiSentido @default(MAIOR_MELHOR)
  valorInicial     Float
  valorMeta        Float
  valorAtual       Float
  fonte            ReiFonteResultado @default(MANUAL)
  indicadorChave   String?       // chave do indicador do painel (ver GET /reitoria/indicadores/catalogo)
  responsavelUserId String?
  peso             Float    @default(1)
  progresso        Float    @default(0)      // 0..100
  confianca        ReiConfianca @default(VERDE)
  checkinFrequenciaDias Int @default(14)
  proximoCheckinEm DateTime?
  ultimoCheckinEm  DateTime?
  concluidoEm      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  objetivo         ReiObjetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  checkins         ReiCheckin[]

  @@index([tenantId, objetivoId])
  @@index([tenantId, indicadorChave])
}

model ReiCheckin {
  id               String   @id @default(uuid())
  tenantId         String
  resultadoId      String
  valor            Float
  valorAnterior    Float?
  confianca        ReiConfianca @default(VERDE)
  comentario       String?
  origem           String   @default("MANUAL")   // MANUAL | AUTO (sincronização com indicador)
  autorId          String?
  createdAt        DateTime @default(now())

  resultado        ReiResultadoChave @relation(fields: [resultadoId], references: [id], onDelete: Cascade)

  @@index([tenantId, resultadoId, createdAt])
}

// Valor diário de cada indicador institucional: base da variação vs. período anterior.
model ReiSnapshot {
  id         String   @id @default(uuid())
  tenantId   String
  chave      String
  dia        String        // YYYY-MM-DD
  valor      Float
  semaforo   String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, chave, dia])
  @@index([tenantId, dia])
}

// Relatório executivo salvo (foto do período, imprimível depois).
model ReiRelatorio {
  id          String   @id @default(uuid())
  tenantId    String
  titulo      String
  periodo     String?
  perfil      String   @default("reitoria")
  geradoPorId String?
  dados       Json
  html        String
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Auditoria das perguntas feitas ao assistente executivo.
model ReiConsultaIA {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  perfil     String?
  pergunta   String
  resposta   String
  modo       String        // IA | HEURISTICO
  indicadoresCitados Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ---- edu/secretaria.prisma ----
// ============================================================
// EDUMASTER PRO — SECRETARIA ACADÊMICA (prefixo Sec)
// Protocolo/requerimentos, documentos, conferência, certificados,
// diplomas/colação/livros, arquivo e temporalidade.
// ============================================================

enum SecProtocoloStatus {
  ABERTO
  EM_ANALISE
  PENDENTE_DOCUMENTO
  DEFERIDO
  INDEFERIDO
  CONCLUIDO
  CANCELADO
}

enum SecTaxaStatus {
  ISENTA
  PENDENTE
  PAGA
  CANCELADA
}

enum SecConferenciaStatus {
  EM_ANDAMENTO
  PENDENTE
  APROVADA
  REPROVADA
}

enum SecItemStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

enum SecCertificadoStatus {
  EMITIDO
  REVOGADO
  SUBSTITUIDO
}

enum SecDiplomaStatus {
  SOLICITADO
  CONFERENCIA
  PENDENCIA
  REGISTRO
  REGISTRADO
  ENTREGUE
  CANCELADO
}

enum SecColacaoStatus {
  PLANEJADA
  CONVOCADA
  REALIZADA
  ENCERRADA
  CANCELADA
}

enum SecFormandoStatus {
  INSCRITO
  APTO
  PENDENTE
  COLOU
  AUSENTE
  EXCLUIDO
}

enum SecArquivoStatus {
  ATIVO
  ELEGIVEL_DESCARTE
  DESCARTE_SOLICITADO
  DESCARTADO
  GUARDA_PERMANENTE
  SUSPENSO
}

enum SecDescarteStatus {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADO
  REJEITADO
  EXECUTADO
}

// Contador atômico por tenant/chave (protocolo ANO/SEQ, nº de certificado, registro de diploma...).
model SecContador {
  id        String   @id @default(uuid())
  tenantId  String
  chave     String
  valor     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chave])
}

// ---------- REQUERIMENTOS / PROTOCOLO ----------

model SecTipoRequerimento {
  id                String   @id @default(uuid())
  tenantId          String
  codigo            String
  nome              String
  descricao         String?
  categoria         String   @default("GERAL")   // ACADEMICO, DOCUMENTO, FINANCEIRO, DIPLOMA, GERAL
  slaDias           Int      @default(5)          // dias úteis
  taxa              Float    @default(0)
  geraDocumento     String?                       // tipo de documento emitido automaticamente ao concluir (DECLARACAO_MATRICULA...)
  abertoPeloAluno   Boolean  @default(true)
  exigeAnexo        Boolean  @default(false)
  checklistModeloId String?
  prazoReenvioDias  Int      @default(15)
  responsavelRole   String   @default("SECRETARY")
  camposExtras      Json?                         // [{chave,rotulo,obrigatorio}]
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  protocolos        SecProtocolo[]

  @@unique([tenantId, codigo])
  @@index([tenantId, ativo])
}

model SecProtocolo {
  id               String   @id @default(uuid())
  tenantId         String
  numero           String                         // ANO/SEQ  ex.: 2026/000123
  ano              Int
  seq              Int
  tipoId           String
  studentId        String?
  enrollmentId     String?
  solicitanteNome  String?
  assunto          String
  descricao        String?
  status           SecProtocoloStatus @default(ABERTO)
  prioridade       String   @default("NORMAL")    // BAIXA, NORMAL, ALTA, URGENTE
  canal            String   @default("PORTAL")    // PORTAL, BALCAO, EMAIL, TELEFONE
  abertoPorId      String?
  responsavelId    String?
  slaDias          Int      @default(5)
  prazoEm          DateTime
  pendenteDesde    DateTime?
  taxaValor        Float    @default(0)
  taxaStatus       SecTaxaStatus @default(ISENTA)
  receivableId     String?
  decisao          String?
  decisaoMotivo    String?
  decididoEm       DateTime?
  concluidoEm      DateTime?
  escalonadoEm     DateTime?
  dados            Json?
  documentoCodigo  String?                        // documento gerado na conclusão
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tipo             SecTipoRequerimento @relation(fields: [tipoId], references: [id])
  tramites         SecTramite[]
  anexos           SecAnexo[]

  @@unique([tenantId, ano, seq])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, prazoEm])
}

model SecTramite {
  id            String   @id @default(uuid())
  tenantId      String
  protocoloId   String
  acao          String                            // ABERTURA, STATUS, COMENTARIO, ANEXO, ATRIBUICAO, ESCALONAMENTO, TAXA...
  deStatus      String?
  paraStatus    String?
  usuarioId     String?
  usuarioNome   String?
  origem        String   @default("SECRETARIA")   // SECRETARIA, ALUNO, SISTEMA
  parecer       String?
  visivelAluno  Boolean  @default(true)
  createdAt     DateTime @default(now())

  protocolo     SecProtocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  @@index([tenantId, protocoloId, createdAt])
}

model SecAnexo {
  id              String   @id @default(uuid())
  tenantId        String
  protocoloId     String
  nome            String
  mime            String?
  tamanho         Int?
  url             String?
  dataUrl         String?
  descricao       String?
  enviadoPorId    String?
  enviadoPorAluno Boolean  @default(false)
  createdAt       DateTime @default(now())

  protocolo       SecProtocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  @@index([tenantId, protocoloId])
}

// ---------- CHECKLISTS E CONFERÊNCIA DE DOCUMENTOS ----------

model SecChecklistModelo {
  id          String   @id @default(uuid())
  tenantId    String
  codigo      String
  nome        String
  processo    String                              // MATRICULA, TRANSFERENCIA, APROVEITAMENTO, ESTAGIO, DIPLOMA, COLACAO...
  descricao   String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens       SecChecklistItemModelo[]

  @@unique([tenantId, codigo])
  @@index([tenantId, processo])
}

model SecChecklistItemModelo {
  id           String   @id @default(uuid())
  tenantId     String
  modeloId     String
  ordem        Int      @default(0)
  titulo       String
  descricao    String?
  obrigatorio  Boolean  @default(true)
  validadeDias Int?                               // documento não pode ser mais antigo que N dias
  requisitos   String?                            // o que a IA/analista deve verificar
  createdAt    DateTime @default(now())

  modelo       SecChecklistModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@index([tenantId, modeloId])
}

model SecConferencia {
  id            String   @id @default(uuid())
  tenantId      String
  modeloId      String?
  processo      String
  titulo        String
  protocoloId   String?
  studentId     String?
  refType       String?
  refId         String?
  status        SecConferenciaStatus @default(EM_ANDAMENTO)
  concluidaEm   DateTime?
  criadoPorId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itens         SecConferenciaItem[]

  @@index([tenantId, status])
  @@index([tenantId, protocoloId])
  @@index([tenantId, studentId])
  @@index([tenantId, refType, refId])
}

model SecConferenciaItem {
  id                 String   @id @default(uuid())
  tenantId           String
  conferenciaId      String
  itemModeloId       String?
  ordem              Int      @default(0)
  titulo             String
  obrigatorio        Boolean  @default(true)
  validadeDias       Int?
  requisitos         String?
  status             SecItemStatus @default(PENDENTE)
  motivo             String?
  anexoId            String?
  arquivoNome        String?
  arquivoUrl         String?
  arquivoDataUrl     String?
  documentoTexto     String?                      // texto/descrição do documento (OCR, digitação)
  dataDocumento      DateTime?
  analiseIa          Json?
  analisadoPorId     String?
  analisadoEm        DateTime?
  reenvioSolicitadoEm DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conferencia        SecConferencia @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)

  @@index([tenantId, conferenciaId])
}

// ---------- DOCUMENTOS EMITIDOS (declarações, histórico) ----------

model SecDocumentoEmitido {
  id            String   @id @default(uuid())
  tenantId      String
  tipo          String                            // DECLARACAO_MATRICULA, DECLARACAO_VINCULO, HISTORICO_ESCOLAR...
  studentId     String?
  protocoloId   String?
  codigo        String   @unique                  // código de verificação
  hash          String                            // SHA-256 do HTML
  html          String
  validoAte     DateTime?
  emitidoPorId  String?
  cancelado     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([tenantId, tipo])
  @@index([tenantId, studentId])
}

// ---------- CERTIFICADOS ----------

model SecCertModelo {
  id           String   @id @default(uuid())
  tenantId     String
  codigo       String
  nome         String
  tipo         String                             // CURSO, EXTENSAO, EVENTO, POS_GRADUACAO, MONITORIA, PARTICIPACAO
  titulo       String   @default("CERTIFICADO")
  texto        String                             // com {{variaveis}}
  htmlCustom   String?                            // HTML completo opcional (com {{variaveis}} e {{CABECALHO}})
  orientacao   String   @default("landscape")
  assinaturas  Json?                              // [{nome,cargo,assetKind?}]
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  certificados SecCertificado[]
  lotes        SecCertLote[]

  @@unique([tenantId, codigo])
  @@index([tenantId, tipo])
}

model SecCertLote {
  id          String   @id @default(uuid())
  tenantId    String
  modeloId    String
  nome        String
  total       Int      @default(0)
  criadoPorId String?
  createdAt   DateTime @default(now())

  modelo      SecCertModelo @relation(fields: [modeloId], references: [id])
  certificados SecCertificado[]

  @@index([tenantId, modeloId])
}

model SecCertificado {
  id               String   @id @default(uuid())
  tenantId         String
  modeloId         String
  loteId           String?
  numero           String                         // ANO/SEQ
  codigo           String   @unique               // verificação pública
  hash             String
  status           SecCertificadoStatus @default(EMITIDO)
  destinatarioNome String
  destinatarioDoc  String?
  studentId        String?
  tituloEvento     String
  cargaHoraria     Int?
  periodo          String?
  dados            Json?
  html             String
  emitidoEm        DateTime @default(now())
  emitidoPorId     String?
  revogadoEm       DateTime?
  revogadoPorId    String?
  motivoRevogacao  String?
  substituidoPorId String?
  certificateId    String?                        // Certificate do núcleo (opcional)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  modelo           SecCertModelo @relation(fields: [modeloId], references: [id])
  lote             SecCertLote? @relation(fields: [loteId], references: [id])

  @@unique([tenantId, numero])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, modeloId])
}

// ---------- LIVROS, ATAS, DIPLOMAS E COLAÇÃO ----------

model SecLivro {
  id             String   @id @default(uuid())
  tenantId       String
  tipo           String                           // REGISTRO_DIPLOMA, ATAS_COLACAO, ATAS_GERAIS, REGISTRO_CERTIFICADO
  numero         Int
  titulo         String
  folhaAtual     Int      @default(1)
  registrosPorFolha Int   @default(2)
  proximoRegistro Int     @default(1)
  aberto         Boolean  @default(true)
  abertoEm       DateTime @default(now())
  encerradoEm    DateTime?
  termoAbertura  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  diplomas       SecDiploma[]
  atas           SecAta[]

  @@unique([tenantId, tipo, numero])
  @@index([tenantId, tipo, aberto])
}

model SecAta {
  id          String   @id @default(uuid())
  tenantId    String
  livroId     String?
  numero      Int?
  tipo        String   @default("GERAL")          // COLACAO, COLEGIADO, BANCA, REUNIAO, GERAL
  titulo      String
  data        DateTime
  conteudo    String                              // HTML/texto
  participantes Json?
  colacaoId   String?
  assinadaEm  DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  livro       SecLivro? @relation(fields: [livroId], references: [id])

  @@index([tenantId, tipo])
  @@index([tenantId, colacaoId])
}

model SecDiploma {
  id                 String   @id @default(uuid())
  tenantId           String
  studentId          String
  programId          String?
  enrollmentId       String?
  tipo               String   @default("DIPLOMA") // DIPLOMA, SEGUNDA_VIA
  status             SecDiplomaStatus @default(SOLICITADO)
  solicitadoEm       DateTime @default(now())
  conferenciaId      String?
  colacaoId          String?
  livroId            String?
  numeroRegistro     Int?
  folha              Int?
  dataRegistro       DateTime?
  dataConclusao      DateTime?
  dataColacao        DateTime?
  entregueEm         DateTime?
  retiradoPor        String?
  retiradoDoc        String?
  pendencias         Json?
  observacoes        String?
  protocoloId        String?
  codigoVerificacao  String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  livro              SecLivro? @relation(fields: [livroId], references: [id])

  @@unique([livroId, numeroRegistro])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, colacaoId])
}

model SecColacao {
  id            String   @id @default(uuid())
  tenantId      String
  nome          String
  data          DateTime
  local         String?
  programId     String?
  termId        String?
  status        SecColacaoStatus @default(PLANEJADA)
  prazoInscricaoEm DateTime?
  observacoes   String?
  ataId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  formandos     SecColacaoFormando[]

  @@index([tenantId, status, data])
}

model SecColacaoFormando {
  id           String   @id @default(uuid())
  tenantId     String
  colacaoId    String
  studentId    String
  nome         String
  status       SecFormandoStatus @default(INSCRITO)
  pendencias   Json?
  juramento    Boolean  @default(true)
  diplomaId    String?
  observacoes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  colacao      SecColacao @relation(fields: [colacaoId], references: [id], onDelete: Cascade)

  @@unique([colacaoId, studentId])
  @@index([tenantId, studentId])
}

// ---------- ARQUIVO / TEMPORALIDADE ----------

model SecTemporalidade {
  id                   String   @id @default(uuid())
  tenantId             String
  codigo               String
  tipoDocumento        String
  descricao            String?
  prazoCorrenteAnos    Int      @default(5)       // arquivo corrente
  prazoIntermediarioAnos Int    @default(0)       // arquivo intermediário
  destinacao           String   @default("ELIMINACAO")   // ELIMINACAO | GUARDA_PERMANENTE
  fundamento           String?
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, codigo])
}

model SecArquivoItem {
  id              String   @id @default(uuid())
  tenantId        String
  temporalidadeId String
  titulo          String
  descricao       String?
  studentId       String?
  refType         String?
  refId           String?
  predio          String?
  sala            String?
  estante         String?
  caixa           String?
  pasta           String?
  urlDigital      String?
  dataDocumento   DateTime?
  dataEncerramento DateTime                         // marco inicial dos prazos de guarda
  eliminarApos    DateTime?                        // calculado
  status          SecArquivoStatus @default(ATIVO)
  suspensoMotivo  String?
  descarteId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, eliminarApos])
  @@index([tenantId, studentId])
}

model SecDescarte {
  id            String   @id @default(uuid())
  tenantId      String
  numero        String
  justificativa String?
  status        SecDescarteStatus @default(RASCUNHO)
  itemIds       Json                                // string[]
  solicitadoPorId String?
  aprovadoPorId String?
  aprovadoEm    DateTime?
  motivoRejeicao String?
  executadoEm   DateTime?
  termoHtml     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, numero])
  @@index([tenantId, status])
}

// ---- edu/suprimentos.prisma ----
// ============================================================
// EDUMASTER PRO — SUPRIMENTOS (prefixo Sup): compras, estoque,
// insumos de cursos, contratos e vendas (loja/papelaria/cantina).
// Referências a outros módulos (curso, laboratório, turma, aluno,
// centro de custo, campus) são String ids SEM @relation.
// ============================================================

enum SupFornecedorStatus {
  ATIVO
  EM_ANALISE
  BLOQUEADO
  INATIVO
}

enum SupDocumentoStatus {
  VALIDO
  A_VENCER
  VENCIDO
}

enum SupRequisicaoTipo {
  COMPRA
  INSUMO
}

enum SupRequisicaoStatus {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADA
  REPROVADA
  EM_COTACAO
  COTADA
  PEDIDO_EMITIDO
  ATENDIDA
  CANCELADA
}

enum SupAprovacaoStatus {
  PENDENTE
  APROVADO
  REPROVADO
}

enum SupCotacaoStatus {
  ABERTA
  ENCERRADA
  CANCELADA
}

enum SupPedidoStatus {
  RASCUNHO
  EMITIDO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  CANCELADO
}

enum SupMovTipo {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  AJUSTE
  PERDA
  DEVOLUCAO
}

enum SupContratoStatus {
  RASCUNHO
  VIGENTE
  A_VENCER
  VENCIDO
  RENOVADO
  ENCERRADO
}

enum SupInventarioStatus {
  ABERTO
  CONTAGEM_FINALIZADA
  AJUSTADO
  CANCELADO
}

enum SupCaixaStatus {
  ABERTO
  FECHADO
}

enum SupVendaTipo {
  A_VISTA
  LANCADA_ALUNO
}

enum SupVendaStatus {
  CONCLUIDA
  PARCIALMENTE_DEVOLVIDA
  DEVOLVIDA
  CANCELADA
}

// ---------- Fornecedores ----------

model SupFornecedor {
  id                 String   @id @default(uuid())
  tenantId           String
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String?
  inscricaoEstadual  String?
  email              String?
  telefone           String?
  contato            String?
  endereco           String?
  cidade             String?
  uf                 String?
  categorias         String[] // categorias de fornecimento
  prazoPagamentoDias Int      @default(30)
  banco              String?
  chavePix           String?
  status             SupFornecedorStatus @default(ATIVO)
  ativo              Boolean  @default(true)
  avaliacaoMedia     Float?
  totalAvaliacoes    Int      @default(0)
  observacoes        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documentos  SupFornecedorDocumento[]
  avaliacoes  SupFornecedorAvaliacao[]
  contratos   SupContrato[]
  pedidos     SupPedido[]

  @@unique([tenantId, cnpj])
  @@index([tenantId, status])
}

model SupFornecedorDocumento {
  id            String   @id @default(uuid())
  tenantId      String
  fornecedorId  String
  tipo          String        // CND Federal, CND Estadual, FGTS, Trabalhista, Alvará, Contrato Social...
  numero        String?
  emissao       DateTime?
  validade      DateTime?
  status        SupDocumentoStatus @default(VALIDO)
  arquivoUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fornecedor    SupFornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@index([tenantId, validade])
  @@index([fornecedorId])
}

model SupFornecedorAvaliacao {
  id            String   @id @default(uuid())
  tenantId      String
  fornecedorId  String
  pedidoId      String?
  notaPrazo     Int           // 1..5
  notaQualidade Int
  notaPreco     Int
  notaAtendimento Int         @default(3)
  nota          Float         // média calculada
  comentario    String?
  avaliadorUserId String?
  createdAt     DateTime @default(now())

  fornecedor    SupFornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@index([tenantId, fornecedorId])
}

// ---------- Catálogo ----------

model SupCategoria {
  id          String   @id @default(uuid())
  tenantId    String
  nome        String
  descricao   String?
  contaContabilId String?   // ChartOfAccount (financeiro) opcional
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens       SupItem[]

  @@unique([tenantId, nome])
  @@index([tenantId])
}

model SupItem {
  id              String   @id @default(uuid())
  tenantId        String
  codigo          String
  nome            String
  descricao       String?
  categoriaId     String?
  unidade         String   @default("UN")   // UN, CX, KG, L, PCT...
  estoqueMinimo   Float    @default(0)
  estoqueMaximo   Float?
  pontoPedido     Float?
  leadTimeDias    Int      @default(7)
  controlaLote    Boolean  @default(false)
  controlaValidade Boolean @default(false)
  precoReferencia Float?
  custoMedio      Float    @default(0)     // custo médio global (todos os almoxarifados)
  contaContabilId String?
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoria       SupCategoria? @relation(fields: [categoriaId], references: [id])
  saldos          SupSaldo[]
  lotes           SupLote[]
  movimentacoes   SupMovimentacao[]

  @@unique([tenantId, codigo])
  @@index([tenantId, categoriaId])
}

// ---------- Estoque ----------

model SupAlmoxarifado {
  id            String   @id @default(uuid())
  tenantId      String
  codigo        String
  nome          String
  campusId      String?
  localizacao   String?
  responsavelUserId String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  saldos        SupSaldo[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
}

model SupSaldo {
  id              String   @id @default(uuid())
  tenantId        String
  almoxarifadoId  String
  itemId          String
  quantidade      Float    @default(0)
  custoMedio      Float    @default(0)
  ultimaMovimentacao DateTime?
  updatedAt       DateTime @updatedAt

  almoxarifado    SupAlmoxarifado @relation(fields: [almoxarifadoId], references: [id])
  item            SupItem         @relation(fields: [itemId], references: [id])

  @@unique([almoxarifadoId, itemId])
  @@index([tenantId, itemId])
}

model SupLote {
  id              String   @id @default(uuid())
  tenantId        String
  almoxarifadoId  String
  itemId          String
  numero          String
  validade        DateTime?
  quantidade      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item            SupItem  @relation(fields: [itemId], references: [id])

  @@unique([almoxarifadoId, itemId, numero])
  @@index([tenantId, validade])
}

model SupMovimentacao {
  id                    String   @id @default(uuid())
  tenantId              String
  tipo                  SupMovTipo
  itemId                String
  almoxarifadoId        String        // origem (saída/transferência) ou destino (entrada)
  almoxarifadoDestinoId String?       // só transferência
  quantidade            Float         // sempre positiva; para AJUSTE use `sentido`
  sentido               Int           @default(1)   // +1 aumenta saldo do almoxarifadoId, -1 reduz
  custoUnitario         Float         @default(0)
  valorTotal            Float         @default(0)
  saldoApos             Float         @default(0)
  custoMedioApos        Float         @default(0)
  loteId                String?
  loteNumero            String?
  origemTipo            String?       // PEDIDO, RECEBIMENTO, VENDA, KIT_AULA, INVENTARIO, REQUISICAO, MANUAL
  origemId              String?
  cursoId               String?
  laboratorioId         String?
  centroCustoId         String?
  classSectionId        String?
  motivo                String?
  userId                String?
  createdAt             DateTime @default(now())

  item                  SupItem  @relation(fields: [itemId], references: [id])

  @@index([tenantId, itemId, createdAt])
  @@index([tenantId, cursoId])
  @@index([tenantId, origemTipo, origemId])
}

model SupInventario {
  id              String   @id @default(uuid())
  tenantId        String
  almoxarifadoId  String
  tipo            String   @default("ROTATIVO")   // ROTATIVO | GERAL
  status          SupInventarioStatus @default(ABERTO)
  observacao      String?
  abertoPorId     String?
  finalizadoEm    DateTime?
  ajustadoEm      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  itens           SupInventarioItem[]

  @@index([tenantId, status])
}

model SupInventarioItem {
  id              String   @id @default(uuid())
  tenantId        String
  inventarioId    String
  itemId          String
  quantidadeSistema Float
  quantidadeContada Float?
  diferenca       Float?
  ajustado        Boolean  @default(false)
  observacao      String?

  inventario      SupInventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)

  @@unique([inventarioId, itemId])
  @@index([tenantId])
}

// ---------- Compras ----------

// Alçadas de aprovação: faixa de valor -> papel aprovador (em ordem de nível).
model SupAlcada {
  id          String   @id @default(uuid())
  tenantId    String
  nivel       Int           // 1, 2, 3...
  valorMinimo Float         // aplica-se quando valorEstimado >= valorMinimo
  papel       String        // COORDINATOR, FINANCE, RECTOR...
  descricao   String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, nivel])
  @@index([tenantId])
}

model SupRequisicao {
  id              String   @id @default(uuid())
  tenantId        String
  numero          String
  tipo            SupRequisicaoTipo @default(COMPRA)
  status          SupRequisicaoStatus @default(RASCUNHO)
  solicitanteUserId String
  cursoId         String?
  laboratorioId   String?       // EduSpace
  centroCustoId   String?       // EduCostCenter
  classSectionId  String?
  almoxarifadoId  String?       // destino/origem
  justificativa   String?
  urgencia        String   @default("NORMAL")   // BAIXA | NORMAL | ALTA | URGENTE
  necessarioEm    DateTime?
  valorEstimado   Float    @default(0)
  motivoReprovacao String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  itens           SupRequisicaoItem[]
  aprovacoes      SupAprovacao[]
  cotacoes        SupCotacao[]

  @@unique([tenantId, numero])
  @@index([tenantId, status])
}

model SupRequisicaoItem {
  id            String   @id @default(uuid())
  tenantId      String
  requisicaoId  String
  itemId        String?       // item do catálogo (ou descrição livre)
  descricao     String
  unidade       String   @default("UN")
  quantidade    Float
  quantidadeAtendida Float @default(0)
  precoEstimado Float?

  requisicao    SupRequisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)

  @@index([tenantId, requisicaoId])
}

model SupAprovacao {
  id            String   @id @default(uuid())
  tenantId      String
  requisicaoId  String
  nivel         Int
  papel         String
  status        SupAprovacaoStatus @default(PENDENTE)
  decididoPorId String?
  decididoEm    DateTime?
  parecer       String?

  requisicao    SupRequisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)

  @@unique([requisicaoId, nivel])
  @@index([tenantId, status, papel])
}

model SupCotacao {
  id            String   @id @default(uuid())
  tenantId      String
  numero        String
  requisicaoId  String
  status        SupCotacaoStatus @default(ABERTA)
  criterio      String   @default("MENOR_PRECO")  // MENOR_PRECO | MELHOR_PRAZO | CUSTO_BENEFICIO
  prazoResposta DateTime?
  fornecedorVencedorId String?
  justificativaEscolha String?
  valorEscolhido Float?
  economia      Float?
  encerradaEm   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requisicao    SupRequisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  propostas     SupCotacaoProposta[]

  @@unique([tenantId, numero])
  @@index([tenantId, status])
}

model SupCotacaoProposta {
  id            String   @id @default(uuid())
  tenantId      String
  cotacaoId     String
  fornecedorId  String
  respondeu     Boolean  @default(false)
  frete         Float    @default(0)
  prazoEntregaDias Int?
  parcelas      Int      @default(1)
  validadeProposta DateTime?
  observacao    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cotacao       SupCotacao @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  precos        SupCotacaoPreco[]

  @@unique([cotacaoId, fornecedorId])
  @@index([tenantId])
}

model SupCotacaoPreco {
  id            String   @id @default(uuid())
  tenantId      String
  propostaId    String
  requisicaoItemId String
  precoUnitario Float

  proposta      SupCotacaoProposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@unique([propostaId, requisicaoItemId])
  @@index([tenantId])
}

model SupPedido {
  id              String   @id @default(uuid())
  tenantId        String
  numero          String
  fornecedorId    String
  requisicaoId    String?
  cotacaoId       String?
  almoxarifadoId  String
  centroCustoId   String?
  cursoId         String?
  laboratorioId   String?
  status          SupPedidoStatus @default(RASCUNHO)
  valorItens      Float    @default(0)
  frete           Float    @default(0)
  valorTotal      Float    @default(0)
  parcelas        Int      @default(1)
  intervaloParcelasDias Int @default(30)
  primeiroVencimentoEm DateTime?
  previsaoEntrega DateTime?
  emitidoEm       DateTime?
  recebidoEm      DateTime?
  observacao      String?
  criadoPorId     String?
  payableIds      String[]      // AccountPayable gerados no recebimento
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fornecedor      SupFornecedor @relation(fields: [fornecedorId], references: [id])
  itens           SupPedidoItem[]
  recebimentos    SupRecebimento[]

  @@unique([tenantId, numero])
  @@index([tenantId, status])
  @@index([tenantId, fornecedorId])
}

model SupPedidoItem {
  id            String   @id @default(uuid())
  tenantId      String
  pedidoId      String
  itemId        String
  requisicaoItemId String?
  quantidade    Float
  precoUnitario Float
  quantidadeRecebida Float @default(0)

  pedido        SupPedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([tenantId, pedidoId])
}

model SupRecebimento {
  id            String   @id @default(uuid())
  tenantId      String
  pedidoId      String
  notaFiscal    String?
  dataRecebimento DateTime @default(now())
  valor         Float    @default(0)
  observacao    String?
  recebidoPorId String?
  createdAt     DateTime @default(now())

  pedido        SupPedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  itens         SupRecebimentoItem[]

  @@index([tenantId, pedidoId])
}

model SupRecebimentoItem {
  id              String   @id @default(uuid())
  tenantId        String
  recebimentoId   String
  pedidoItemId    String
  itemId          String
  quantidadeRecebida Float
  quantidadeRejeitada Float @default(0)
  motivoRejeicao  String?
  loteNumero      String?
  validade        DateTime?

  recebimento     SupRecebimento @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)

  @@index([tenantId, recebimentoId])
}

// ---------- Contratos ----------

model SupContrato {
  id              String   @id @default(uuid())
  tenantId        String
  numero          String
  fornecedorId    String
  objeto          String
  vigenciaInicio  DateTime
  vigenciaFim     DateTime
  valorMensal     Float?
  valorTotal      Float?
  indiceReajuste  String?       // IPCA, IGP-M, INPC, fixo
  percentualReajuste Float?     // percentual aplicado no último reajuste/previsto
  proximoReajusteEm DateTime?
  renovacaoAutomatica Boolean @default(false)
  avisoDias       Int      @default(60)
  status          SupContratoStatus @default(VIGENTE)
  centroCustoId   String?
  arquivoUrl      String?
  observacoes     String?
  contratoAnteriorId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fornecedor      SupFornecedor @relation(fields: [fornecedorId], references: [id])

  @@unique([tenantId, numero])
  @@index([tenantId, status, vigenciaFim])
}

// ---------- Kits de aula prática ----------

model SupKit {
  id            String   @id @default(uuid())
  tenantId      String
  nome          String
  disciplineId  String?
  laboratorioId String?
  descricao     String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itens         SupKitItem[]
  consumos      SupKitConsumo[]

  @@index([tenantId, disciplineId])
}

model SupKitItem {
  id              String   @id @default(uuid())
  tenantId        String
  kitId           String
  itemId          String
  quantidadeFixa  Float    @default(0)   // por turma/aula
  quantidadePorAluno Float @default(0)   // por aluno presente
  
  kit             SupKit   @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@unique([kitId, itemId])
  @@index([tenantId])
}

model SupKitConsumo {
  id              String   @id @default(uuid())
  tenantId        String
  kitId           String
  classSectionId  String?
  classSessionId  String?
  cursoId         String?
  laboratorioId   String?
  almoxarifadoId  String
  numeroAlunos    Int
  valorTotal      Float    @default(0)
  userId          String?
  createdAt       DateTime @default(now())

  kit             SupKit   @relation(fields: [kitId], references: [id])

  @@index([tenantId, classSectionId])
  @@index([tenantId, kitId])
}

// ---------- Vendas (loja, papelaria, uniformes, livraria, cantina...) ----------

model SupProduto {
  id              String   @id @default(uuid())
  tenantId        String
  itemId          String        // SupItem que controla o estoque
  almoxarifadoId  String        // almoxarifado/estoque da loja
  canal           String   @default("LOJA")   // LOJA | PAPELARIA | UNIFORMES | LIVRARIA | CURSOS_LIVRES | CANTINA
  nome            String
  preco           Float
  permiteLancarAluno Boolean @default(true)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, itemId, almoxarifadoId])
  @@index([tenantId, canal])
}

model SupCaixa {
  id              String   @id @default(uuid())
  tenantId        String
  operadorUserId  String
  canal           String   @default("LOJA")
  status          SupCaixaStatus @default(ABERTO)
  valorAbertura   Float    @default(0)
  abertoEm        DateTime @default(now())
  fechadoEm       DateTime?
  valorContado    Float?
  valorEsperado   Float?
  diferenca       Float?
  observacao      String?

  movimentos      SupCaixaMov[]
  vendas          SupVenda[]

  @@index([tenantId, status])
}

model SupCaixaMov {
  id          String   @id @default(uuid())
  tenantId    String
  caixaId     String
  tipo        String        // SANGRIA | SUPRIMENTO
  valor       Float
  motivo      String?
  createdAt   DateTime @default(now())

  caixa       SupCaixa @relation(fields: [caixaId], references: [id], onDelete: Cascade)

  @@index([tenantId, caixaId])
}

model SupVenda {
  id              String   @id @default(uuid())
  tenantId        String
  numero          String
  caixaId         String
  tipo            SupVendaTipo @default(A_VISTA)
  status          SupVendaStatus @default(CONCLUIDA)
  studentId       String?
  clienteNome     String?
  formaPagamento  String?       // DINHEIRO | PIX | CARTAO
  subtotal        Float    @default(0)
  desconto        Float    @default(0)
  total           Float    @default(0)
  totalDevolvido  Float    @default(0)
  parcelas        Int      @default(1)
  receivableIds   String[]
  vendedorUserId  String?
  createdAt       DateTime @default(now())

  caixa           SupCaixa @relation(fields: [caixaId], references: [id])
  itens           SupVendaItem[]
  devolucoes      SupDevolucao[]

  @@unique([tenantId, numero])
  @@index([tenantId, createdAt])
  @@index([tenantId, studentId])
}

model SupVendaItem {
  id              String   @id @default(uuid())
  tenantId        String
  vendaId         String
  produtoId       String
  itemId          String
  almoxarifadoId  String
  descricao       String
  quantidade      Float
  precoUnitario   Float
  custoUnitario   Float    @default(0)
  quantidadeDevolvida Float @default(0)

  venda           SupVenda @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@index([tenantId, vendaId])
}

model SupDevolucao {
  id          String   @id @default(uuid())
  tenantId    String
  vendaId     String
  valor       Float
  motivo      String?
  itens       Json
  userId      String?
  createdAt   DateTime @default(now())

  venda       SupVenda @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@index([tenantId, vendaId])
}

// Sequenciais de numeração por tipo/ano (REQ-2026-0001...)
model SupSequencia {
  id        String   @id @default(uuid())
  tenantId  String
  chave     String
  ultimo    Int      @default(0)

  @@unique([tenantId, chave])
}

// ==== EDUMASTER:END ====
