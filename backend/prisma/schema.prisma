generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  email         String
  phone         String
  cnpj          String

  address       String?
  city          String?
  state         String?
  zipCode       String?

  logo          String?
  displayName   String?
  primaryColor  String   @default("#0F5FDB")
  secondaryColor String  @default("#0B1F3A")
  accentColor   String   @default("#21C7A8")
  themeMode     String   @default("LIGHT")
  timezone      String   @default("America/Sao_Paulo")

  plan          String   @default("STARTER")
  language      String   @default("pt-BR")

  maxDoctors    Int      @default(1)
  maxPatients   Int      @default(500)

  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  doctors       Doctor[]
  patients      Patient[]
  schedules     Schedule[]
  appointments  Appointment[]
  appointmentHistories AppointmentHistory[]
  appointmentReminders AppointmentReminder[]
  budgets       Budget[]
  payments      Payment[]
  feedbacks     Feedback[]
  accessProfiles AccessProfile[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  laboratoryWorks LaboratoryWork[]
  dentalDesignCases DentalDesignCase[]
  financialEntries FinancialEntry[]
  paymentProviderConfigs PaymentProviderConfig[]
  hrEmployees HREmployee[]
  hrAttendance HRAttendance[]
  hrPayrollEntries HRPayrollEntry[]
  hrPayrollClosings HRPayrollClosing[]
  hrVacations HRVacation[]
  hrDocuments HRDocument[]
  hrDisciplinaryActions HRDisciplinaryAction[]
  units ClinicUnit[]
  storageConfigs TenantStorageConfig[]
  featureFlags TenantFeatureFlag[]
  revahSenders RevahSender[]
  leadImports LeadImport[]
  revahContacts RevahContact[]
  revahCampaigns RevahCampaign[]
  revahMessages RevahMessage[]
  salesLeads SalesLead[]
  salesProducts SalesProduct[]
  revahConversations RevahConversation[]
  revahConversationMessages RevahConversationMessage[]
  suppliers Supplier[]
  accountingAccounts AccountingAccount[]
  costCenters CostCenter[]
  taxObligations TaxObligation[]
  accountantPortalAccesses AccountantPortalAccess[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
}

model User {
  id            String   @id @default(cuid())

  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  tenantId      String

  email         String
  password      String

  firstName     String
  lastName      String

  role          String   @default("STAFF")

  phone         String?
  avatar        String?

  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor         Doctor?

  schedules      Schedule[]
  appointments   Appointment[]
  appointmentHistoryEvents AppointmentHistory[] @relation("AppointmentHistoryActor")
  accessProfiles UserAccessProfile[]
  auditLogs       AuditLog[] @relation("AuditActor")
  refreshTokens   RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  @@unique([clinicId, email])
  @@index([clinicId])
  @@index([tenantId])
}

model Doctor {
  id            String   @id @default(cuid())

  clinicId      String
  clinic        Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  tenantId      String

  userId        String   @unique
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  cro           String

  specialty     String

  bio           String?
  photo         String?

  isActive      Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments  Appointment[]
  schedules     Schedule[]

  @@unique([clinicId, cro])
  @@index([clinicId])
  @@index([tenantId])
}

model Patient {
  id             String   @id @default(cuid())

  clinicId       String
  clinic         Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  tenantId       String

  fullName       String

  email          String?
  phone          String

  cpf            String?
  rg             String?

  birthDate      DateTime?

  gender         String?

  address        String?
  city           String?
  state          String?
  zipCode        String?

  odontogram     String?

  photos         String[]
  xrays          String[]

  medicalHistory String?
  allergies      String?
  notes          String?

  isActive       Boolean @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments   Appointment[]
  schedules      Schedule[]
  budgets        Budget[]
  feedbacks      Feedback[]
  clinicalEvolutions ClinicalEvolution[]
  odontogramMarks OdontogramMark[]
  treatmentItems TreatmentItem[]
  laboratoryWorks LaboratoryWork[]
  dentalDesignCases DentalDesignCase[]
  financialEntries FinancialEntry[]

  @@unique([clinicId, cpf])
  @@index([clinicId])
  @@index([tenantId])
}

model Schedule {
  id            String   @id @default(cuid())

  clinicId      String
  clinic        Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  tenantId      String

  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  doctorId      String
  doctor        Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  patientId     String?
  patient       Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  dayOfWeek     Int

  startTime     String
  endTime       String

  slotDuration  Int @default(30)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clinicId, doctorId])
  @@index([tenantId])
}

model Appointment {
  id              String   @id @default(cuid())

  clinicId        String
  clinic          Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  tenantId        String

  patientId       String
  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId        String
  doctor          Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  procedure       String
  nextProcedure   String?
  room            String?
  source          String   @default("INTERNAL")

  scheduledAt     DateTime

  startedAt       DateTime?
  endedAt         DateTime?

  status          String @default("SCHEDULED")

  notes           String?

  confirmation    String?
  confirmChannel  String?

  budgetId        String?
  budget          Budget? @relation("AppointmentBudget", fields: [budgetId], references: [id], onDelete: SetNull)

  payments        Payment[]

  feedbacks       Feedback[]
  history         AppointmentHistory[]
  reminders       AppointmentReminder[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicId, patientId])
  @@index([clinicId, doctorId])
  @@index([tenantId])
}

model AppointmentHistory {
  id                  String   @id @default(cuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId            String
  appointmentId       String
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actorId             String?
  actor               User?    @relation("AppointmentHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  action              String
  requestedBy         String?
  reason              String?
  previousScheduledAt DateTime?
  newScheduledAt      DateTime?
  previousStatus      String?
  newStatus           String?
  metadata            Json?
  createdAt           DateTime @default(now())

  @@index([clinicId, appointmentId])
  @@index([tenantId])
}

model AppointmentReminder {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId      String
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          String
  channel       String   @default("WHATSAPP")
  scheduledFor  DateTime
  status        String   @default("PENDING")
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clinicId, scheduledFor, status])
  @@index([appointmentId])
  @@index([tenantId])
}

model Budget {
  id                 String   @id @default(cuid())

  clinicId           String
  clinic             Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  tenantId           String

  patientId          String
  patient            Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  description        String

  totalAmount        Float

  installments       Int @default(1)

  installmentValue   Float

  status             String @default("PENDING")
  discountPercent    Float  @default(0)
  entryAmount        Float  @default(0)
  monthlyRatePercent Float  @default(0)
  paymentMethod      String @default("PIX")
  paymentProvider    String @default("MANUAL")
  version            Int    @default(1)
  optionsJson        Json?
  simulaClinicJson   Json?

  validUntil         DateTime

  appointments       Appointment[] @relation("AppointmentBudget")

  payments           Payment[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([tenantId])
}

model Payment {
  id              String   @id @default(cuid())

  clinicId        String
  clinic          Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  tenantId        String

  budgetId        String
  budget          Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  amount          Float

  method          String

  installment     Int @default(1)

  dueDate         DateTime

  paidDate        DateTime?

  status          String @default("PENDING")

  notes           String?

  asaasId         String?
  provider        String?
  externalId      String?
  grossAmount     Float?
  feeAmount       Float?
  netAmount       Float?
  transactionStatus String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicId])
  @@index([budgetId])
  @@index([appointmentId])
  @@index([tenantId])
}


model FinancialEntry {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  patientId       String?
  patient         Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  type            String
  description     String
  category        String   @default("GERAL")
  personName      String
  amount          Float
  dueDate         DateTime
  competenceDate  DateTime?
  status          String   @default("PENDING")
  paymentMethod   String?
  provider        String?
  origin          String   @default("MANUAL")
  originId        String?
  installment     Int?
  installments    Int?
  paidAt          DateTime?
  notes           String?
  externalId      String?
  barcode         String?
  digitableLine   String?
  documentUrl     String?
  accountingMode  String?
  costCenter      String?
  supplier        String?
  supplierId      String?
  supplierRecord  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  accountingAccountId String?
  accountingAccount AccountingAccount? @relation(fields: [accountingAccountId], references: [id], onDelete: SetNull)
  costCenterId    String?
  costCenterRecord CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  documentNumber  String?
  fiscalDocumentType String?
  taxWithheld     Float    @default(0)
  netAmount       Float?
  accountingStatus String  @default("PENDING")
  accountantNotes String?
  recurrence      String?
  approvedAt      DateTime?
  sourceDocumentHash String?
  taxObligation   TaxObligation?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicId, dueDate])
  @@index([tenantId])
  @@index([patientId])
  @@index([origin, originId])
  @@index([supplierId])
  @@index([accountingAccountId])
  @@index([costCenterId])
  @@index([accountingStatus])
}

model PaymentProviderConfig {
  id                    String   @id @default(cuid())
  clinicId              String
  clinic                Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId              String
  provider              String
  environment           String   @default("TEST")
  isActive              Boolean  @default(false)
  credentialsConfigured Boolean  @default(false)
  webhookConfigured     Boolean  @default(false)
  settings              Json?
  encryptedCredentials  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([clinicId, provider])
  @@index([tenantId])
}

model Supplier {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  name            String
  tradeName       String?
  document        String?
  email           String?
  phone           String?
  pixKey          String?
  bankData        String?
  category        String   @default("GERAL")
  paymentTerms    String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  financialEntries FinancialEntry[]

  @@unique([clinicId, document])
  @@index([clinicId, name])
  @@index([tenantId])
}

model AccountingAccount {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  code            String
  name            String
  group           String
  parentCode      String?
  nature          String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  financialEntries FinancialEntry[]

  @@unique([clinicId, code])
  @@index([clinicId, group])
  @@index([tenantId])
}

model CostCenter {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  code            String
  name            String
  department      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  financialEntries FinancialEntry[]

  @@unique([clinicId, code])
  @@index([clinicId, name])
  @@index([tenantId])
}

model TaxObligation {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  name            String
  entityName      String
  legalEntity     String   @default("PJ")
  regime          String?
  competence      String
  dueDate         DateTime
  estimatedValue  Float    @default(0)
  finalValue      Float?
  status          String   @default("TO_CALCULATE")
  responsible     String?
  requiresAccountantApproval Boolean @default(true)
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  financialEntryId String?  @unique
  financialEntry  FinancialEntry? @relation(fields: [financialEntryId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicId, dueDate])
  @@index([tenantId])
  @@index([status])
}

model AccountantPortalAccess {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  name            String
  email           String
  status          String   @default("INVITED")
  canViewFinance  Boolean  @default(true)
  canViewTax      Boolean  @default(true)
  canViewPayroll  Boolean  @default(false)
  canExport       Boolean  @default(true)
  canApproveTax   Boolean  @default(false)
  lastAccessAt    DateTime?
  invitedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clinicId, email])
  @@index([tenantId])
  @@index([status])
}

model Feedback {
  id              String   @id @default(cuid())

  clinicId        String
  clinic          Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  tenantId        String

  patientId       String
  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  rating          Int

  comment         String?

  isAnonymous     Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([tenantId])
}



model ClinicalEvolution {
  id             String   @id @default(cuid())
  clinicId       String
  tenantId       String
  patientId      String
  professionalId String?
  professionalName String
  procedure      String
  notes          String
  nextProcedure  String
  nextAppointmentCreated Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  odontogramMarks OdontogramMark[] @relation("EvolutionCompletedMarks")

  @@index([clinicId, patientId])
  @@index([tenantId])
}

model OdontogramMark {
  id             String   @id @default(cuid())
  clinicId       String
  tenantId       String
  patientId      String
  tooth          Int
  surface        String?
  finding        String
  state          String   @default("PENDING")
  completedAt    DateTime?
  sourceEvolutionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceEvolution ClinicalEvolution? @relation("EvolutionCompletedMarks", fields: [sourceEvolutionId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId])
  @@index([tenantId])
  @@index([patientId, tooth])
}

model TreatmentItem {
  id             String   @id @default(cuid())
  clinicId       String
  tenantId       String
  patientId      String
  tooth          Int?
  surfaces       String[]
  procedure      String
  status         String   @default("PLANNED")
  origin         String   @default("MANUAL")
  clinicalEvolutionId String?
  odontogramMarkId String? @unique
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@index([tenantId])
}

model LaboratoryWork {
  id                   String   @id @default(cuid())
  clinicId             String
  clinic               Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId             String
  patientId            String?
  patient              Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  trackingCode         String
  dentistName          String
  workType             String
  teeth                String?
  material             String?
  responsibleTechnician String?
  impressionType       String?
  receivedItems        String[]
  toothShade           String
  shadeSystem          String?
  shadeNotes           String?
  patientAge           Int?
  patientSex           String?
  faceBiotype          String?
  faceShape            String?
  faceDescription      String?
  dueDate              DateTime?
  patientReturnDate    DateTime?
  nextAction           String?
  status               String   @default("RECEIVED")
  priority             String   @default("NORMAL")
  source               String   @default("LABORATORY")
  observations         String?
  designStatus         String   @default("NOT_SENT")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  history              LaboratoryWorkHistory[]
  designCase           DentalDesignCase?

  @@unique([clinicId, trackingCode])
  @@index([clinicId, status])
  @@index([tenantId])
  @@index([patientId])
}

model LaboratoryWorkHistory {
  id               String   @id @default(cuid())
  clinicId         String
  tenantId         String
  laboratoryWorkId String
  laboratoryWork   LaboratoryWork @relation(fields: [laboratoryWorkId], references: [id], onDelete: Cascade)
  actorId          String?
  action           String
  description      String
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([clinicId, laboratoryWorkId])
  @@index([tenantId])
}

model DentalDesignCase {
  id               String   @id @default(cuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId         String
  patientId        String?
  patient          Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  laboratoryWorkId String?  @unique
  laboratoryWork   LaboratoryWork? @relation(fields: [laboratoryWorkId], references: [id], onDelete: SetNull)
  toothNumbers     String[]
  selectedTooth    Int?
  toothCharacter   String   @default("ADULT")
  archShape        String?
  primaryFileName  String?
  antagonistFileName String?
  biteFileName     String?
  activeTool       String   @default("NAVIGATION")
  brushStrength    Int      @default(35)
  marginPoints     Json?
  occlusionState   Json?
  status           String   @default("PREPARING")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clinicId, status])
  @@index([tenantId])
  @@index([patientId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  profiles    AccessProfilePermission[]
}

model AccessProfile {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId    String
  name        String
  code        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions AccessProfilePermission[]
  users       UserAccessProfile[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@index([tenantId])
}

model AccessProfilePermission {
  profileId    String
  permissionId String
  profile      AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@id([profileId, permissionId])
  @@index([permissionId])
}

model UserAccessProfile {
  userId    String
  profileId String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, profileId])
  @@index([profileId])
}

model AuditLog {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId   String
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  module     String
  action     String
  entityType String?
  entityId   String?
  summary    String?
  beforeData Json?
  afterData  Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([actorId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([userId])
}


model HREmployee {
  id String @id @default(cuid())
  clinicId String
  clinic Clinic @relation(fields:[clinicId], references:[id], onDelete:Cascade)
