  faixaSalarial    String?        // ate_2sm, 2_5sm, 5_10sm, acima_10sm
  linkedin         String?
  primeiroEmpregoEm DateTime?
  ultimaAtualizacaoEm DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trajetoria       ApoEgressoTrajetoria[]
  participacoes    ApoEventoParticipante[]

  @@unique([tenantId, studentId])
  @@index([tenantId, programId, anoConclusao])
}

model ApoEgressoTrajetoria {
  id           String   @id @default(uuid())
  tenantId     String
  egressoId    String
  tipo         String   @default("EMPREGO")   // EMPREGO, POS_GRADUACAO, EMPREENDEDORISMO, CONCURSO, OUTRO
  organizacao  String
  cargo        String?
  inicio       DateTime
  fim          DateTime?
  atuaNaArea   Boolean?
  faixaSalarial String?
  createdAt    DateTime @default(now())

  egresso      ApoEgresso @relation(fields: [egressoId], references: [id], onDelete: Cascade)

  @@index([tenantId, egressoId])
}

model ApoEventoEgresso {
  id          String   @id @default(uuid())
  tenantId    String
  titulo      String
  tipo        String   @default("ENCONTRO")   // ENCONTRO, PALESTRA, NETWORKING, CURSO, HOMECOMING, FEIRA_CARREIRAS
  descricao   String?
  dataHora    DateTime
  local       String?
  vagas       Int?
  programId   String?
  status      String   @default("PLANEJADO")   // PLANEJADO, ABERTO, REALIZADO, CANCELADO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participantes ApoEventoParticipante[]

  @@index([tenantId, status, dataHora])
}

model ApoEventoParticipante {
  id          String   @id @default(uuid())
  tenantId    String
  eventoId    String
  egressoId   String
  status      String   @default("CONFIRMADO")   // CONFIRMADO, PRESENTE, FALTOU, CANCELADO
  createdAt   DateTime @default(now())

  evento      ApoEventoEgresso @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  egresso     ApoEgresso @relation(fields: [egressoId], references: [id], onDelete: Cascade)

  @@unique([eventoId, egressoId])
  @@index([tenantId, egressoId])
}

// ---- edu/biblioteca.prisma ----
// ============================================================================
// MÓDULO BIBLIOTECA (prefixo Bib) — acervo físico, circulação, adequação à
// matriz curricular, biblioteca virtual e repositório institucional.
// Referências a models de outros módulos (Student, Discipline, EduSpace,
// AcademicProgram, User, AccountReceivable, LibraryProvider) são String ids.
// ============================================================================

enum BibPerfil {
  ALUNO
  PROFESSOR
  FUNCIONARIO
  EXTERNO
}

enum BibTipoObra {
  LIVRO
  PERIODICO
  TESE
  DVD
  NORMA
  MAPA
  OUTRO
}

enum BibEstadoConservacao {
  OTIMO
  BOM
  REGULAR
  RUIM
  PESSIMO
}

enum BibStatusExemplar {
  DISPONIVEL
  EMPRESTADO
  RESERVADO
  EM_REPARO
  EXTRAVIADO
  BAIXADO
}

enum BibTipoAquisicao {
  COMPRA
  DOACAO
  PERMUTA
  PRODUCAO_INSTITUCIONAL
}

enum BibStatusEmprestimo {
  ATIVO
  DEVOLVIDO
  PERDIDO
}

enum BibStatusReserva {
  AGUARDANDO
  DISPONIVEL
  ATENDIDA
  CANCELADA
  EXPIRADA
}

enum BibTipoMulta {
  ATRASO
  DANO
  EXTRAVIO
}

enum BibStatusMulta {
  ABERTA
  EM_COBRANCA
  PAGA
  ISENTA
  CANCELADA
}

enum BibStatusInventario {
  ABERTO
  CONCLUIDO
  CANCELADO
}

enum BibSituacaoItemInventario {
  PENDENTE
  CONFERIDO
  NAO_ENCONTRADO
  EMPRESTADO
  LOCAL_DIVERGENTE
}

enum BibTipoBibliografia {
  BASICA
  COMPLEMENTAR
}

enum BibStatusSugestao {
  PENDENTE
  APROVADA
  REJEITADA
  COMPRADA
  RECEBIDA
}

enum BibTipoRecurso {
  EBOOK
  PERIODICO
  BASE_DADOS
  VIDEO
  OUTRO
}

enum BibTipoAcessoVirtual {
  ASSINATURA_INSTITUCIONAL
  URL_PESSOAL
  ACESSO_LIVRE
}

enum BibTipoItemRepositorio {
  TCC
  DISSERTACAO
  TESE
  ARTIGO
  NORMA
  MATERIAL_DIDATICO
  RELATORIO
  OUTRO
}

enum BibStatusRepositorio {
  RASCUNHO
  EM_REVISAO
  PUBLICADO
  RETIRADO
}

// ---------- Configuração e políticas ----------

model BibConfig {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique
  proximoTombo             Int      @default(1)
  prefixoTombo             String   @default("")
  valorMultaDiaPadrao      Float    @default(1.0)
  valorMaxMultaAberta      Float    @default(0)      // acima disso o leitor é bloqueado
  diasTolerancia           Int      @default(0)      // dias de graça antes de multar
  considerarDiasUteis      Boolean  @default(false)  // prazo/multa só contam dias úteis
  feriados                 Json?                     // ["2026-12-25", ...]
  minTitulosBasicos        Int      @default(3)
  minTitulosComplementares Int      @default(5)
  vagasPorExemplar         Float    @default(5)      // 1 exemplar a cada N vagas (bibliografia básica)
  bibliotecarioNome        String?
  bibliotecarioCrb         String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model BibPolitica {
  id                    String    @id @default(uuid())
  tenantId              String
  perfil                BibPerfil
  prazoDias             Int       @default(7)
  limiteEmprestimos     Int       @default(3)
  maxRenovacoes         Int       @default(2)
  diasRenovacao         Int?                       // padrão = prazoDias
  multaDia              Float     @default(1.0)
  multaMaxima           Float?                     // teto por empréstimo
  limiteReservas        Int       @default(2)
  diasRetiradaReserva   Int       @default(3)
  bloqueioDiasPorAtraso Int       @default(0)      // suspensão = dias de atraso x este fator
  ativo                 Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId, perfil])
}

// ---------- Acervo físico ----------

model BibObra {
  id              String      @id @default(uuid())
  tenantId        String
  titulo          String
  subtitulo       String?
  tipo            BibTipoObra @default(LIVRO)
  autores         Json?                // string[]
  autoresTexto    String?              // denormalizado p/ busca
  editora         String?
  edicao          String?
  ano             Int?
  isbn            String?              // somente dígitos
  issn            String?
  cdd             String?
  cdu             String?
  cutter          String?
  assuntos        Json?                // string[]
  assuntosTexto   String?
  idioma          String?     @default("pt-BR")
  paginas         Int?
  resumo          String?
  capaUrl         String?
  ativo           Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  exemplares      BibExemplar[]
  reservas        BibReserva[]

  @@index([tenantId, titulo])
  @@index([tenantId, isbn])
  @@index([tenantId, tipo])
}

model BibExemplar {
  id               String               @id @default(uuid())
  tenantId         String
  obraId           String
  tombo            String
  codigoBarras     String?
  spaceId          String?              // EduSpace (biblioteca/sala)
  estante          String?
  prateleira       String?
  estado           BibEstadoConservacao @default(BOM)
  status           BibStatusExemplar    @default(DISPONIVEL)
  apenasConsulta   Boolean              @default(false)
  aquisicaoTipo    BibTipoAquisicao     @default(COMPRA)
  dataAquisicao    DateTime?
  valor            Float?
  fornecedor       String?
  notaFiscal       String?
  observacoes      String?
  baixaMotivo      String?
  baixaEm          DateTime?
  baixaPorId       String?
  baixaObs         String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  obra             BibObra              @relation(fields: [obraId], references: [id])
  emprestimos      BibEmprestimo[]

  @@unique([tenantId, tombo])
  @@index([tenantId, obraId, status])
  @@index([tenantId, codigoBarras])
  @@index([tenantId, spaceId, estante])
}

// ---------- Circulação ----------

model BibLeitor {
  id           String    @id @default(uuid())
  tenantId     String
  perfil       BibPerfil
  studentId    String?
  userId       String?
  nome         String
  documento    String?
  email        String?
  telefone     String?
  bloqueadoAte DateTime?
  motivoBloqueio String?
  validadeAte  DateTime?
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  emprestimos  BibEmprestimo[]
  reservas     BibReserva[]
  multas       BibMulta[]

  @@index([tenantId, perfil])
  @@index([tenantId, studentId])
  @@index([tenantId, userId])
  @@index([tenantId, documento])
}

model BibEmprestimo {
  id              String              @id @default(uuid())
  tenantId        String
  leitorId        String
  exemplarId      String
  obraId          String
  status          BibStatusEmprestimo @default(ATIVO)
  dataEmprestimo  DateTime            @default(now())
  dataPrevista    DateTime
  dataDevolucao   DateTime?
  renovacoes      Int                 @default(0)
  diasAtraso      Int                 @default(0)
  multaPrevista   Float               @default(0)
  observacoes     String?
  emprestadoPorId String?
  devolvidoPorId  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  leitor          BibLeitor           @relation(fields: [leitorId], references: [id])
  exemplar        BibExemplar         @relation(fields: [exemplarId], references: [id])

  @@index([tenantId, status, dataPrevista])
  @@index([tenantId, leitorId, status])
  @@index([tenantId, obraId])
  @@index([tenantId, exemplarId])
}

model BibReserva {
  id            String           @id @default(uuid())
  tenantId      String
  leitorId      String
  obraId        String
  exemplarId    String?          // exemplar separado quando fica DISPONIVEL
  status        BibStatusReserva @default(AGUARDANDO)
  disponivelEm  DateTime?
  expiraEm      DateTime?
  concluidaEm   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  leitor        BibLeitor        @relation(fields: [leitorId], references: [id])
  obra          BibObra          @relation(fields: [obraId], references: [id])

  @@index([tenantId, obraId, status, createdAt])
  @@index([tenantId, leitorId, status])
  @@index([tenantId, status, expiraEm])
}

model BibMulta {
  id             String         @id @default(uuid())
  tenantId       String
  leitorId       String
  emprestimoId   String?
  tipo           BibTipoMulta   @default(ATRASO)
  valor          Float
  diasAtraso     Int            @default(0)
  status         BibStatusMulta @default(ABERTA)
  descricao      String?
  receivableId   String?        // AccountReceivable (financeiro) quando enviada para cobrança
  pagaEm         DateTime?
  formaPagamento String?
  justificativa  String?
  baixaPorId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  leitor         BibLeitor      @relation(fields: [leitorId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, leitorId, status])
  @@index([tenantId, emprestimoId])
}

// ---------- Inventário ----------

model BibInventario {
  id            String              @id @default(uuid())
  tenantId      String
  nome          String
  spaceId       String?
  estante       String?
  status        BibStatusInventario @default(ABERTO)
  iniciadoEm    DateTime            @default(now())
  concluidoEm   DateTime?
  responsavelId String?
  totalEsperado Int                 @default(0)
  resumo        Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  itens         BibInventarioItem[]

  @@index([tenantId, status])
}

model BibInventarioItem {
  id            String                    @id @default(uuid())
  tenantId      String
  inventarioId  String
  exemplarId    String?
  tombo         String
  situacao      BibSituacaoItemInventario @default(PENDENTE)
  localLido     String?
  conferidoEm   DateTime?
  observacao    String?

  inventario    BibInventario             @relation(fields: [inventarioId], references: [id], onDelete: Cascade)

  @@unique([inventarioId, tombo])
  @@index([tenantId, inventarioId, situacao])
}

// ---------- Adequação à matriz curricular ----------

model BibBibliografia {
  id           String              @id @default(uuid())
  tenantId     String
  disciplineId String
  obraId       String
  tipo         BibTipoBibliografia @default(BASICA)
  observacao   String?
  createdAt    DateTime            @default(now())

  @@unique([tenantId, disciplineId, obraId])
  @@index([tenantId, disciplineId, tipo])
  @@index([tenantId, obraId])
}

model BibSugestaoAquisicao {
  id              String            @id @default(uuid())
  tenantId        String
  titulo          String
  autores         String?
  editora         String?
  isbn            String?
  obraId          String?
  disciplineId    String?
  tipoBibliografia BibTipoBibliografia?
  quantidade      Int               @default(1)
  valorEstimado   Float?
  justificativa   String?
  origem          String            @default("PROFESSOR")   // PROFESSOR | ALUNO | BIBLIOTECA | ADEQUACAO
  solicitanteId   String?
  status          BibStatusSugestao @default(PENDENTE)
  decididoPorId   String?
  decididoEm      DateTime?
  motivoDecisao   String?
  recebidoEm      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, disciplineId])
}

// ---------- Biblioteca virtual ----------

model BibRecursoVirtual {
  id                String               @id @default(uuid())
  tenantId          String
  tipo              BibTipoRecurso       @default(EBOOK)
  titulo            String
  autores           String?
  provedor          String?
  url               String
  tipoAcesso        BibTipoAcessoVirtual @default(ASSINATURA_INSTITUCIONAL)
  libraryProviderId String?              // LibraryProvider (módulo conteudo)
  obraId            String?              // versão física equivalente
  isbn              String?
  issn              String?
  assuntos          String?
  descricao         String?
  vigenciaFim       DateTime?
  ativo             Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  acessos           BibAcessoVirtual[]

  @@index([tenantId, tipo])
  @@index([tenantId, obraId])
}

model BibAcessoVirtual {
  id         String   @id @default(uuid())
  tenantId   String
  recursoId  String
  studentId  String?
  userId     String?
  createdAt  DateTime @default(now())

  recurso    BibRecursoVirtual @relation(fields: [recursoId], references: [id], onDelete: Cascade)

  @@index([tenantId, recursoId, createdAt])
  @@index([tenantId, createdAt])
}

// ---------- Repositório institucional (Dublin Core) ----------

model BibRepositorioItem {
  id              String                 @id @default(uuid())
  tenantId        String
  handle          String                 // identificador local persistente (dc:identifier)
  tipo            BibTipoItemRepositorio @default(TCC)
  status          BibStatusRepositorio   @default(RASCUNHO)
  titulo          String                 // dc:title
  tituloAlternativo String?
  criadores       Json?                  // dc:creator  string[]
  orientador      String?
  coorientador    String?
  banca           Json?                  // string[]
  assuntos        Json?                  // dc:subject  string[]
  descricao       String?                // dc:description (resumo)
  abstractEn      String?
  editor          String?                // dc:publisher
  colaboradores   Json?                  // dc:contributor
  dataPublicacao  DateTime?              // dc:date
  formato         String?                // dc:format (application/pdf)
  fonte           String?                // dc:source
  idioma          String?  @default("pt-BR")
  relacao         String?                // dc:relation
  cobertura       String?                // dc:coverage
  direitos        String?                // dc:rights
  licenca         String?                // CC-BY-4.0 ...
  embargoAte      DateTime?
  restrito        Boolean  @default(false)  // acesso só à comunidade
  arquivoUrl      String?
  arquivoDataUrl  String?
  arquivoNome     String?
  paginas         Int?
  ilustrado       Boolean  @default(false)
  cdd             String?
  cutter          String?
  programId       String?
  disciplineId    String?
  autorStudentId  String?
  autorUserId     String?
  buscaTexto      String?                // denormalizado: título + criadores + assuntos + resumo
  visualizacoes   Int      @default(0)
  downloads       Int      @default(0)
  publicadoEm     DateTime?
  revisadoPorId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, handle])
  @@index([tenantId, status, tipo])
  @@index([tenantId, programId])
  @@index([tenantId, autorStudentId])
}

// ---- edu/calendario.prisma ----
// ============================================================
// EDUMASTER PRO — CALENDÁRIO ACADÊMICO, RESERVAS, GRADE HORÁRIA, PROVAS E PRAZOS
// Prefixo: Cal. Referências a models de outros módulos (AcademicTerm, Campus,
// AcademicProgram, Discipline, ClassSection, EduSpace, User, Student) são ids simples.
// Horários da grade em minutos desde 00:00 (ex.: 19:00 = 1140). Dia da semana: 1=seg ... 7=dom.
// ============================================================

enum CalEventoTipo {
  INICIO_PERIODO
  FIM_PERIODO
  MATRICULA
  REMATRICULA
  TRANCAMENTO
  AULA_INAUGURAL
  PROVA
  SEGUNDA_CHAMADA
  EXAME_FINAL
  FERIADO
  PONTO_FACULTATIVO
  RECESSO
  FERIAS
  REUNIAO
  CONSELHO_CLASSE
  COLACAO
  FORMATURA
  PRAZO_NOTAS
  PRAZO_DIARIO
  SEMANA_ACADEMICA
  VESTIBULAR
  ENADE
  DIA_LETIVO_EXTRA
  EVENTO_INSTITUCIONAL
  OUTRO
}

enum CalPublico {
  TODOS
  ALUNOS
  PROFESSORES
  COORDENACAO
  ADMINISTRATIVO
}

enum CalRecorrencia {
  NENHUMA
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
  ANUAL
}

enum CalTurno {
  MANHA
  TARDE
  NOITE
}

enum CalTipoAula {
  TEORICA
  PRATICA
  ONLINE
}

enum CalOrigemSlot {
  MANUAL
  GERADOR
}

enum CalDisponibilidadeTipo {
  DISPONIVEL
  INDISPONIVEL
  PREFERENCIA
}

enum CalReservaTipo {
  EVENTO
  AULA_EXTRA
  REUNIAO
  PROVA
  MANUTENCAO
  LIMPEZA
  OUTRO
}

enum CalReservaStatus {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
  EXPIRADA
}

enum CalExameTipo {
  PROVA_1
  PROVA_2
  SUBSTITUTIVA
  EXAME_FINAL
  SEGUNDA_CHAMADA
  REAVALIACAO
  PROVA_UNICA
  PRATICA
  TRABALHO
  SIMULADO
}

enum CalExameStatus {
  AGENDADA
  CONFIRMADA
  REALIZADA
  CANCELADA
  REMARCADA
}

enum CalPrazoTipo {
  LANCAMENTO_NOTAS
  DIARIO_CLASSE
  FECHAMENTO_FINAL
  REVISAO_NOTAS
  RECUPERACAO
}

enum CalConflitoTipo {
  PROFESSOR
  TURMA
  ESPACO
  ALUNO
  CAPACIDADE
  TIPO_ESPACO
  RESERVA
  PROVA
}

enum CalConflitoStatus {
  ABERTO
  RESOLVIDO
  IGNORADO
}

enum CalGeracaoStatus {
  SIMULADA
  APLICADA
  DESCARTADA
}

enum CalFeedEscopo {
  TURMA
  PROFESSOR
  ESPACO
  ALUNO
  INSTITUCIONAL
}

// Categoria de evento (nome + cor) do calendário acadêmico.
model CalCategoria {
  id          String   @id @default(uuid())
  tenantId    String
  nome        String
  cor         String   @default("#0F5FDB")
  icone       String?
  tipoPadrao  CalEventoTipo?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, nome])
  @@index([tenantId])
}

// Evento do calendário acadêmico (por período letivo, campus e/ou curso).
model CalEvento {
  id                  String   @id @default(uuid())
  tenantId            String
  termId              String?
  campusId            String?
  programId           String?
  categoriaId         String?
  tipo                CalEventoTipo @default(OUTRO)
  titulo              String
  descricao           String?
  local               String?
  inicio              DateTime
  fim                 DateTime
  diaInteiro          Boolean  @default(true)
  publico             CalPublico @default(TODOS)
  recorrencia         CalRecorrencia @default(NENHUMA)
  recorrenciaIntervalo Int     @default(1)
  recorrenciaAte      DateTime?
  bloqueiaAulas       Boolean  @default(false)   // feriado/recesso: não há aula nesses dias
  lembreteDias        Int[]    @default([])      // avisar N dias antes (ex.: [7,1])
  origemKey           String?                    // idempotência de importações (ex.: "feriado:2026-04-21")
  ativo               Boolean  @default(true)
  criadoPorId         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, origemKey])
  @@index([tenantId, inicio])
  @@index([tenantId, termId])
  @@index([tenantId, tipo])
}

// Faixas de horário de aula (1ª aula, 2ª aula...) que formam a malha da grade.
model CalHorario {
  id          String   @id @default(uuid())
  tenantId    String
  nome        String
  turno       CalTurno
  ordem       Int
  inicioMin   Int
  fimMin      Int
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, turno, ordem])
  @@index([tenantId])
}

// Disponibilidade/indisponibilidade/preferência de professor por dia e faixa.
// Regra: havendo linhas DISPONIVEL, o professor só leciona dentro delas;
// INDISPONIVEL sempre exclui; PREFERENCIA só dá bônus de pontuação.
model CalDisponibilidade {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  termId      String?
  diaSemana   Int
  inicioMin   Int
  fimMin      Int
  tipo        CalDisponibilidadeTipo @default(DISPONIVEL)
  observacao  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, termId])
}

// Limites por professor para o gerador de grade.
model CalProfessorPerfil {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String
  maxAulasDia     Int?
  maxAulasSemana  Int?
  observacao      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, userId])
}

// Parâmetros de alocação por disciplina (carga semanal, prática -> laboratório, recursos).
model CalDisciplinaConfig {
  id              String   @id @default(uuid())
  tenantId        String
  disciplineId    String
  aulasSemana     Int?              // se nulo, deriva da carga horária / semanas letivas
  blocoMax        Int      @default(2)
  pratica         Boolean  @default(false)
  tiposEspaco     Json?             // ["LABORATORIO"]; padrão: prática=LABORATORIO, teórica=SALA_AULA/AUDITORIO
  recursos        Json?             // ["projetor","bancadas"]
  capacidadeMinima Int?
  espacoFixoId    String?
  online          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, disciplineId])
}

// Parâmetros de alocação por turma (ClassSection): série/período, turno e "grupo"
// (coorte). Turmas de disciplinas distintas do mesmo grupo compartilham os mesmos alunos
// e portanto não podem ter aulas simultâneas.
model CalTurmaConfig {
  id              String   @id @default(uuid())
  tenantId        String
  classSectionId  String
  programId       String?
  periodo         Int?              // série/período do curso
  turno           CalTurno?
  grupo           String?
  alunosEstimados Int?
  diasPermitidos  Int[]    @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, classSectionId])
  @@index([tenantId, grupo])
}

// Slot semanal da grade horária.
model CalSlot {
  id              String   @id @default(uuid())
  tenantId        String
  termId          String
  classSectionId  String
  disciplineId    String
  grupo           String?
  programId       String?
  periodo         Int?
  professorUserId String?
  spaceId         String?
  diaSemana       Int
  inicioMin       Int
  fimMin          Int
  tipoAula        CalTipoAula @default(TEORICA)
  origem          CalOrigemSlot @default(MANUAL)
  geracaoId       String?
  fixo            Boolean  @default(false)   // o gerador nunca remove slots fixos
  ativo           Boolean  @default(true)
  observacao      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, termId, diaSemana])
  @@index([tenantId, professorUserId])
  @@index([tenantId, spaceId])
  @@index([tenantId, classSectionId])
  @@index([tenantId, geracaoId])
}

// Execução do gerador automático de grade (simulação ou aplicação).
model CalGeracao {
  id              String   @id @default(uuid())
  tenantId        String
  termId          String
  status          CalGeracaoStatus @default(SIMULADA)
  parametros      Json
  resumo          Json?
  pendencias      Json?
  totalAulas      Int      @default(0)
  alocadas        Int      @default(0)
  pendentes       Int      @default(0)
  pontuacao       Float?
  nos             Int      @default(0)
  duracaoMs       Int      @default(0)
  criadoPorId     String?
  aplicadoEm      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, termId])
}

// Reserva de espaço (pontual ou de série) e bloqueios (manutenção/limpeza).
model CalReserva {
  id              String   @id @default(uuid())
  tenantId        String
  spaceId         String
  titulo          String
  finalidade      String?
  tipo            CalReservaTipo @default(EVENTO)
  status          CalReservaStatus @default(PENDENTE)
  bloqueio        Boolean  @default(false)
  inicio          DateTime
  fim             DateTime
  solicitanteId   String
  classSectionId  String?
  professorUserId String?
  participantes   Int?
  recursosSolicitados Json?
  serieId         String?
  recorrencia     CalRecorrencia @default(NENHUMA)
  recorrenciaAte  DateTime?
  decididoPorId   String?
  decididoEm      DateTime?
  motivoDecisao   String?
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, spaceId, inicio])
  @@index([tenantId, status])
  @@index([tenantId, serieId])
  @@index([tenantId, solicitanteId])
}

// Avaliação agendada (prova, 2ª chamada, exame...).
model CalExame {
  id                    String   @id @default(uuid())
  tenantId              String
  termId                String
  classSectionId        String
  disciplineId          String?
  assessmentId          String?
  grupo                 String?
  titulo                String
  tipo                  CalExameTipo @default(PROVA_1)
  inicio                DateTime
  fim                   DateTime
  spaceId               String?
  professorUserId       String?
  alunosPrevistos       Int?
  status                CalExameStatus @default(AGENDADA)
  originalId            String?               // 2ª chamada aponta para a prova original
  segundaChamadaInicio  DateTime?
  segundaChamadaFim     DateTime?
  observacoes           String?
  lembreteAlunosEm      DateTime?
  criadoPorId           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  fiscais               CalExameFiscal[]

  @@index([tenantId, termId, inicio])
  @@index([tenantId, classSectionId])
  @@index([tenantId, spaceId, inicio])
}

model CalExameFiscal {
  id          String   @id @default(uuid())
  tenantId    String
  exameId     String
  userId      String
  papel       String   @default("FISCAL")   // FISCAL | COORDENADOR_SALA | APOIO
  confirmado  Boolean  @default(false)
  createdAt   DateTime @default(now())

  exame       CalExame @relation(fields: [exameId], references: [id], onDelete: Cascade)

  @@unique([exameId, userId])
  @@index([tenantId, userId])
}

// Prazo de lançamento de notas/diário por período letivo (consumido por `notas`).
model CalPrazoNotas {
  id                  String   @id @default(uuid())
  tenantId            String
  termId              String
  programId           String?
  campusId            String?
  tipo                CalPrazoTipo @default(LANCAMENTO_NOTAS)
  etapa               String?               // "N1", "N2", "FINAL"...
  titulo              String
  abertura            DateTime?
  prazo               DateTime
  prorrogadoAte       DateTime?
  ativo               Boolean  @default(true)
  escalonadoCoordEm   DateTime?
  escalonadoDirecaoEm DateTime?
  observacoes         String?
  criadoPorId         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  excecoes            CalPrazoExcecao[]
  conclusoes          CalPrazoConclusao[]

  @@index([tenantId, termId])
  @@index([tenantId, prazo])
}

// Prorrogação individual para um professor.
model CalPrazoExcecao {
  id            String   @id @default(uuid())
  tenantId      String
  prazoId       String
  userId        String
  ate           DateTime
  motivo        String?
  concedidoPorId String?
  createdAt     DateTime @default(now())

  prazo         CalPrazoNotas @relation(fields: [prazoId], references: [id], onDelete: Cascade)

  @@unique([prazoId, userId])
}

// Professor que já concluiu o lançamento daquele prazo.
model CalPrazoConclusao {
  id            String   @id @default(uuid())
  tenantId      String
  prazoId       String
  userId        String
  concluidoEm   DateTime @default(now())
  origem        String?

  prazo         CalPrazoNotas @relation(fields: [prazoId], references: [id], onDelete: Cascade)

  @@unique([prazoId, userId])
}

// Choques detectados (e resolvidos) — alimenta o relatório de choques resolvidos.
model CalConflito {
  id            String   @id @default(uuid())
  tenantId      String
  termId        String?
  tipo          CalConflitoTipo
  status        CalConflitoStatus @default(ABERTO)
  chave         String
  descricao     String
  detalhes      Json?
  detectadoEm   DateTime @default(now())
  resolvidoEm   DateTime?
  resolvidoPorId String?
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, chave])
  @@index([tenantId, status])
  @@index([tenantId, termId])
}

// Token de assinatura (webcal/iCal) para Google Calendar/Outlook/Apple.
model CalFeed {
  id            String   @id @default(uuid())
  tenantId      String
  token         String   @unique
  escopo        CalFeedEscopo
  refId         String?
  termId        String?
  titulo        String?
  ativo         Boolean  @default(true)
  criadoPorId   String?
  ultimoAcesso  DateTime?
  createdAt     DateTime @default(now())

  @@index([tenantId, escopo])
}

// ---- edu/comunicacao.prisma ----
// ============================================================
// EDUMASTER PRO — COMUNICAÇÃO OMNICHANNEL (prefixo Com)
// Canais, contatos/consentimento, inbox, templates, campanhas, régua de
// cobrança, chatbot, redes sociais e voz. A caixa de saída é a EduNotification
// do núcleo; este módulo a despacha.
// ============================================================

enum ComCanalTipo {
  WHATSAPP
  TELEGRAM
  EMAIL
  SMS
  VOZ
  INSTAGRAM
  FACEBOOK
  SITE_CHAT
}

// Canal configurado do tenant. As credenciais ficam CIFRADAS (secretVault) em configCifrada.
model ComCanal {
  id              String   @id @default(uuid())
  tenantId        String
  tipo            ComCanalTipo
  nome            String
  provedor        String        // META_CLOUD | TWILIO | TELEGRAM_BOT | RESEND | META_GRAPH | PROPRIO
  ativo           Boolean  @default(true)
  configCifrada   String?       // JSON cifrado com credenciais
  configurado     Boolean  @default(false)
  delegarRevah    Boolean  @default(false)   // despacho fica a cargo do REVAH
  limiteHora      Int      @default(300)
  limiteDia       Int      @default(2000)
  restringirHorario Boolean @default(false)  // respeita janela comercial
  ultimoTesteEm   DateTime?
  ultimoTesteOk   Boolean?
  ultimoTesteMsg  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, tipo, nome])
  @@index([tenantId, tipo, ativo])
}

// Configuração geral da comunicação do tenant (uma linha por tenant).
model ComConfig {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  horarioInicio         String   @default("08:00")
  horarioFim            String   @default("20:00")
  diasUteis             Int[]    @default([1, 2, 3, 4, 5, 6])  // 0=dom ... 6=sáb
  maxTentativas         Int      @default(4)
  backoffMinutos        Int[]    @default([5, 15, 60])
  slaPrimeiraRespostaMin Int     @default(30)
  slaResolucaoMin       Int      @default(1440)
  botAtivo              Boolean  @default(true)
  iaFallback            Boolean  @default(true)
  iaLimiteDiarioConversa Int     @default(5)
  mensagemHandoff       String   @default("Vou transferir você para um de nossos atendentes. Aguarde um instante, por favor.")
  mensagemForaHorario   String   @default("Nosso atendimento humano funciona em horário comercial. Deixe sua mensagem que responderemos assim que possível.")
  mensagemBoasVindas    String   @default("Olá! Sou o assistente virtual da instituição. Como posso ajudar?")
  uraMenu               Json?    // URA de voz: { saudacao, opcoes:[{digito,rotulo,acao,destino,mensagem}] }
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum ComContatoTipo {
  ALUNO
  CANDIDATO
  EGRESSO
  RESPONSAVEL
  FUNCIONARIO
  OUTRO
}

// Contato unificado (aluno, candidato, egresso, responsável, funcionário).
model ComContato {
  id              String   @id @default(uuid())
  tenantId        String
  tipo            ComContatoTipo @default(OUTRO)
  nome            String
  email           String?
  telefone        String?       // normalizado E.164 (+55...)
  telegramChatId  String?
  instagramId     String?
  facebookId      String?
  documento       String?       // CPF (somente dígitos)
  studentId       String?
  candidatoId     String?
  userId          String?
  tags            String[]      @default([])
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  preferencias    ComPreferencia[]
  conversas       ComConversa[]

  @@index([tenantId, tipo])
  @@index([tenantId, telefone])
  @@index([tenantId, email])
  @@index([tenantId, studentId])
  @@index([tenantId, telegramChatId])
}

// Consentimento/opt-out LGPD por contato x canal x finalidade.
// finalidade: MARKETING | COBRANCA | ACADEMICO | TODAS. canal "*" = todos os canais.
model ComPreferencia {
  id              String   @id @default(uuid())
  tenantId        String
  contatoId       String
  canal           String   @default("*")
  finalidade      String   @default("MARKETING")
  consentimento   Boolean  @default(true)
  origem          String?       // FORMULARIO | MENSAGEM_SAIR | ATENDENTE | IMPORTACAO
  motivo          String?
  registradoEm    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contato         ComContato @relation(fields: [contatoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contatoId, canal, finalidade])
  @@index([tenantId, contatoId])
}

model ComTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  chave       String
  nome        String
  categoria   String   @default("GERAL")   // COBRANCA | ACADEMICO | MARKETING | ADMISSOES | GERAL
  canal       String?                      // nulo = serve a qualquer canal
  assunto     String?
  corpo       String
  variaveis   String[] @default([])
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, chave])
  @@index([tenantId, categoria])
}

enum ComConversaStatus {
  ABERTA
  PENDENTE
  EM_ATENDIMENTO
  AGUARDANDO_CONTATO
  RESOLVIDA
  ARQUIVADA
}

model ComConversa {
  id                    String   @id @default(uuid())
  tenantId              String
  contatoId             String
  canalTipo             ComCanalTipo
  canalId               String?
  chaveExterna          String?       // chat id / telefone / e-mail no provedor
  assunto               String?
  status                ComConversaStatus @default(ABERTA)
  prioridade            Int      @default(0)
  atribuidoAId          String?
  etiquetas             String[] @default([])
  botAtivo              Boolean  @default(true)
  botEstado             Json?
  naoLidas              Int      @default(0)
  slaPrimeiraRespostaEm DateTime?
  slaResolucaoEm        DateTime?
  primeiraRespostaEm    DateTime?
  ultimaMensagemEm      DateTime @default(now())
  ultimaDirecao         String?
  resolvidaEm           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contato               ComContato @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  mensagens             ComMensagem[]

  @@index([tenantId, status, ultimaMensagemEm])
  @@index([tenantId, atribuidoAId, status])
  @@index([tenantId, contatoId])
  @@index([tenantId, canalTipo, chaveExterna])
}

model ComMensagem {
  id              String   @id @default(uuid())
  tenantId        String
  conversaId      String
  direcao         String        // ENTRADA | SAIDA | NOTA_INTERNA
  autorTipo       String        // CONTATO | ATENDENTE | BOT | BOT_IA | SISTEMA
  autorId         String?
  conteudo        String
  midiaUrl        String?
  externalId      String?
  notificationId  String?
  status          String   @default("REGISTRADA")  // REGISTRADA | PENDENTE | ENVIADA | ENTREGUE | LIDA | FALHA
  erro            String?
  createdAt       DateTime @default(now())

  conversa        ComConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@unique([tenantId, conversaId, externalId])
  @@index([tenantId, conversaId, createdAt])
  @@index([tenantId, notificationId])
}

enum ComCampanhaStatus {
  RASCUNHO
  AGENDADA
  EXECUTANDO
  CONCLUIDA
  CANCELADA
}

model ComCampanha {
  id              String   @id @default(uuid())
  tenantId        String
  nome            String
  segmento        String        // INADIMPLENTES | A_VENCER | REMATRICULA_PENDENTE | CANDIDATOS_ETAPA | EGRESSOS | ALUNOS_ATIVOS | CONTATOS | LISTA
  filtros         Json?
  canal           String        // EMAIL | WHATSAPP | SMS | TELEGRAM | VOZ
  templateId      String
  finalidade      String   @default("MARKETING")
  status          ComCampanhaStatus @default(RASCUNHO)
  agendadaPara    DateTime?
  iniciadaEm      DateTime?
  concluidaEm     DateTime?
  totalAlvo       Int      @default(0)
  totalEnfileirado Int     @default(0)
  totalBloqueado  Int      @default(0)
  totalSemDestino Int      @default(0)
  criadoPorId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  destinatarios   ComCampanhaDestinatario[]

  @@index([tenantId, status, agendadaPara])
}

model ComCampanhaDestinatario {
  id              String   @id @default(uuid())
  tenantId        String
  campanhaId      String
  chave           String        // dedupe: studentId|candidatoId|contatoId|destino
  nome            String?
  contatoId       String?
  studentId       String?
  destino         String?
  resultado       String        // ENFILEIRADO | BLOQUEADO_OPTOUT | SEM_DESTINO
  notificationId  String?
  createdAt       DateTime @default(now())

  campanha        ComCampanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, chave])
  @@index([tenantId, campanhaId, resultado])
  @@index([tenantId, notificationId])
}

model ComRegua {
  id          String   @id @default(uuid())
  tenantId    String
  nome        String
  ativa       Boolean  @default(true)
  toleranciaDias Int   @default(2)    // recupera etapas perdidas até N dias depois do gatilho
  descricao   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  etapas      ComReguaEtapa[]

  @@index([tenantId, ativa])
}

// offsetDias relativo ao vencimento: -3 = 3 dias antes; 0 = no dia; 3 = 3 dias depois.
model ComReguaEtapa {
  id          String   @id @default(uuid())
  tenantId    String
  reguaId     String
  nome        String
  offsetDias  Int
  canal       String   @default("WHATSAPP")
  canalFallback String?                 // usado se o contato não tiver destino no canal principal
  templateId  String
  ativa       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regua       ComRegua @relation(fields: [reguaId], references: [id], onDelete: Cascade)
  execucoes   ComReguaExecucao[]

  @@index([tenantId, reguaId])
}

// Registro de cada disparo da régua: o unique garante "sem duplicar".
model ComReguaExecucao {
  id              String   @id @default(uuid())
  tenantId        String
  reguaId         String
  etapaId         String
  receivableId    String
  studentId       String?
  notificationId  String?
  resultado       String   @default("ENFILEIRADO")  // ENFILEIRADO | SEM_DESTINO | BLOQUEADO_OPTOUT
  createdAt       DateTime @default(now())

  etapa           ComReguaEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@unique([etapaId, receivableId])
  @@index([tenantId, receivableId])
  @@index([tenantId, reguaId, createdAt])
}

// Fluxo do chatbot (árvore de menu). definicao: { inicio, nos:{id:{texto,opcoes:[{rotulo,gatilhos,proximo,acao}] ,acao}} }
model ComBotFluxo {
  id          String   @id @default(uuid())
  tenantId    String
  nome        String
  intencao    String        // ex.: SEGUNDA_VIA_BOLETO, NOTAS, MENU_PRINCIPAL
  gatilhos    String[] @default([])
  definicao   Json
  prioridade  Int      @default(0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, ativo])
  @@index([tenantId, intencao])
}

model ComFaq {
  id            String   @id @default(uuid())
  tenantId      String
  categoria     String   @default("GERAL")
  pergunta      String
  resposta      String
  palavrasChave String[] @default([])
  usos          Int      @default(0)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, ativo, categoria])
}

enum ComRedeSocial {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  YOUTUBE
  X
}

model ComSocialConta {
  id              String   @id @default(uuid())
  tenantId        String
  rede            ComRedeSocial
  nome            String
  handle          String?
  externalId      String?       // page id (Facebook) / ig user id (Instagram)
  tokenCifrado    String?       // { accessToken } cifrado
  ativa           Boolean  @default(true)
  seguidores      Int?
  ultimaSincEm    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts           ComSocialPost[]

  @@index([tenantId, rede])
}

enum ComPostStatus {
  RASCUNHO
  EM_APROVACAO
  APROVADO
  REJEITADO
  PUBLICADO
  MANUAL
  FALHA
  CANCELADO
}

model ComSocialPost {
  id              String   @id @default(uuid())
  tenantId        String
  contaId         String
  titulo          String
  texto           String
  midiaUrls       String[] @default([])
  tema            String?
  agendadoPara    DateTime?
  status          ComPostStatus @default(RASCUNHO)
  criadoPorId     String?
  aprovadoPorId   String?
  aprovadoEm      DateTime?
  motivoRejeicao  String?
  publicadoEm     DateTime?
  externalId      String?
  urlPublicado    String?
  tentativas      Int      @default(0)
  erro            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conta           ComSocialConta @relation(fields: [contaId], references: [id], onDelete: Cascade)
  metricas        ComSocialMetrica[]
  interacoes      ComSocialInteracao[]

  @@index([tenantId, status, agendadoPara])
  @@index([tenantId, contaId])
}

model ComSocialMetrica {
  id              String   @id @default(uuid())
  tenantId        String
  contaId         String
  postId          String?
  data            DateTime @default(now())
  alcance         Int      @default(0)
  impressoes      Int      @default(0)
  curtidas        Int      @default(0)
  comentarios     Int      @default(0)
  compartilhamentos Int    @default(0)
  cliques         Int      @default(0)
  seguidores      Int?
  origem          String   @default("MANUAL")   // MANUAL | GRAPH_API
  createdAt       DateTime @default(now())

  post            ComSocialPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([tenantId, contaId, data])
  @@index([tenantId, postId])
}

// Comentários, menções e DMs das redes para moderação.
model ComSocialInteracao {
  id              String   @id @default(uuid())
  tenantId        String
  contaId         String
  postId          String?
  tipo            String        // COMENTARIO | DM | MENCAO
  autor           String?
  texto           String
  externalId      String?
  status          String   @default("PENDENTE")  // PENDENTE | APROVADO | OCULTO | RESPONDIDO | SPAM
  resposta        String?
  respondidoEm    DateTime?
  moderadoPorId   String?
  alerta          String?       // palavra/motivo que acionou a triagem automática
  createdAt       DateTime @default(now())

  post            ComSocialPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([tenantId, contaId, externalId])
  @@index([tenantId, status, createdAt])
}

model ComChamada {
  id              String   @id @default(uuid())
  tenantId        String
  canalId         String?
  direcao         String        // SAIDA | ENTRADA
  de              String?
  para            String?
  contatoId       String?
  status          String   @default("INICIADA")   // INICIADA | TOCANDO | EM_ANDAMENTO | CONCLUIDA | NAO_ATENDIDA | OCUPADO | FALHA
  duracaoSeg      Int?
  provedorSid     String?
  mensagem        String?
  digitos         String?
  atendenteId     String?
  notas           String?
  erro            String?
  inicioEm        DateTime @default(now())
  fimEm           DateTime?
  createdAt       DateTime @default(now())

  @@index([tenantId, inicioEm])
  @@index([tenantId, provedorSid])
}

// Log de webhooks recebidos (diagnóstico; rejeições de assinatura também aparecem).
model ComWebhookLog {
  id          String   @id @default(uuid())
  tenantId    String?
  canalId     String?
  tipo        String
  ok          Boolean
  motivo      String?
  createdAt   DateTime @default(now())

  @@index([canalId, createdAt])
}

// ---- edu/desempenho.prisma ----
// ============================================================
// EDUMASTER PRO — DESEMPENHO (ENADE, OAB, ENAMED/Residência) — prefixo Des
// ============================================================

enum DesTipoExame {
  ENADE
  OAB_1FASE
  OAB_2FASE
  ENAMED
  RESIDENCIA
  REVALIDA
  CONCURSO
  OUTRO
}

enum DesTipoEixo {
  AREA
  EIXO
  COMPETENCIA
}

enum DesStatusEdicao {
  PLANEJADA
  INSCRICOES_ABERTAS
  INSCRICOES_ENCERRADAS
  REALIZADA
  RESULTADO_PUBLICADO
  CANCELADA
}

enum DesCategoriaInscrito {
  INGRESSANTE
  CONCLUINTE
  CANDIDATO
}

enum DesSituacaoInscricao {
  PENDENTE
  INSCRITO
  REGULAR
  DISPENSADO
  IRREGULAR
  AUSENTE
}

enum DesTipoQuestao {
  OBJETIVA
  DISCURSIVA
  PECA_PRATICA
  CASO_CLINICO
}

enum DesNivel {
  FACIL
  MEDIO
  DIFICIL
}

enum DesStatusQuestao {
  RASCUNHO
  REVISADO
  PUBLICADO
  ARQUIVADO
}

enum DesOrigemQuestao {
  MANUAL
  IA
  IMPORTADA
}

enum DesStatusSimulado {
  RASCUNHO
  PUBLICADO
  ENCERRADO
}

enum DesStatusTentativa {
  EM_ANDAMENTO
  ENVIADA
  EXPIRADA
}

enum DesTipoKit {
  QUESTOES_CONTEXTUALIZADAS
  ESTUDO_CASO
  PECA_PRATICA_OAB
  CASO_CLINICO
  LISTA_EXERCICIOS
  REVISAO_TEORICA
}

enum DesVisibilidadeKit {
  PRIVADA
  COMPARTILHADA
}

enum DesStatusAtribuicao {
  ABERTA
  ENCERRADA
  CANCELADA
}

enum DesStatusEntrega {
  PENDENTE
  ENTREGUE
  CORRIGIDA
  ATRASADA
}

enum DesStatusTrilha {
  ATIVA
  CONCLUIDA
  PAUSADA
  CANCELADA
}

enum DesTipoItemTrilha {
  ESTUDO
  QUESTOES
  REVISAO
  SIMULADO
  ATIVIDADE
}

enum DesStatusItemTrilha {
  PENDENTE
  CONCLUIDO
  ADIADO
}

model DesExame {
  id           String       @id @default(uuid())
  tenantId     String
  codigo       String
  nome         String
  tipo         DesTipoExame
  descricao    String?
  numQuestoes  Int?
  duracaoMin   Int?
  notaCorte    Float?       // % mínimo de acertos para aprovação/regularidade (ex.: OAB 50)
  ativo        Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  eixos        DesEixo[]
  edicoes      DesEdicao[]

  @@unique([tenantId, codigo])
  @@index([tenantId, tipo])
}

model DesEixo {
  id          String      @id @default(uuid())
  tenantId    String
  exameId     String
  parentId    String?
  codigo      String
  nome        String
  tipo        DesTipoEixo @default(AREA)
  peso        Float       @default(1)     // peso relativo na prova (ex.: nº típico de questões)
  metaAcerto  Float       @default(60)    // % de acerto desejado
  ordem       Int         @default(0)
  descricao   String?
  ativo       Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  exame       DesExame    @relation(fields: [exameId], references: [id], onDelete: Cascade)

  @@unique([exameId, codigo])
  @@index([tenantId, exameId])
}

model DesEdicao {
  id               String          @id @default(uuid())
  tenantId         String
  exameId          String
  ano              Int
  titulo           String          @default("")
  dataProva        DateTime?
  inscricaoInicio  DateTime?
  inscricaoFim     DateTime?
  dataResultado    DateTime?
  status           DesStatusEdicao @default(PLANEJADA)
  observacoes      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  exame            DesExame        @relation(fields: [exameId], references: [id], onDelete: Cascade)
  inscricoes       DesInscricao[]

  @@unique([exameId, ano, titulo])
  @@index([tenantId, exameId])
  @@index([tenantId, dataProva])
}

model DesInscricao {
  id             String               @id @default(uuid())
  tenantId       String
  edicaoId       String
  studentId      String
  programId      String?
  categoria      DesCategoriaInscrito @default(CONCLUINTE)
  situacao       DesSituacaoInscricao @default(PENDENTE)
  protocolo      String?
  nota           Float?
  conceito       Int?
  observacao     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  edicao         DesEdicao            @relation(fields: [edicaoId], references: [id], onDelete: Cascade)

  @@unique([edicaoId, studentId])
  @@index([tenantId, edicaoId, situacao])
  @@index([tenantId, studentId])
}

model DesMetaCurso {
  id             String   @id @default(uuid())
  tenantId       String
  programId      String
  exameId        String
  ano            Int
  metaAcerto     Float    // % global
  conceitoAlvo   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, programId, exameId, ano])
  @@index([tenantId, exameId])
}

model DesQuestao {
  id                  String           @id @default(uuid())
  tenantId            String
  exameId             String
  eixoId              String?
  disciplineId        String?
  tipo                DesTipoQuestao   @default(OBJETIVA)
  enunciado           String
  alternativas        Json?            // [{letra:'A',texto:'...'}]
  gabarito            String?          // letra (objetiva) ou padrão de resposta (discursiva)
  comentario          String?
  nivel               DesNivel         @default(MEDIO)
  anoFonte            Int?
  fonte               String?
  status              DesStatusQuestao @default(RASCUNHO)
  origem              DesOrigemQuestao @default(MANUAL)
  totalRespostas      Int              @default(0)
  totalAcertos        Int              @default(0)
  indiceDiscriminacao Float?
  criadoPorId         String?
  revisadoPorId       String?
  revisadoEm          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([tenantId, exameId, status])
  @@index([tenantId, eixoId])
  @@index([tenantId, disciplineId])
}

model DesSimulado {
  id            String            @id @default(uuid())
  tenantId      String
  exameId       String
  titulo        String
  descricao     String?
  status        DesStatusSimulado @default(RASCUNHO)
  abreEm        DateTime?
  fechaEm       DateTime?
  duracaoMin    Int               @default(180)
  matriz        Json?             // distribuição usada na montagem [{eixoId,quantidade,niveis?}]
  criadoPorId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  questoes      DesSimuladoQuestao[]
  alvos         DesSimuladoAlvo[]
  tentativas    DesTentativa[]

  @@index([tenantId, exameId, status])
}

model DesSimuladoQuestao {
  id          String      @id @default(uuid())
  tenantId    String
  simuladoId  String
  questaoId   String
  eixoId      String?
  ordem       Int
  createdAt   DateTime    @default(now())

  simulado    DesSimulado @relation(fields: [simuladoId], references: [id], onDelete: Cascade)

  @@unique([simuladoId, questaoId])
  @@index([tenantId, simuladoId])
}

model DesSimuladoAlvo {
  id             String      @id @default(uuid())
  tenantId       String
  simuladoId     String
  classSectionId String?
  programId      String?
  studentId      String?
  createdAt      DateTime    @default(now())

  simulado       DesSimulado @relation(fields: [simuladoId], references: [id], onDelete: Cascade)

  @@index([tenantId, simuladoId])
  @@index([tenantId, studentId])
  @@index([tenantId, classSectionId])
}

model DesTentativa {
  id            String             @id @default(uuid())
  tenantId      String
  simuladoId    String
  studentId     String
  status        DesStatusTentativa @default(EM_ANDAMENTO)
  iniciadaEm    DateTime           @default(now())
  expiraEm      DateTime?
  enviadaEm     DateTime?
  acertos       Int                @default(0)
  total         Int                @default(0)
  percentual    Float?
  porEixo       Json?              // [{eixoId,acertos,total,percentual}]
  tempoSegundos Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  simulado      DesSimulado        @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  respostas     DesResposta[]

  @@unique([simuladoId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, simuladoId, status])
}

model DesResposta {
  id           String       @id @default(uuid())
  tenantId     String
  tentativaId  String
  questaoId    String
  eixoId       String?
  alternativa  String?
  correta      Boolean?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tentativa    DesTentativa @relation(fields: [tentativaId], references: [id], onDelete: Cascade)

  @@unique([tentativaId, questaoId])
  @@index([tenantId, questaoId])
}

model DesKit {
  id            String             @id @default(uuid())
  tenantId      String
  titulo        String
  tipo          DesTipoKit         @default(QUESTOES_CONTEXTUALIZADAS)
  exameId       String?
  eixoId        String?
  disciplineId  String?
  descricao     String?
  conteudo      String?            // texto/caso/enunciado da peça (HTML ou markdown)
  questaoIds    Json?              // string[]
  gabaritoComentado String?
  tempoEstimadoMin Int?
  visibilidade  DesVisibilidadeKit @default(PRIVADA)
  autorUserId   String
  usos          Int                @default(0)
  ativo         Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  atribuicoes   DesAtribuicao[]

  @@index([tenantId, disciplineId])
  @@index([tenantId, visibilidade])
  @@index([tenantId, autorUserId])
}

model DesAtribuicao {
  id              String              @id @default(uuid())
  tenantId        String
  kitId           String
  classSectionId  String
  professorUserId String
  prazo           DateTime
  instrucoes      String?
  status          DesStatusAtribuicao @default(ABERTA)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  kit             DesKit              @relation(fields: [kitId], references: [id])
  entregas        DesEntrega[]

  @@index([tenantId, classSectionId])
  @@index([tenantId, professorUserId, status])
  @@index([tenantId, prazo])
}

model DesEntrega {
  id             String           @id @default(uuid())
  tenantId       String
  atribuicaoId   String
  studentId      String
  status         DesStatusEntrega @default(PENDENTE)
  respostas      Json?            // {questaoId: letra} ou texto livre
  texto          String?
  acertos        Int?
  total          Int?
  nota           Float?           // 0-100
  feedback       String?
  entregueEm     DateTime?
  corrigidaEm    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  atribuicao     DesAtribuicao    @relation(fields: [atribuicaoId], references: [id], onDelete: Cascade)

  @@unique([atribuicaoId, studentId])
  @@index([tenantId, studentId])
}

model DesTrilha {
  id            String          @id @default(uuid())
  tenantId      String
  studentId     String
  exameId       String
  status        DesStatusTrilha @default(ATIVA)
  metaPercentual Float          @default(60)
  metaData      DateTime?
  horasSemana   Float           @default(6)
  lacunas       Json?           // [{eixoId,atual,meta,gap,prioridade}]
  progresso     Float           @default(0)
  geradaEm      DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  itens         DesTrilhaItem[]

  @@index([tenantId, studentId, status])
  @@index([tenantId, exameId])
}

model DesTrilhaItem {
  id           String              @id @default(uuid())
  tenantId     String
  trilhaId     String
  eixoId       String?
  semana       Int
  tipo         DesTipoItemTrilha
  titulo       String
  descricao    String?
  minutos      Int                 @default(60)
  dataPrevista DateTime
  status       DesStatusItemTrilha @default(PENDENTE)
  revisaoN     Int                 @default(0)   // 0 = estudo original; n = n-ésima revisão espaçada
  concluidoEm  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  trilha       DesTrilha           @relation(fields: [trilhaId], references: [id], onDelete: Cascade)

  @@index([tenantId, trilhaId])
  @@index([tenantId, dataPrevista, status])
}

// ---- edu/governanca.prisma ----
// ============================================================
// EDUMASTER PRO — GOVERNANÇA (prefixo Gov)
// PDI, documentos institucionais/PPC, CPA, NDE, colegiados, CIPA, carreira.
// Referências a outros módulos (curso, docente, usuário) = String sem @relation.
// ============================================================

// ---------- Numeração anual por tenant (resoluções etc.) ----------
model GovSequencia {
  id        String   @id @default(uuid())
  tenantId  String
  chave     String        // ex.: DELIBERACAO
  ano       Int
  ultimo    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chave, ano])
}

// ================= PDI =================
enum GovPdiStatus {
  RASCUNHO
  VIGENTE
  ENCERRADO
}

enum GovPeriodicidade {
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum GovSentidoIndicador {
  MAIOR_MELHOR
  MENOR_MELHOR
}

enum GovStatusAcao {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model GovPdi {
  id         String       @id @default(uuid())
  tenantId   String
  titulo     String
  anoInicio  Int
  anoFim     Int
  missao     String?
  visao      String?
  valores    String?
  status     GovPdiStatus @default(RASCUNHO)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  eixos      GovPdiEixo[]

  @@index([tenantId, status])
}

model GovPdiEixo {
  id             String   @id @default(uuid())
  tenantId       String
  pdiId          String
  nome           String
  descricao      String?
  eixoSinaes     Int?          // 1..5
  dimensaoSinaes Int?          // 1..10
  peso           Float    @default(1)
  ordem          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pdi       GovPdi         @relation(fields: [pdiId], references: [id], onDelete: Cascade)
  objetivos GovPdiObjetivo[]

  @@index([tenantId, pdiId])
}

model GovPdiObjetivo {
  id          String   @id @default(uuid())
  tenantId    String
  eixoId      String
  titulo      String
  descricao   String?
  peso        Float    @default(1)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eixo  GovPdiEixo   @relation(fields: [eixoId], references: [id], onDelete: Cascade)
  metas GovPdiMeta[]

  @@index([tenantId, eixoId])
}

model GovPdiMeta {
  id               String              @id @default(uuid())
  tenantId         String
  objetivoId       String
  titulo           String
  indicador        String
  unidade          String?
  sentido          GovSentidoIndicador @default(MAIOR_MELHOR)
  linhaBase        Float
  valorMeta        Float
  valorAtual       Float?
  periodicidade    GovPeriodicidade    @default(SEMESTRAL)
  responsavelId    String?             // userId
  prazo            DateTime?
  proximaColetaEm  DateTime?
  ultimaColetaEm   DateTime?
  peso             Float               @default(1)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  objetivo  GovPdiObjetivo  @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  medicoes  GovPdiMedicao[]
  acoes     GovPdiAcao[]

  @@index([tenantId, objetivoId])
  @@index([tenantId, proximaColetaEm])
}

model GovPdiMedicao {
  id             String   @id @default(uuid())
  tenantId       String
  metaId         String
  dataReferencia DateTime
  valor          Float
  observacao     String?
  registradoPorId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meta GovPdiMeta @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@index([tenantId, metaId, dataReferencia])
}

model GovPdiAcao {
  id            String        @id @default(uuid())
  tenantId      String
  metaId        String
  titulo        String
  descricao     String?
  responsavelId String?
  prazo         DateTime
  orcamento     Decimal       @default(0) @db.Decimal(12, 2)
  gasto         Decimal       @default(0) @db.Decimal(12, 2)
  percentual    Int           @default(0)
  status        GovStatusAcao @default(PLANEJADA)
  concluidaEm   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  meta GovPdiMeta @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@index([tenantId, metaId])
  @@index([tenantId, status, prazo])
}

// ================= DOCUMENTOS INSTITUCIONAIS / PPC =================
enum GovDocumentoTipo {
  REGIMENTO
  ESTATUTO
  PPI
  PPC
  POLITICA
  MANUAL
  OUTRO
}

enum GovVersaoStatus {
  RASCUNHO
  VIGENTE
  SUBSTITUIDA
  REVOGADA
}

model GovDocumento {
  id        String           @id @default(uuid())
  tenantId  String
  tipo      GovDocumentoTipo
  titulo    String
  codigo    String?
  programId String?          // PPC: curso (AcademicProgram)
  descricao String?
  ativo     Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  versoes GovDocumentoVersao[]

  @@index([tenantId, tipo])
  @@index([tenantId, programId])
}

model GovDocumentoVersao {
  id              String          @id @default(uuid())
  tenantId        String
  documentoId     String
  versao          Int
  conteudoHtml    String?
  resumoAlteracoes String?
  arquivoUrl      String?
  status          GovVersaoStatus @default(RASCUNHO)
  vigenciaInicio  DateTime?
  vigenciaFim     DateTime?
  aprovadoPorId   String?
  deliberacaoId   String?         // GovDeliberacao que aprovou
  criadoPorId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  documento GovDocumento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, versao])
  @@index([tenantId, status])
}

// ================= CPA =================
enum GovSegmento {
  DOCENTE
  DISCENTE
  TECNICO_ADMINISTRATIVO
  SOCIEDADE_CIVIL
}

enum GovCpaCicloStatus {
  PLANEJAMENTO
  COLETA
  ANALISE
  RELATORIO
  CONCLUIDO
}

enum GovCpaTipoPergunta {
  LIKERT5
  SIM_NAO
  TEXTO
}

model GovCpa {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  portaria  String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membros GovCpaMembro[]

  @@index([tenantId])
}

model GovCpaMembro {
  id            String      @id @default(uuid())
  tenantId      String
  cpaId         String
  nome          String
  segmento      GovSegmento
  userId        String?
  cargo         String?     // Coordenador, Secretário, Membro
  inicioMandato DateTime
  fimMandato    DateTime
  ativo         Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cpa GovCpa @relation(fields: [cpaId], references: [id], onDelete: Cascade)

  @@index([tenantId, cpaId])
  @@index([tenantId, fimMandato])
}

model GovCpaCiclo {
  id           String            @id @default(uuid())
  tenantId     String
  cpaId        String?
  titulo       String
  anoBase      Int
  inicio       DateTime
  fim          DateTime
  minRespostas Int               @default(5)
  status       GovCpaCicloStatus @default(PLANEJAMENTO)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  questionarios GovCpaQuestionario[]
  relatorios    GovCpaRelatorio[]
  planos        GovCpaPlanoAcao[]

  @@index([tenantId, status])
}

model GovCpaQuestionario {
  id        String      @id @default(uuid())
  tenantId  String
  cicloId   String
  titulo    String
  segmento  GovSegmento
  modeloKey String?
  ativo     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  ciclo     GovCpaCiclo    @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  perguntas GovCpaPergunta[]
  convites  GovCpaConvite[]
  respostas GovCpaResposta[]

  @@index([tenantId, cicloId])
}

model GovCpaModeloQuestionario {
  id        String      @id @default(uuid())
  tenantId  String
  chave     String
  titulo    String
  segmento  GovSegmento
  perguntas Json        // [{eixo,dimensao,texto,tipo}]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, chave])
}

model GovCpaPergunta {
  id             String             @id @default(uuid())
  tenantId       String
  questionarioId String
  eixo           Int                // 1..5 SINAES
  dimensao       Int?               // 1..10
  texto          String
  tipo           GovCpaTipoPergunta @default(LIKERT5)
  obrigatoria    Boolean            @default(true)
  ordem          Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  questionario GovCpaQuestionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)

  @@index([tenantId, questionarioId])
}

// Convite anônimo: guarda só o HASH do token. Nenhuma coluna liga o convite
// a uma pessoa nem a uma resposta.
model GovCpaConvite {
  id             String   @id @default(uuid())
  tenantId       String
  questionarioId String
