  clinic        Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId      String
  programId     String
  program       EduProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  version       String
  name          String
  isActive      Boolean    @default(true)
  effectiveFrom DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  subjects    EduCurriculumSubject[]
  enrollments EduEnrollment[]

  @@unique([programId, version])
  @@index([clinicId, isActive])
  @@index([tenantId])
  @@map("edu_curriculums")
}

model EduCurriculumSubject {
  id            String        @id @default(cuid())
  curriculumId  String
  curriculum    EduCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
