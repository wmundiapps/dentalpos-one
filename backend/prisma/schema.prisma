  subjectId   String?
  subject     EduSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  isActive    Boolean     @default(true)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cards EduFlashcard[]

  @@index([clinicId, subjectId, isActive])
  @@index([tenantId])
  @@map("edu_flashcard_decks")
}

model EduFlashcard {
  id     String           @id @default(cuid())
  deckId String
  deck   EduFlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front  String
  back   String
  order  Int              @default(0)

  reviews EduFlashcardReview[]

  @@index([deckId])
  @@map("edu_flashcards")
}

model EduFlashcardReview {
  id             String       @id @default(cuid())
  flashcardId    String
  flashcard      EduFlashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  studentId      String
  student        EduStudent   @relation(fields: [studentId], references: [id], onDelete: Cascade)
