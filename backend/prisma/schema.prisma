// ================= COLEGIADOS =================
enum GovOrgaoTipo {
  CONSUP
  CONSEPE
  COLEGIADO_CURSO
  CONGREGACAO
  OUTRO
}

enum GovReuniaoStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}

enum GovDeliberacaoStatus {
  PROPOSTA
  EM_VOTACAO
  APROVADA
  REJEITADA
  ARQUIVADA
}

enum GovVoto {
  FAVOR
  CONTRA
  ABSTENCAO
}

model GovOrgao {
  id             String       @id @default(uuid())
  tenantId       String
  tipo           GovOrgaoTipo
  nome           String
  sigla          String?
  programId      String?
  quorumPercent  Int          @default(50)   // mínimo de presentes (do total com voto) p/ instalar
  maioria        String       @default("SIMPLES") // SIMPLES (dos presentes) | ABSOLUTA (do total)
  ativo          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  membros  GovOrgaoMembro[]
  reunioes GovReuniao[]

