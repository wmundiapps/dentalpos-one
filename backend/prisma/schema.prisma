  status        String    @default("PENDENTE")
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  charge ReceivableCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId])
  @@index([chargeId])
  @@index([tenantId])
}

// Régua de cobrança: cada aviso enviado (ou tentado) ao paciente por lançamento em atraso. (financialEntryId, stage) é único: nunca repete.
model DunningNotice {
  id               String    @id @default(cuid())
  clinicId         String
  tenantId         String
  financialEntryId String
  patientId        String?
  stage            String
  channel          String
  message          String
  status           String    @default("PENDING")
  scheduledFor     DateTime
  sentAt           DateTime?
  errorMessage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([financialEntryId, stage, channel])
  @@index([clinicId, status, scheduledFor])
  @@index([clinicId, createdAt])
}

// ==== EDUMASTER:BEGIN (gerado por scripts/merge-edu-schema.js - edite prisma/edu/*.prisma) ====

// ---- edu/core.prisma ----
// ============================================================
// EDUMASTER PRO — NÚCLEO TRANSVERSAL (instituição/marca, espaços,
// lembretes e caixa de saída de notificações). Usado por todos os módulos.
// ============================================================

// Identidade institucional: nome, dados legais e CORES. As logomarcas ficam
// em EduBrandAsset (várias variações por instituição e por campus).
model EduInstitution {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  nome            String
  nomeFantasia    String?
  sigla           String?
  mantenedora     String?
  cnpj            String?
  codigoEmec      String?       // código da IES no e-MEC
  categoria       String?       // Universidade, Centro Universitário, Faculdade, Instituto Federal...
  organizacao     String?       // privada com fins lucrativos, comunitária, pública...
  email           String?
  telefone        String?
  site            String?
  endereco        String?
  cidade          String?
  uf              String?
  corPrimaria     String   @default("#0F5FDB")
  corSecundaria   String   @default("#0B1F3A")
  corDestaque     String   @default("#21C7A8")
  reitorNome      String?
  reitorCargo     String?  @default("Reitor(a)")
  lema            String?
  portariaCredenciamento String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum EduBrandAssetKind {
  LOGO_PRINCIPAL
  LOGO_HORIZONTAL
  LOGO_ESCURA
  LOGO_MONOCROMATICA
  BRASAO
  SELO_CERTIFICADO
  MARCA_DAGUA
  FAVICON
  ASSINATURA
  CABECALHO_DOCUMENTO
  RODAPE_DOCUMENTO
}

// Cada ativo de marca: logomarcas, brasão, selo, assinaturas (imagem em data URL
// ou URL pública). campusId nulo = marca da instituição inteira.
model EduBrandAsset {
  id          String   @id @default(uuid())
  tenantId    String
  campusId    String?
  kind        EduBrandAssetKind
  titulo      String?
  dataUrl     String?       // data:image/png;base64,... (até ~1,5 MB)
  url         String?       // alternativa: imagem hospedada
  mime        String?
  largura     Int?
  altura      Int?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, kind])
  @@index([tenantId, campusId])
}

enum EduSpaceType {
  SALA_AULA
  LABORATORIO
  AUDITORIO
  BIBLIOTECA
  CLINICA_ESCOLA
  QUADRA
  PATIO
  ESTACIONAMENTO
  SALA_REUNIAO
  SALA_PROFESSORES
  ADMINISTRATIVO
  POLO_EAD
  OUTRO
}

// Catálogo de espaços físicos (salas, laboratórios, auditórios...). Base do
// cronograma de alocação, da infraestrutura e do estacionamento.
model EduSpace {
  id           String   @id @default(uuid())
  tenantId     String
  campusId     String?
  codigo       String
  nome         String
  tipo         EduSpaceType
  bloco        String?
  andar        String?
  capacidade   Int      @default(0)
  areaM2       Float?
  recursos     Json?         // ["projetor","ar-condicionado","bancadas","autoclave"...]
  acessivel    Boolean  @default(true)
  ativo        Boolean  @default(true)
  observacoes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, codigo])
  @@index([tenantId, tipo])
  @@index([tenantId, campusId])
}

enum EduReminderStatus {
  PENDENTE
  NOTIFICADO
  CONCLUIDO
  CANCELADO
  ADIADO
}

enum EduSeverity {
  INFO
  ATENCAO
  CRITICO
}

// Lembrete/tarefa com prazo. Nenhum prazo "cai no esquecimento": todo módulo
// cria lembretes aqui e o cron (/api/cron/edu) dispara e escala os atrasados.
model EduReminder {
  id              String   @id @default(uuid())
  tenantId        String
  modulo          String        // admissoes, regulatorio, secretaria...
  refType         String?       // tipo do registro de origem (ex: "RegProcesso")
  refId           String?
  titulo          String
  descricao       String?
  dueAt           DateTime      // prazo
  remindAt        DateTime      // quando avisar (<= dueAt)
  severity        EduSeverity @default(INFO)
  status          EduReminderStatus @default(PENDENTE)
  assigneeUserId  String?
  assigneeRole    String?       // alternativa: avisar todo um papel (COORDINATOR...)
  assigneeStudentId String?
  canal           String   @default("IN_APP")
  recorrenciaDias Int?          // repete a cada N dias até concluir
  escalonadoEm    DateTime?
  concluidoEm     DateTime?
  concluidoPorId  String?
  dedupeKey       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, remindAt])
  @@index([tenantId, refType, refId])
  @@index([tenantId, assigneeUserId, status])
}

enum EduNotificationStatus {
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHA
  CANCELADA
}

// Caixa de saída única de comunicação (WhatsApp, e-mail, SMS, voz, Telegram,
// notificação no sistema). O módulo de comunicação despacha pelos canais.
model EduNotification {
  id              String   @id @default(uuid())
  tenantId        String
  canal           String        // IN_APP | EMAIL | WHATSAPP | SMS | VOZ | TELEGRAM
  userId          String?
  studentId       String?
  destino         String?       // telefone / e-mail / chat id
  assunto         String?
  mensagem        String
  templateKey     String?
  refType         String?
  refId           String?
  status          EduNotificationStatus @default(PENDENTE)
  tentativas      Int      @default(0)
  erro            String?
  agendadoPara    DateTime @default(now())
  enviadoEm       DateTime?
  lidaEm          DateTime?
  provedorId      String?
  createdAt       DateTime @default(now())

  @@index([tenantId, status, agendadoPara])
  @@index([tenantId, userId, status])
  @@index([tenantId, studentId])
}

// Trilha de auditoria transversal dos módulos EduMaster.
model EduAuditEvent {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  modulo      String
  acao        String
  refType     String?
  refId       String?
  detalhes    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, modulo, createdAt])
  @@index([tenantId, refType, refId])
}

// ---- edu/academico.prisma ----
// ============================================================
// EDUMASTER PRO — NÚCLEO ACADÊMICO
// Extensão do schema.prisma existente em wmundiapps/dentalpos-one/backend
// Pressupõe que já existam os models: Tenant (ou Institution), User, Role
// Ajuste os nomes de relação (@relation) para bater com seu schema atual.
// ============================================================

// ---------- INSTITUIÇÃO / CAMPUS ----------

model Campus {
  id            String   @id @default(uuid())
  tenantId      String
  nome          String
  endereco      String?
  cidade        String?
  uf            String?
  createdAt     DateTime @default(now())

  turmas        ClassSection[]

  @@index([tenantId])
}

// ---------- ESTRUTURA CURRICULAR ----------

model AcademicProgram {
  id              String   @id @default(uuid())
  tenantId        String
  nome            String        // ex: "Farmácia", "Odontologia"
  modalidade      Modalidade
  cargaHorariaTotal Int
  createdAt       DateTime @default(now())

  disciplinas     CurriculumDiscipline[]
  matriculas      Enrollment[]

  @@index([tenantId])
}

enum Modalidade {
  EAD
  PRESENCIAL
  SEMIPRESENCIAL
}

model Discipline {
  id              String   @id @default(uuid())
  tenantId        String
  nome            String
  cargaHoraria    Int
  ementa          String?

  curriculos      CurriculumDiscipline[]
  turmas          ClassSection[]
  conteudos       ContentItem[]
  avaliacoes      Assessment[]

  @@index([tenantId])
}

model CurriculumDiscipline {
  id                String   @id @default(uuid())
  programId         String
  disciplineId      String
  periodo           Int              // 1º, 2º... período do curso
  obrigatoria       Boolean  @default(true)

  program           AcademicProgram @relation(fields: [programId], references: [id])
  discipline        Discipline      @relation(fields: [disciplineId], references: [id])

  @@unique([programId, disciplineId])
}

// ---------- PERÍODO LETIVO ----------

model AcademicTerm {
  id            String   @id @default(uuid())
  tenantId      String
  codigo        String        // ex: "2026/2"
  dataInicio    DateTime
  dataFim       DateTime

  turmas        ClassSection[]
  matriculas    Enrollment[]

  @@index([tenantId])
}

// ---------- ALUNO E MATRÍCULA ----------

model Student {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String   @unique     // FK para o model User já existente (login)
  ra              String   @unique     // registro acadêmico
  nomeCompleto    String
  cpf             String?
  dataNascimento  DateTime?
  status          StudentStatus @default(ATIVO)
  createdAt       DateTime @default(now())

  matriculas      Enrollment[]
  frequencias     Attendance[]
  tentativas      AssessmentAttempt[]
  certificados    Certificate[]
  agendamentos    ClassSessionBooking[]

  @@index([tenantId])
}

enum StudentStatus {
  ATIVO
  TRANCADO
  CANCELADO
  DESISTENTE
  CONCLUIDO
  FORMADO
}

model Enrollment {
  id              String   @id @default(uuid())
  studentId       String
  programId       String
  termId          String
  status          EnrollmentStatus @default(ATIVA)
  dataMatricula   DateTime @default(now())

  student         Student         @relation(fields: [studentId], references: [id])
  program         AcademicProgram @relation(fields: [programId], references: [id])
  term            AcademicTerm    @relation(fields: [termId], references: [id])
  turmas          ClassSectionEnrollment[]

  @@index([studentId])
  @@index([programId])
}

enum EnrollmentStatus {
  ATIVA
  TRANCADA
  CANCELADA
  CONCLUIDA
}

// ---------- TURMA E ALOCAÇÃO DE AULAS ----------

model ClassSection {
  id              String   @id @default(uuid())
  tenantId        String
  campusId        String?
  disciplineId    String
  termId          String
  professorUserId String        // FK para User (professor)
  nome            String        // ex: "FARM2025 S4 M16"
  vagas           Int?
  createdAt       DateTime @default(now())

  campus          Campus?       @relation(fields: [campusId], references: [id])
  discipline      Discipline    @relation(fields: [disciplineId], references: [id])
  term            AcademicTerm  @relation(fields: [termId], references: [id])

  matriculados    ClassSectionEnrollment[]
  sessoes         ClassSession[]
  avaliacoes      Assessment[]

  @@index([tenantId])
}

model ClassSectionEnrollment {
  id              String   @id @default(uuid())
  enrollmentId    String
  classSectionId  String

  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id])
  classSection    ClassSection  @relation(fields: [classSectionId], references: [id])

  @@unique([enrollmentId, classSectionId])
}

// Uma "aula" concreta — o aluno agenda dia/horário, teórico ou prático
model ClassSession {
  id              String       @id @default(uuid())
  classSectionId  String
  tipo            SessionType
  titulo          String
  dataHoraInicio  DateTime
  dataHoraFim     DateTime
  local           String?          // sala física, laboratório, ou "online"
  vagasPratica    Int?             // limite de alunos por horário, quando prática
  status          SessionStatus @default(AGENDADA)

  classSection    ClassSection  @relation(fields: [classSectionId], references: [id])
  agendamentos    ClassSessionBooking[]
  frequencias     Attendance[]

  @@index([classSectionId])
  @@index([dataHoraInicio])
}

enum SessionType {
  TEORICA
  PRATICA
}

enum SessionStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}

// Aluno escolhe/confirma um horário de aula prática ou teórica
model ClassSessionBooking {
  id              String   @id @default(uuid())
  classSessionId  String
  studentId       String
  status          BookingStatus @default(CONFIRMADO)
  createdAt       DateTime @default(now())

  classSession    ClassSession  @relation(fields: [classSessionId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])

  @@unique([classSessionId, studentId])
}

enum BookingStatus {
  CONFIRMADO
  CANCELADO
  PRESENTE
  FALTOU
}

model Attendance {
  id              String   @id @default(uuid())
  classSessionId  String
  studentId       String
  presente        Boolean
  justificativa   String?
  registradoEm    DateTime @default(now())

  classSession    ClassSession  @relation(fields: [classSessionId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])

  @@unique([classSessionId, studentId])
}

// ---------- CONTEÚDO ----------

model ContentItem {
  id              String   @id @default(uuid())
  disciplineId    String
  tipo            ContentType
  titulo          String
  urlArquivo      String?       // PDF/vídeo hospedado
  resumoTexto     String?       // resumo de aula
  createdAt       DateTime @default(now())

  discipline      Discipline @relation(fields: [disciplineId], references: [id])
  flashcards      Flashcard[]

  @@index([disciplineId])
}

enum ContentType {
  PDF
  VIDEO
  RESUMO
  MATERIAL_COMPLEMENTAR
  BIBLIOTECA
}

model Flashcard {
  id              String   @id @default(uuid())
  contentItemId   String
  pergunta        String
  resposta        String
  // campos de repetição espaçada (SM-2), reaproveitando lógica do AllCollege
  intervalo        Int      @default(1)
  fatorFacilidade  Float    @default(2.5)
  proximaRevisao   DateTime @default(now())

  contentItem     ContentItem @relation(fields: [contentItemId], references: [id])
}

// ---------- AVALIAÇÃO / PROVAS COM IA ----------

model Assessment {
  id              String   @id @default(uuid())
  disciplineId    String
  classSectionId  String?
  titulo          String
  tipo            AssessmentType
  dataAbertura    DateTime?
  dataFechamento  DateTime?
  correcaoPorIA   Boolean  @default(false)
  focoEnade       Boolean  @default(false)

  discipline      Discipline    @relation(fields: [disciplineId], references: [id])
  classSection    ClassSection? @relation(fields: [classSectionId], references: [id])
  questoes        Question[]
  tentativas      AssessmentAttempt[]

  @@index([disciplineId])
}

enum AssessmentType {
  PROVA
  ATIVIDADE
  AUTOAVALIACAO
  SIMULADO_ENADE
  SIMULADO_RESIDENCIA
}

model Question {
  id              String   @id @default(uuid())
  assessmentId    String
  enunciado       String
  tipo            QuestionType
  alternativas    Json?         // para múltipla escolha
  respostaCorreta String?
  peso            Float    @default(1)

  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  respostas       AnswerSubmission[]
}

enum QuestionType {
  MULTIPLA_ESCOLHA
  DISSERTATIVA
  VERDADEIRO_FALSO
}

model AssessmentAttempt {
  id              String   @id @default(uuid())
  assessmentId    String
  studentId       String
  iniciadoEm      DateTime @default(now())
  finalizadoEm    DateTime?
  notaFinal       Float?
  corrigidoPorIA  Boolean  @default(false)

  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  student         Student    @relation(fields: [studentId], references: [id])
  respostas       AnswerSubmission[]

  @@index([studentId])
}

model AnswerSubmission {
  id              String   @id @default(uuid())
  attemptId       String
  questionId      String
  respostaTexto   String?
  notaObtida      Float?
  feedbackIA      String?       // justificativa gerada pela IA na correção dissertativa

  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id])
  question        Question          @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

// ---------- CERTIFICADOS ----------

model Certificate {
  id              String   @id @default(uuid())
  studentId       String
  tipo            CertificateType
  descricao       String
  emitidoEm       DateTime @default(now())
  urlPdf          String?

  student         Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

enum CertificateType {
  CONCLUSAO_CURSO
  NIVELAMENTO
  EXTENSAO
  PARTICIPACAO
}

// ---- edu/financeiro.prisma ----
// ============================================================
// EDUMASTER PRO — FINANCEIRO / CONTÁBIL / FISCAL
// Extensão de schema-academico.prisma no mesmo schema.prisma.
// Referencia Student (do Núcleo Acadêmico) via studentId.
// Reaproveita o gateway Asaas/Stripe que já existe no DentalPos One:
// os campos gatewayId/gatewayStatus abaixo são para plugar nesse
// gateway já implementado, não para reimplementá-lo.
// ============================================================

model EduCostCenter {
  id          String   @id @default(uuid())
  tenantId    String
  nome        String        // ex: "Coordenação de Farmácia", "Manutenção"
  descricao   String?

  contasPagar AccountPayable[]

  @@index([tenantId])
}

model ChartOfAccount {
  id            String   @id @default(uuid())
  tenantId      String
  codigo        String        // ex: "1.1.1", "3.1.1", "4.1.1"
  nome          String        // ex: "Caixa", "Receita de Mensalidades"
  tipo          AccountType

  lancamentosDebito   AccountingEntry[] @relation("Debito")
  lancamentosCredito  AccountingEntry[] @relation("Credito")

  @@unique([tenantId, codigo])
}

enum AccountType {
  ATIVO
  PASSIVO
  PATRIMONIO_LIQUIDO
  RECEITA
  DESPESA
}

model AccountPayable {
  id              String   @id @default(uuid())
  tenantId        String
  costCenterId    String?
  descricao       String
  fornecedor      String?
  categoria       String?       // ex: "aluguel", "folha", "manutenção"
  valor           Float
  dataVencimento  DateTime
  dataPagamento   DateTime?
  status          FinancialStatus @default(PENDENTE)
  createdAt       DateTime @default(now())

  costCenter      EduCostCenter? @relation(fields: [costCenterId], references: [id])
  transacoes      PaymentTransaction[]

  @@index([tenantId, status])
}

model AccountReceivable {
  id              String   @id @default(uuid())
  tenantId        String
  studentId       String        // referencia Student do Núcleo Acadêmico
  enrollmentId    String?       // referencia Enrollment do Núcleo Acadêmico
  descricao       String        // ex: "Mensalidade 05/12 — Farmácia"
  numeroParcela   Int?
  valor           Float
  dataVencimento  DateTime
  dataPagamento   DateTime?
  status          FinancialStatus @default(PENDENTE)
  gatewayId       String?       // id da cobrança no Asaas/Stripe já existente
  gatewayStatus   String?
  createdAt       DateTime @default(now())

  transacoes      PaymentTransaction[]
  notasFiscais    FiscalInvoice[]

  @@index([tenantId, status])
  @@index([studentId])
}

enum FinancialStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model PaymentTransaction {
  id                    String   @id @default(uuid())
  tenantId              String
  tipo                  TransactionType
  valor                 Float
  dataTransacao         DateTime @default(now())
  formaPagamento        FormaPagamento
  accountPayableId      String?
  accountReceivableId   String?

  accountPayable        AccountPayable?    @relation(fields: [accountPayableId], references: [id])
  accountReceivable     AccountReceivable? @relation(fields: [accountReceivableId], references: [id])
  lancamentoContabil    AccountingEntry?

  @@index([tenantId])
}

enum TransactionType {
  RECEITA
  DESPESA
}

enum FormaPagamento {
  PIX
  BOLETO
  CARTAO
  DINHEIRO
  TRANSFERENCIA
}

model AccountingEntry {
  id                    String   @id @default(uuid())
  tenantId              String
  data                  DateTime @default(now())
  contaDebitoId         String
  contaCreditoId        String
  valor                 Float
  historico             String
  paymentTransactionId  String?  @unique

  contaDebito           ChartOfAccount     @relation("Debito", fields: [contaDebitoId], references: [id])
  contaCredito          ChartOfAccount     @relation("Credito", fields: [contaCreditoId], references: [id])
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@index([tenantId, data])
}

model FiscalInvoice {
  id                    String   @id @default(uuid())
  tenantId              String
  accountReceivableId   String?
  tipo                  FiscalInvoiceType
  numero                String?
  valor                 Float
  status                FiscalInvoiceStatus @default(PENDENTE)
  urlPdf                String?
  urlXml                String?
  emitidoEm             DateTime?
  createdAt             DateTime @default(now())

  accountReceivable     AccountReceivable? @relation(fields: [accountReceivableId], references: [id])

  @@index([tenantId, status])
}

enum FiscalInvoiceType {
  NFSE
  NFE
  RECIBO
}

enum FiscalInvoiceStatus {
  PENDENTE
  EMITIDA
  CANCELADA
  ERRO
}

// ---- edu/conteudo.prisma ----
// ============================================================
// EDUMASTER PRO — CONTEÚDO + BIBLIOTECA
// Extensão do schema.prisma (depois de schema-academico.prisma
// e schema-financeiro.prisma). Usa ContentItem e Flashcard que já
// existem no schema-academico.prisma.
//
// CORREÇÃO IMPORTANTE em relação ao módulo anterior:
// os campos intervalo/fatorFacilidade/proximaRevisao que ficaram
// no model Flashcard (schema-academico.prisma) guardam progresso
// GLOBAL do cartão, o que está errado — cada aluno revisa no seu
// próprio ritmo. A partir daqui, IGNORE esses 3 campos em Flashcard
// (deixe como estavam, sem uso) e use StudentFlashcardState abaixo,
// que é por aluno. Se quiser, remova os 3 campos de Flashcard numa
// migração futura; não é urgente, eles só ficam sem uso.
// ============================================================

model StudentFlashcardState {
  id              String   @id @default(uuid())
  studentId       String
  flashcardId     String
  intervalo       Int      @default(1)
  fatorFacilidade Float    @default(2.5)
  repeticoes      Int      @default(0)
  proximaRevisao  DateTime @default(now())
  ultimaRevisao   DateTime?

  @@unique([studentId, flashcardId])
  @@index([studentId, proximaRevisao])
}

model ContentProgress {
  id                    String   @id @default(uuid())
  studentId             String
  contentItemId         String
  concluido             Boolean  @default(false)
  percentualAssistido   Float    @default(0)   // 0 a 100, relevante para vídeo
  ultimaVisualizacao    DateTime @default(now())

  @@unique([studentId, contentItemId])
}

model LibraryProvider {
  id            String   @id @default(uuid())
  tenantId      String
  nome          String        // ex: "Minha Biblioteca", "Pearson", "Biblioteca própria"
  tipoAcesso    LibraryAccessType
  urlAcesso     String?
  custoMensal   Float?        // preenchido quando tipoAcesso = ADESAO_INDIVIDUAL
  ativo         Boolean  @default(true)

  assinaturas   StudentLibraryAccess[]

  @@index([tenantId])
}

enum LibraryAccessType {
  ASSINATURA_INSTITUCIONAL   // toda a instituição já paga; aluno tem acesso automático
  ADESAO_INDIVIDUAL          // aluno opta por aderir, pode gerar cobrança
}

model StudentLibraryAccess {
  id                  String   @id @default(uuid())
  studentId           String
  libraryProviderId   String
  status              LibraryAccessStatus @default(PENDENTE)
  dataAdesao          DateTime @default(now())
  dataCancelamento    DateTime?

  libraryProvider     LibraryProvider @relation(fields: [libraryProviderId], references: [id])

  @@unique([studentId, libraryProviderId])
}

enum LibraryAccessStatus {
  ATIVA
  PENDENTE
  CANCELADA
}

// ---- edu/provas-ia.prisma ----
// ============================================================
// EDUMASTER PRO — PROVAS COM CORREÇÃO POR IA
// Extensão do schema.prisma (depois de academico, financeiro, conteudo).
// Usa Assessment, Question, AssessmentAttempt, AnswerSubmission que já
// existem em schema-academico.prisma — aqui só adicionamos o que faltava
// para a correção por IA funcionar de verdade: rubrica de correção e
// log de geração de questões por IA a partir do conteúdo.
// ============================================================

model GradingRubric {
  id              String   @id @default(uuid())
  questionId      String   @unique   // 1 rubrica por questão dissertativa
  criterios       String        // texto livre: o que a IA deve considerar pontos/erros
  notaMaxima      Float    @default(10)

  @@index([questionId])
}

model AIGenerationLog {
  id              String   @id @default(uuid())
  tenantId        String
  contentItemId   String?       // conteúdo usado como base, quando aplicável
  assessmentId    String?
  prompt          String
  respostaBruta   String        // resposta crua da IA, para auditoria
  criadoEm        DateTime @default(now())
  criadoPorUserId String

  @@index([tenantId])
}

// ---- edu/admissoes.prisma ----
// ============================================================
// EDUMASTER PRO — ADMISSÕES (prefixo Adm): captação, vestibular,
// matrícula e rematrícula.
// ============================================================

enum AdmTipoProcesso {
  VESTIBULAR_TRADICIONAL
  VESTIBULAR_AGENDADO
  ENEM
  TRANSFERENCIA_EXTERNA
  PORTADOR_DIPLOMA
  POS_LATO_SENSU
  POS_STRICTO_SENSU
}

enum AdmStatusProcesso {
  RASCUNHO
  ABERTO
  ENCERRADO
  CLASSIFICADO
  EM_CONVOCACAO
  FINALIZADO
  CANCELADO
}

enum AdmModalidadeOferta {
  PRESENCIAL
  SEMIPRESENCIAL
  EAD
}

enum AdmTurno {
  MATUTINO
  VESPERTINO
  NOTURNO
  INTEGRAL
  FLEXIVEL
}

enum AdmStatusCandidato {
  LEAD
  INSCRITO
  PROVA
  APROVADO
  CONVOCADO
  MATRICULADO
  DESISTENTE
  REPROVADO
}

enum AdmTipoInteracao {
  LIGACAO
  WHATSAPP
  EMAIL
  VISITA
  NOTA
  SISTEMA
}

enum AdmComponenteNota {
  PROVA
  REDACAO
  ENEM
  ENTREVISTA
  HISTORICO
  ANALISE_CURRICULAR
  PROJETO
}

enum AdmStatusChamada {
  ABERTA
  ENCERRADA
}

enum AdmStatusConvocacao {
  CONVOCADO
  MATRICULADO
  RENUNCIOU
  EXPIRADO
}

enum AdmStatusDocumento {
  PENDENTE
  ENVIADO
  APROVADO
  REJEITADO
}

enum AdmStatusMatricula {
  PENDENTE_DOCUMENTOS
  DOCUMENTOS_OK
  CONCLUIDA
  CANCELADA
}

enum AdmTipoBeneficio {
  BOLSA
  DESCONTO
  CONVENIO
}

enum AdmStatusCampanha {
  PLANEJADA
  ATIVA
  PAUSADA
  ENCERRADA
}

enum AdmStatusRematriculaCampanha {
  RASCUNHO
  ABERTA
  ENCERRADA
}

enum AdmStatusRematricula {
  ELEGIVEL
  PENDENTE_FINANCEIRO
  PENDENTE_ACADEMICO
  CONFIRMADA
  NAO_RENOVOU
  TRANCADA
}

// ---------- Processo seletivo e ofertas ----------

model AdmProcessoSeletivo {
  id               String   @id @default(uuid())
  tenantId         String
  codigo           String
  nome             String
  tipo             AdmTipoProcesso
  nivel            String   @default("GRADUACAO")   // GRADUACAO | POS_LATO | POS_STRICTO
  status           AdmStatusProcesso @default(RASCUNHO)
  termId           String?                           // AcademicTerm de ingresso
  edital           String?
  editalUrl        String?
  inscricaoInicio  DateTime
  inscricaoFim     DateTime
  provaData        DateTime?
  resultadoData    DateTime?
  matriculaInicio  DateTime?
  matriculaFim     DateTime?
  taxaInscricao    Float    @default(0)
  notaMinima       Float    @default(0)
  pesos            Json?                             // {"PROVA":3,"REDACAO":2,...}
  criteriosDesempate Json?                           // ["REDACAO","PROVA","IDADE"]
  listaEspera      Boolean  @default(true)
  diasPrazoMatricula Int    @default(5)
  observacoes      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ofertas          AdmOferta[]
  candidatos       AdmCandidato[]
  chamadas         AdmChamada[]

  @@unique([tenantId, codigo])
  @@index([tenantId, status])
}

model AdmOferta {
  id               String   @id @default(uuid())
  tenantId         String
  processoId       String
  programId        String?                           // AcademicProgram
  nomeCurso        String
  turno            AdmTurno @default(NOTURNO)
  modalidade       AdmModalidadeOferta @default(PRESENCIAL)
  campusId         String?
  poloNome         String?
  vagas            Int
  valorMensalidade Float    @default(0)
  parcelas         Int      @default(6)
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  processo         AdmProcessoSeletivo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@index([tenantId, processoId])
}

// ---------- Captação / marketing ----------

model AdmCampanha {
  id               String   @id @default(uuid())
  tenantId         String
  nome             String
  nivel            String   @default("GRADUACAO")
  canal            String                            // GOOGLE_ADS, META_ADS, INDICACAO, EVENTO, ORGANICO...
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  processoId       String?
  status           AdmStatusCampanha @default(PLANEJADA)
  orcamento        Float    @default(0)
  metaInscritos    Int      @default(0)
  metaMatriculas   Int      @default(0)
  inicio           DateTime
  fim              DateTime
  observacoes      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  gastos           AdmCampanhaGasto[]
  candidatos       AdmCandidato[]

  @@index([tenantId, status])
  @@index([tenantId, utmCampaign])
}

model AdmCampanhaGasto {
  id          String   @id @default(uuid())
  tenantId    String
  campanhaId  String
  data        DateTime @default(now())
  valor       Float
  descricao   String?
  createdAt   DateTime @default(now())

  campanha    AdmCampanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@index([tenantId, campanhaId])
}

// ---------- Candidatos / funil ----------

model AdmCandidato {
  id                String   @id @default(uuid())
  tenantId          String
  processoId        String?
  ofertaId          String?
  ofertaId2         String?                          // segunda opção
  campanhaId        String?
  protocolo         String
  nome              String
  cpf               String?
  email             String?
  telefone          String?
  dataNascimento    DateTime?
  status            AdmStatusCandidato @default(LEAD)
  etapaMaxima       Int      @default(0)             // maior etapa do funil já atingida (0=LEAD..5=MATRICULADO)
  origem            String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  consentimentoLgpd Boolean  @default(false)
  consentimentoEm   DateTime?
  consentimentoMarketing   Boolean  @default(false)   // aceite SEPARADO e opcional para receber divulgação (LGPD)
  consentimentoMarketingEm DateTime?
  ipOrigem          String?
  dados             Json?                            // endereço, escolaridade, cota etc.
  cota              String?
  responsavelId     String?                          // User (consultor)
  proximoContatoEm  DateTime?
  notaFinal         Float?
  classificacao     Int?
  ofertaAlocadaId   String?                          // oferta em que foi classificado
  situacaoClassificacao String?                      // CLASSIFICADO | LISTA_ESPERA | DESCLASSIFICADO
  taxaReceivableId  String?                          // AccountReceivable da taxa
  taxaPaga          Boolean  @default(false)
  bolsaId           String?
  motivoDesistencia String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  processo          AdmProcessoSeletivo? @relation(fields: [processoId], references: [id])
  campanha          AdmCampanha? @relation(fields: [campanhaId], references: [id])
  interacoes        AdmInteracao[]
  notas             AdmResultadoProva[]
  documentos        AdmDocumentoCandidato[]
  convocacoes       AdmConvocacao[]
  matricula         AdmMatricula?

  @@unique([tenantId, protocolo])
  @@index([tenantId, status])
  @@index([tenantId, processoId, status])
  @@index([tenantId, cpf])
  @@index([tenantId, proximoContatoEm])
}

model AdmInteracao {
  id            String   @id @default(uuid())
  tenantId      String
  candidatoId   String
  tipo          AdmTipoInteracao @default(NOTA)
  descricao     String
  userId        String?
  proximoContatoEm DateTime?
  createdAt     DateTime @default(now())

  candidato     AdmCandidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidatoId])
}

model AdmResultadoProva {
  id            String   @id @default(uuid())
  tenantId      String
  candidatoId   String
  componente    AdmComponenteNota
  nota          Float
  notaMaxima    Float    @default(100)
  observacao    String?
  lancadoPorId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidato     AdmCandidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@unique([candidatoId, componente])
  @@index([tenantId, candidatoId])
}

// ---------- Convocação ----------

model AdmChamada {
  id            String   @id @default(uuid())
  tenantId      String
  processoId    String
  numero        Int
  status        AdmStatusChamada @default(ABERTA)
  prazoMatricula DateTime
  geradaPorId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  processo      AdmProcessoSeletivo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  convocacoes   AdmConvocacao[]

  @@unique([processoId, numero])
  @@index([tenantId, processoId])
}

model AdmConvocacao {
  id            String   @id @default(uuid())
  tenantId      String
  chamadaId     String
  candidatoId   String
  ofertaId      String
  status        AdmStatusConvocacao @default(CONVOCADO)
  prazo         DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chamada       AdmChamada @relation(fields: [chamadaId], references: [id], onDelete: Cascade)
  candidato     AdmCandidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([tenantId, chamadaId])
  @@index([tenantId, candidatoId])
}

// ---------- Documentos e matrícula ----------

model AdmDocumentoTipo {
  id            String   @id @default(uuid())
  tenantId      String
  codigo        String
  nome          String
  obrigatorio   Boolean  @default(true)
  niveis        String[]                             // GRADUACAO, POS_LATO, POS_STRICTO
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, codigo])
}

model AdmDocumentoCandidato {
  id            String   @id @default(uuid())
  tenantId      String
  candidatoId   String
  codigo        String
  nome          String
  obrigatorio   Boolean  @default(true)
  status        AdmStatusDocumento @default(PENDENTE)
  url           String?
  observacao    String?
  revisadoPorId String?
  revisadoEm    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidato     AdmCandidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@unique([candidatoId, codigo])
  @@index([tenantId, candidatoId])
}

model AdmMatricula {
  id                    String   @id @default(uuid())
  tenantId              String
  candidatoId           String   @unique
  convocacaoId          String?
  ofertaId              String
  userId                String?
  studentId             String?
  enrollmentId          String?
  ra                    String?
  status                AdmStatusMatricula @default(PENDENTE_DOCUMENTOS)
  bolsaId               String?
  percentualDesconto    Float    @default(0)
  valorMensalidade      Float    @default(0)
  valorComDesconto      Float    @default(0)
  parcelas              Int      @default(6)
  contratoHtml          String?
  contratoAceitoEm      DateTime?
  primeiraMensalidadeId String?
  concluidaEm           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  candidato             AdmCandidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// ---------- Bolsas, descontos e convênios ----------

model AdmBolsa {
  id            String   @id @default(uuid())
  tenantId      String
  nome          String
  tipo          AdmTipoBeneficio @default(BOLSA)
  percentual    Float    @default(0)
  valorFixo     Float?
  regras        Json?                                // {notaMinima, cotas[], niveis[], programIds[], tiposProcesso[], convenioEmpresa}
  convenioEmpresa String?
  vigenciaInicio DateTime?
  vigenciaFim   DateTime?
  limiteConcessoes Int?
  cumulativa    Boolean  @default(false)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  concessoes    AdmBolsaConcessao[]

  @@index([tenantId, ativo])
}

model AdmBolsaConcessao {
  id            String   @id @default(uuid())
  tenantId      String
  bolsaId       String
  candidatoId   String?
  studentId     String?
  percentualAplicado Float
  motivo        String?
  concedidaPorId String?
  createdAt     DateTime @default(now())

  bolsa         AdmBolsa @relation(fields: [bolsaId], references: [id], onDelete: Cascade)

  @@index([tenantId, bolsaId])
  @@index([tenantId, candidatoId])
}

// ---------- Rematrícula ----------

model AdmRematriculaCampanha {
  id                  String   @id @default(uuid())
  tenantId            String
  nome                String
  termOrigemId        String?
  termDestinoId       String
  janelaInicio        DateTime
  janelaFim           DateTime
  descontoAntecipacaoPct Float @default(0)
  dataLimiteDesconto  DateTime?
  valorTaxa           Float    @default(0)
  bloqueiaInadimplente Boolean @default(true)
  status              AdmStatusRematriculaCampanha @default(RASCUNHO)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  itens               AdmRematricula[]

  @@index([tenantId, status])
}

model AdmRematricula {
  id            String   @id @default(uuid())
  tenantId      String
  campanhaId    String
  studentId     String
  programId     String?
  status        AdmStatusRematricula @default(ELEGIVEL)
  pendencias    Json?
  valorBase     Float    @default(0)
  desconto      Float    @default(0)
  valorFinal    Float    @default(0)
  receivableId  String?
  confirmadaEm  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campanha      AdmRematriculaCampanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, studentId])
  @@index([tenantId, campanhaId, status])
}

// ---- edu/apoio.prisma ----
// ============================================================
// EDUMASTER PRO — APOIO (discente, docente, ouvidoria, egressos)
// Prefixo Apo. Referências a outros módulos = String ids sem @relation.
// ============================================================

// ---------- infraestrutura comum ----------

model ApoContador {
  id        String   @id @default(uuid())
  tenantId  String
  chave     String
  valor     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chave])
}

// Linha do tempo genérica (andamentos, respostas, comentários) de qualquer registro do módulo.
model ApoAndamento {
  id          String   @id @default(uuid())
  tenantId    String
  refType     String        // ApoManifestacao, ApoOcorrencia, ApoChamado, ApoPlanoAcao...
  refId       String
  tipo        String        // NOTA, RESPOSTA, STATUS, ENCAMINHAMENTO, ESCALONAMENTO, DEFESA, DECISAO...
  texto       String
  publico     Boolean  @default(false)   // visível a quem acompanha (ouvidoria pública/solicitante)
  userId      String?
  dados       Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, refType, refId])
}

// ---------- apoio discente: atendimentos ----------

enum ApoTipoAtendimento {
  PSICOPEDAGOGICO
  PSICOLOGICO
  SOCIAL
  SAUDE
  ACESSIBILIDADE
  ORIENTACAO_ACADEMICA
  OUTRO
}

enum ApoSigilo {
  NORMAL        // equipe de apoio e coordenação veem o relato
  RESTRITO      // somente equipe de apoio
  SIGILOSO      // somente o profissional que atendeu (e a administração)
}

enum ApoStatusAtendimento {
  AGENDADO
  REALIZADO
  FALTOU
  CANCELADO
}

model ApoAtendimento {
  id             String   @id @default(uuid())
  tenantId       String
  studentId      String
  tipo           ApoTipoAtendimento
  sigilo         ApoSigilo @default(RESTRITO)
  status         ApoStatusAtendimento @default(AGENDADO)
  dataHora       DateTime
  duracaoMin     Int      @default(50)
  profissionalId String          // User que atende
  origem         String   @default("PROCURA_ESPONTANEA")  // PROCURA_ESPONTANEA, ENCAMINHAMENTO_PROFESSOR, BUSCA_ATIVA, RISCO_EVASAO
  motivo         String?
  relato         String?         // sob sigilo conforme `sigilo`
  encaminhamentos String?
  retornoEm      DateTime?
  planoAcaoId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, profissionalId, dataHora])
  @@index([tenantId, status, dataHora])
}

// ---------- AEE / NAPNE ----------

enum ApoStatusPlanoAee {
  RASCUNHO
  VIGENTE
  VENCIDO
  ENCERRADO
}

model ApoPlanoAee {
  id               String   @id @default(uuid())
  tenantId         String
  studentId        String
  necessidade      String          // ex.: Deficiência visual, TEA, TDAH, Dislexia, Surdez...
  categoria        String   @default("DEFICIENCIA")  // DEFICIENCIA, TEA, ALTAS_HABILIDADES, TRANSTORNO_APRENDIZAGEM, OUTRO
  laudoReferencia  String?         // referência ao laudo (sigiloso; sem CID em claro nas listagens)
  vigenciaInicio   DateTime
  vigenciaFim      DateTime
  status           ApoStatusPlanoAee @default(RASCUNHO)
  responsavelId    String?
  recursos         Json?           // tecnologias assistivas, intérprete, ledor, ...
  observacoes      String?
  encerradoMotivo  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  adaptacoes       ApoAdaptacao[]

  @@index([tenantId, studentId])
  @@index([tenantId, status, vigenciaFim])
}

model ApoAdaptacao {
  id               String   @id @default(uuid())
  tenantId         String
  planoId          String
  disciplineId     String?
  classSectionId   String?
  professorUserId  String?
  tipo             String          // TEMPO_ADICIONAL, MATERIAL_AMPLIADO, INTERPRETE_LIBRAS, LEDOR, SALA_SEPARADA, PROVA_ADAPTADA, PAUSAS, TECNOLOGIA_ASSISTIVA, OUTRO
  descricao        String
  tempoExtraPercent Int?
  notificadoEm     DateTime?
  cienteEm         DateTime?       // ciência do professor
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plano            ApoPlanoAee @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@index([tenantId, planoId])
  @@index([tenantId, professorUserId])
}

// ---------- bolsas e assistência estudantil ----------

model ApoProgramaBolsa {
  id                  String   @id @default(uuid())
  tenantId            String
  nome                String
  tipo                String   @default("INSTITUCIONAL")   // INSTITUCIONAL, PROUNI, FIES, MERITO, SOCIOECONOMICA, MONITORIA, ESPORTE, CULTURA, PERMANENCIA, OUTRO
  descricao           String?
  percentualDesconto  Float    @default(0)         // 0-100
  valorMensal         Float?                      // auxílio (alimentação/transporte), alternativa ao %
  vagas               Int      @default(0)
  rendaPerCapitaMaxSM Float?                      // em salários mínimos (ex.: 1.5)
  mediaMinima         Float?
  frequenciaMinima    Float?                      // %
  inscricaoInicio     DateTime?
  inscricaoFim        DateTime?
  vigenciaMeses       Int      @default(6)
  renovavel           Boolean  @default(true)
  renovacaoAntecedenciaDias Int @default(30)
  maxRenovacoes       Int?
  criterios           Json?                       // pesos/documentos exigidos
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId, ativo])
}

enum ApoStatusInscricaoBolsa {
  INSCRITA
  EM_ANALISE
  DEFERIDA
  LISTA_ESPERA
  INDEFERIDA
  CANCELADA
}

model ApoInscricaoBolsa {
  id              String   @id @default(uuid())
  tenantId        String
  programaId      String
  studentId       String
  rendaFamiliar   Float
  numeroMembros   Int
  rendaPerCapita  Float
  condicoes       Json?          // { moraSozinho, beneficiarioCadUnico, escolaPublica, deficiencia, ...}
  documentos      Json?
  mediaAtual      Float?
  frequenciaAtual Float?
  pontuacao       Float    @default(0)
  elegivel        Boolean  @default(true)
  pendencias      Json?
  status          ApoStatusInscricaoBolsa @default(INSCRITA)
  parecer         String?
  analisadoPorId  String?
  analisadoEm     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, programaId, studentId])
  @@index([tenantId, programaId, status])
  @@index([tenantId, studentId])
}

enum ApoStatusConcessao {
  ATIVA
  RENOVACAO_PENDENTE
  SUSPENSA
  ENCERRADA
  CANCELADA
}

model ApoConcessaoBolsa {
  id               String   @id @default(uuid())
  tenantId         String
  programaId       String
  studentId        String
  inscricaoId      String?
  percentual       Float    @default(0)
  valorMensal      Float?
  inicio           DateTime
  fim              DateTime
  status           ApoStatusConcessao @default(ATIVA)
  renovacoes       Int      @default(0)
  renovacaoLimiteEm DateTime?
