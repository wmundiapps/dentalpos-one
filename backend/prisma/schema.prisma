  sessionBookings            EduSessionBooking[]
  attendances                EduAttendance[]
  examAttempts               EduExamAttempt[]
  contentProgress            EduContentProgress[]
  flashcardReviews           EduFlashcardReview[]
  librarySubscriptions       EduLibrarySubscription[]
  reinforcementPlans         EduReinforcementPlan[]
  documentUploads            EduDocumentUpload[]
  documentRequests           EduDocumentRequest[]
  certificates               EduCertificate[]
  researchProjectMemberships EduResearchProjectMember[]
  legalCases                 EduLegalCase[]
  formSubmissions            EduFormSubmission[]
  parkingSpots               EduParkingSpot[]
  sales                      EduSale[]
  equivalencyRequests        EduEquivalencyRequest[]

  @@unique([clinicId, email])
  @@index([clinicId, status])
  @@index([tenantId])
