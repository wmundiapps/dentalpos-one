// ---- edu/jornadas.prisma ----
// ============================================================
// EDUMASTER PRO — JORNADAS (fluxogramas por persona + motor de lembretes)
// Prefixo: Jor
// ============================================================

enum JorPersona {
  CANDIDATO
  ALUNO
  EGRESSO
  PROFESSOR
  COORDENADOR
  FUNCIONARIO
  DIRETORIA
  REITORIA
}

enum JorTemplateStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum JorNoTipo {
  INICIO
  TAREFA
  APROVACAO
  ESPERA_EVENTO
  GATEWAY
  MARCO
  FIM
}

enum JorInstanciaStatus {
  ATIVA
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum JorEtapaStatus {
  ABERTA
  AGUARDANDO_EVENTO
  ATRASADA
  CONCLUIDA
  PULADA
  CANCELADA
}

// Modelo de jornada (grafo versionado). chave+versao únicos por tenant.
model JorTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  chave       String
  versao      Int      @default(1)
  nome        String
  persona     JorPersona
  descricao   String?
  status      JorTemplateStatus @default(RASCUNHO)
  padrao      Boolean  @default(false)      // veio do bootstrap
  publicadoEm DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nos         JorNo[]
  transicoes  JorTransicao[]
  instancias  JorInstancia[]

  @@unique([tenantId, chave, versao])
  @@index([tenantId, persona, status])
}

// Nó do grafo: etapa/tarefa, aprovação, espera por evento, gateway, marco...
model JorNo {
  id            String   @id @default(uuid())
  tenantId      String
  templateId    String
  template      JorTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  chave         String
  titulo        String
  descricao     String?
  tipo          JorNoTipo @default(TAREFA)
  papel         String?              // role responsável (raia): COORDINATOR, SECRETARY...
  slaDias       Int?
  checklist     Json?                // [{chave,titulo,obrigatorio}]
  documentos    Json?                // [{chave,titulo,obrigatorio}]
  modulo        String?              // módulo EduMaster de destino (admissoes, secretaria...)
  rota          String?              // rota do frontend para abrir a tela certa
  evento        String?              // ESPERA_EVENTO: chave do evento aguardado
  lembrete      Json?                // {antecedenciaDias, recorrenciaDias, escalarPara, escalarAposDias, severity}
  ordem         Int      @default(0)
  fase          String?              // agrupamento visual (ex.: "Ingresso")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([templateId, chave])
  @@index([tenantId, templateId])
}

// Aresta com condição simples avaliada sobre o contexto da instância.
model JorTransicao {
  id          String   @id @default(uuid())
  tenantId    String
  templateId  String
  template    JorTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  deChave     String
  paraChave   String
  rotulo      String?
  condicao    Json?                  // {campo,op,valor} | {and:[...]} | {or:[...]}
  prioridade  Int      @default(0)   // menor avalia primeiro (gateways)
  createdAt   DateTime @default(now())

  @@index([tenantId, templateId])
  @@index([templateId, deChave])
}

// Jornada de uma pessoa (tipo+id: aluno, candidato, professor, user...).
model JorInstancia {
  id             String   @id @default(uuid())
  tenantId       String
  templateId     String
  template       JorTemplate @relation(fields: [templateId], references: [id])
  templateChave  String
  templateVersao Int
  personType     String
  personId       String
  personNome     String?
  status         JorInstanciaStatus @default(ATIVA)
  contexto       Json?
  iniciadaPorId  String?
  iniciadaEm     DateTime @default(now())
  concluidaEm    DateTime?
  canceladaEm    DateTime?
  motivoCancelamento String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  etapas         JorEtapa[]
  historico      JorHistorico[]

  @@index([tenantId, status])
  @@index([tenantId, personType, personId])
  @@index([tenantId, templateId, status])
}

// Etapa concreta de uma instância (um nó visitado).
model JorEtapa {
  id              String   @id @default(uuid())
  tenantId        String
  instanciaId     String
  instancia       JorInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  noChave         String
  titulo          String
  tipo            JorNoTipo
  papel           String?
  fase            String?
  modulo          String?
  rota            String?
  evento          String?
  status          JorEtapaStatus @default(ABERTA)
  ciclo           Int      @default(1)
  responsavelUserId String?
  checklistEstado Json?                // {chave: {feito,porId,em}}
  checklistDef    Json?
  documentosDef   Json?
  decisao         String?              // APROVADO | REJEITADO (aprovações)
  justificativa   String?
  observacao      String?
  iniciadaEm      DateTime @default(now())
  prazoEm         DateTime?
  concluidaEm     DateTime?
  concluidaPorId  String?
  diasAtraso      Int      @default(0)
  escalonadoNivel Int      @default(0)
  escalonadoEm    DateTime?
  lembreteConfig  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status, prazoEm])
  @@index([instanciaId, status])
  @@index([tenantId, papel, status])
  @@index([tenantId, noChave])
}

// Histórico completo (linha do tempo) da jornada.
model JorHistorico {
  id          String   @id @default(uuid())
  tenantId    String
  instanciaId String
  instancia   JorInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
  etapaId     String?
  acao        String               // INICIADA, ETAPA_ABERTA, ETAPA_CONCLUIDA, ATRASO, ESCALONADA, PULADA, CANCELADA...
  userId      String?
  detalhes    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, instanciaId, createdAt])
}

// ---- edu/modalidades.prisma ----
// ============================================================
// EDUMASTER PRO — MODALIDADES (presencial, semipresencial, EAD, híbrido,
// polos, tutoria, engajamento no AVA, práticas/estágios e pós-graduação).
// Prefixo Mod. Referências externas = String ids sem @relation.
// ============================================================

enum ModModalidade {
  PRESENCIAL
  SEMIPRESENCIAL
  EAD
  HIBRIDO
}

// Parâmetros de regra por tenant (1 linha por instituição).
model ModConfig {
  id                          String   @id @default(uuid())
  tenantId                    String   @unique
  maxPctEadPresencial         Float    @default(40)   // % máx. de carga online em curso presencial (Port. MEC 2.117/2019)
  minPctPresencialSemi        Float    @default(40)   // % mín. presencial em semipresencial
  maxPctEadSemi               Float    @default(60)
  minEncontrosPresenciaisEad  Int      @default(1)    // por disciplina/período
  minAvaliacoesPresenciaisEad Int      @default(1)
  alunosPorTutorEad           Int      @default(50)
  alunosPorTutorSemi          Int      @default(80)
  slaRespostaHoras            Int      @default(48)
  slaUrgenteHoras             Int      @default(12)
  diasInatividadeAtencao      Int      @default(7)
  diasInatividadeCritico      Int      @default(14)
  presencaMinimaLivePct       Float    @default(75)
  cargaMinimaLato             Int      @default(360)
  prazoMaxMesesMestrado       Int      @default(24)
  prazoMaxMesesDoutorado      Int      @default(48)
  prazoMaxMesesLato           Int      @default(24)
  maxOrientandosPorDocente    Int      @default(8)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// Histórico das verificações de conformidade de modalidade por curso.
model ModVerificacao {
  id             String   @id @default(uuid())
  tenantId       String
  programId      String
  modalidade     ModModalidade
  conforme       Boolean
  percentualEad  Float
  resultado      Json
  executadoPorId String?
  createdAt      DateTime @default(now())

  @@index([tenantId, programId])
}

// ---------- Ofertas por disciplina ----------

model ModOferta {
  id              String   @id @default(uuid())
  tenantId        String
  disciplineId    String
  programId       String?
  termId          String?
  classSectionId  String?
  modalidade      ModModalidade
  cargaPresencial Int      @default(0)
  cargaOnline     Int      @default(0)
  diasEncontro    Json?        // ["SEG","QUA"] ou datas
  minEncontros    Int      @default(0)
  avaliacoesPresenciais Int @default(0)
  poloId          String?
  ativo           Boolean  @default(true)
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  encontros       ModEncontro[]
  lives           ModAulaLive[]

  @@index([tenantId, programId])
  @@index([tenantId, classSectionId])
}

enum ModEncontroTipo {
  ENCONTRO_PRESENCIAL
  PROVA_PRESENCIAL
  AULA_PRATICA
  DEFESA_TCC
  OUTRO
}

enum ModEncontroStatus {
  AGENDADO
  REALIZADO
  CANCELADO
}

model ModEncontro {
  id              String   @id @default(uuid())
  tenantId        String
  ofertaId        String
  tipo            ModEncontroTipo
  titulo          String
  inicio          DateTime
  fim             DateTime
  poloId          String?
  spaceId         String?
  calendarEventId String?      // evento do módulo calendario
  classSessionId  String?
  obrigatorio     Boolean  @default(true)
  status          ModEncontroStatus @default(AGENDADO)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  oferta          ModOferta @relation(fields: [ofertaId], references: [id], onDelete: Cascade)

  @@index([tenantId, inicio])
  @@index([ofertaId])
}

enum ModLiveStatus {
  AGENDADA
  AO_VIVO
  ENCERRADA
  CANCELADA
}

model ModAulaLive {
  id              String   @id @default(uuid())
  tenantId        String
  ofertaId        String?
  classSectionId  String?
  titulo          String
  professorUserId String?
  plataforma      String   @default("OUTRA")   // MEET, ZOOM, TEAMS, JITSI, OUTRA
  sala            String?
  linkUrl         String?
  inicio          DateTime
  fim             DateTime
  gravacaoUrl     String?
  gravacaoDisponivelEm DateTime?
  presencaMinimaPct Float  @default(75)
  status          ModLiveStatus @default(AGENDADA)
  iniciadaEm      DateTime?
  encerradaEm     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  oferta          ModOferta? @relation(fields: [ofertaId], references: [id], onDelete: SetNull)
  eventos         ModLiveEvento[]
  presencas       ModLivePresenca[]

  @@index([tenantId, inicio])
}

model ModLiveEvento {
  id        String   @id @default(uuid())
  tenantId  String
  liveId    String
  studentId String
  tipo      String        // ENTRADA | SAIDA
  em        DateTime
  createdAt DateTime @default(now())

  live      ModAulaLive @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@index([liveId, studentId])
  @@index([tenantId])
}

model ModLivePresenca {
  id        String   @id @default(uuid())
  tenantId  String
  liveId    String
  studentId String
  minutos   Float    @default(0)
  percentual Float   @default(0)
  presente  Boolean  @default(false)
  manual    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  live      ModAulaLive @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@unique([liveId, studentId])
  @@index([tenantId])
