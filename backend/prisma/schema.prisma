}

model GovOrgaoMembro {
  id            String   @id @default(uuid())
  tenantId      String
  orgaoId       String
  nome          String
  userId        String?
  cargo         String   @default("MEMBRO")
  representacao String?
  temVoto       Boolean  @default(true)
  inicioMandato DateTime
  fimMandato    DateTime
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgao GovOrgao @relation(fields: [orgaoId], references: [id], onDelete: Cascade)

  @@index([tenantId, orgaoId])
  @@index([tenantId, fimMandato])
}

model GovReuniao {
  id             String           @id @default(uuid())
  tenantId       String
  orgaoId        String
  tipo           String           @default("ORDINARIA")
  data           DateTime
  local          String?
  status         GovReuniaoStatus @default(AGENDADA)
  presentes      Json?            // [membroId]
  quorumAtingido Boolean?
  ata            String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  orgao        GovOrgao          @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
  pautas       GovPauta[]
  deliberacoes GovDeliberacao[]

  @@index([tenantId, orgaoId, data])
}

model GovPauta {
  id         String   @id @default(uuid())
  tenantId   String
  reuniaoId  String
  ordem      Int      @default(0)
  titulo     String
  descricao  String?
  tipo       String   @default("DELIBERACAO") // INFORME | DELIBERACAO
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reuniao GovReuniao @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)

  @@index([tenantId, reuniaoId])
}

model GovPautaModelo {
  id        String   @id @default(uuid())
  tenantId  String
  chave     String
  titulo    String
  itens     Json     // [{titulo,tipo}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chave])
}

model GovDeliberacao {
  id          String               @id @default(uuid())
  tenantId    String
  orgaoId     String
  reuniaoId   String?
  pautaId     String?
  ano         Int
  numero      Int?                 // atribuído na aprovação
  numeracao   String?              // 003/2026
  titulo      String
  texto       String?
  status      GovDeliberacaoStatus @default(PROPOSTA)
  resultado   Json?                // apuração
  decididaEm  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  reuniao GovReuniao? @relation(fields: [reuniaoId], references: [id], onDelete: SetNull)
  votos   GovVotoRegistro[]

  @@unique([tenantId, ano, numero])
  @@index([tenantId, orgaoId, status])
}

model GovVotoRegistro {
  id            String   @id @default(uuid())
  tenantId      String
  deliberacaoId String
  membroId      String
  voto          GovVoto
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliberacao GovDeliberacao @relation(fields: [deliberacaoId], references: [id], onDelete: Cascade)

  @@unique([deliberacaoId, membroId])
  @@index([tenantId, deliberacaoId])
}

