  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  curriculumSubjects EduCurriculumSubject[]
  questions          EduQuestion[]
  contentItems       EduContentItem[]
  flashcardDecks     EduFlashcardDeck[]
  forums             EduForum[]
  reinforcementPlans EduReinforcementPlan[]
  equivalencyItems   EduEquivalencyItem[]

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
  @@index([tenantId])
  @@map("edu_subjects")
}

model EduCurriculum {
  id            String     @id @default(cuid())
