  tenantId      String
  origem        String?       // risco, inspeção, acidente...
  origemId      String?
  acao          String
  responsavelId String?
  prazo         DateTime
  status        GovStatusAcao @default(PLANEJADA)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

