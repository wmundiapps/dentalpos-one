  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId    String
  classId     String?
  class       EduClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId   String?
  subject     EduSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  topics EduForumTopic[]

  @@index([clinicId, isActive])
  @@index([tenantId])
  @@map("edu_forums")
}

model EduForumTopic {
  id              String   @id @default(cuid())
  forumId         String
  forum           EduForum @relation(fields: [forumId], references: [id], onDelete: Cascade)
  authorStudentId String?
  authorUserId    String?
  authorName      String
  title           String
  body            String
  isPinned        Boolean  @default(false)
  isLocked        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  replies EduForumReply[]

  @@index([forumId, isPinned])
  @@map("edu_forum_topics")
}

model EduForumReply {
  id              String        @id @default(cuid())
  topicId         String
  topic           EduForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorStudentId String?
  authorUserId    String?
  authorName      String
  body            String
  createdAt       DateTime      @default(now())

  @@index([topicId])
  @@map("edu_forum_replies")
}

model EduLibrarySubscription {
  id               String      @id @default(cuid())
  clinicId         String
  clinic           Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId         String
  studentId        String?
  student          EduStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  scope            String      @default("INSTITUCIONAL")
  provider         String
  plan             String
  status           String      @default("ATIVA")
  amount           Float       @default(0)
  startDate        DateTime    @default(now())
  endDate          DateTime?
  financialEntryId String?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([clinicId, scope, status])
  @@index([tenantId])
  @@map("edu_library_subscriptions")
}

// ============================================================
// EDUMASTER — DESEMPENHO, ENADE/ENAMED E REFORÇO
// Simulados usam EduExam (type ENADE_SIMULADO / programId), análise
// por competência usa EduQuestion.competency. Painel de desempenho
// é calculado on-demand (attempts + frequência), sem duplicar dados.
// ============================================================

model EduReinforcementPlan {
  id          String      @id @default(cuid())
  clinicId    String
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId    String
  studentId   String
  student     EduStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     EduSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  competency  String?
  title       String
  description String?
  status      String      @default("ATIVO")
  dueDate     DateTime?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  actions EduReinforcementAction[]

  @@index([clinicId, status])
  @@index([studentId])
  @@index([tenantId])
  @@map("edu_reinforcement_plans")
}

model EduReinforcementAction {
  id          String               @id @default(cuid())
  planId      String
  plan        EduReinforcementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  description String
  status      String               @default("PENDENTE")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())

  @@index([planId])
  @@map("edu_reinforcement_actions")
}

// ============================================================
// EDUMASTER — PROTOCOLO E CERTIFICADOS (SECRETARIA)
// Documentos do aluno, protocolo de solicitação (histórico,
// declaração, certificado, diploma) e emissão de certificados com
// código público de verificação de autenticidade. Assinatura digital
// ICP-Brasil do diploma fica fora de escopo aqui (norma do MEC precisa
// ser confirmada antes de implementar) — o campo signatureStatus
// existe para plugar essa etapa depois sem quebrar o fluxo.
// ============================================================

model EduDocumentUpload {
  id           String     @id @default(cuid())
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId     String
  studentId    String
  student      EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         String     @default("OUTRO")
  title        String
  url          String
  uploadedById String?
  createdAt    DateTime   @default(now())

  @@index([studentId])
  @@index([clinicId])
  @@map("edu_document_uploads")
}

model EduDocumentRequest {
  id             String     @id @default(cuid())
  clinicId       String
  clinic         Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId       String
  studentId      String
  student        EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  protocolNumber String
  type           String     @default("DECLARACAO_MATRICULA")
  status         String     @default("SOLICITADO")
  deliveryMethod String     @default("DIGITAL")
  notes          String?
  fileUrl        String?
  requestedById  String?
  requestedAt    DateTime   @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([clinicId, protocolNumber])
  @@index([clinicId, status])
  @@index([studentId])
  @@index([tenantId])
  @@map("edu_document_requests")
}

model EduCertificate {
  id               String     @id @default(cuid())
  clinicId         String
  clinic           Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId         String
  studentId        String
  student          EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId     String?
  type             String     @default("CERTIFICADO_CONCLUSAO")
  title            String
  issueDate        DateTime   @default(now())
  registryCode     String?
  verificationCode String     @unique
  signedFileUrl    String?
  signatureStatus  String     @default("NAO_APLICAVEL")
  status           String     @default("EMITIDO")
  issuedById       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([clinicId, status])
  @@index([studentId])
  @@index([tenantId])
  @@map("edu_certificates")
}

// ============================================================
// EDUMASTER — FACILITIES (INFRAESTRUTURA)
// Patrimônio, manutenção (pátio, iluminação e demais locais entram
// pelo campo "location"), estacionamento e vencimentos com regra de
// antecedência (vencimento − prazo de preparação − margem de
// segurança). EduExpiringItem é genérico de propósito: outros módulos
// (Governança, Jurídico) reaproveitam a mesma tabela para seus próprios
// vencimentos, filtrando por category/relatedType.
// ============================================================

model EduAsset {
  id               String    @id @default(cuid())
  clinicId         String
  clinic           Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId         String
  code             String
  name             String
  category         String    @default("OUTRO")
  location         String?
  acquisitionDate  DateTime?
  acquisitionValue Float?
  status           String    @default("ATIVO")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  maintenanceOrders EduMaintenanceOrder[]

  @@unique([clinicId, code])
  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_assets")
}

model EduMaintenanceOrder {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId      String
  assetId       String?
  asset         EduAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  location      String?
  title         String
  description   String?
  priority      String    @default("MEDIA")
  status        String    @default("ABERTA")
  requestedById String?
  assignedTo    String?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_maintenance_orders")
}

model EduParkingSpot {
  id                  String      @id @default(cuid())
  clinicId            String
  clinic              Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId            String
  code                String
  type                String      @default("ALUNO")
  isOccupied          Boolean     @default(false)
  assignedToStudentId String?
  assignedToStudent   EduStudent? @relation(fields: [assignedToStudentId], references: [id], onDelete: SetNull)
  assignedToUserId    String?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([clinicId, code])
  @@index([clinicId, type])
  @@index([tenantId])
  @@map("edu_parking_spots")
}

model EduExpiringItem {
  id                String    @id @default(cuid())
  clinicId          String
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId          String
  category          String    @default("OUTRO")
  title             String
  relatedAssetId    String?
  relatedType       String?
  relatedId         String?
  expiresAt         DateTime
  preparationDays   Int       @default(0)
  safetyMarginDays  Int       @default(0)
  responsibleUserId String?
  status            String    @default("ATIVO")
  notes             String?
  resolvedAt        DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clinicId, status, expiresAt])
  @@index([tenantId])
  @@map("edu_expiring_items")
}

// ============================================================
// EDUMASTER — SUPRIMENTOS (COMPRAS, ESTOQUE, VENDAS)
// Recebimento de pedido de compra gera entrada de estoque + conta a
// pagar (FinancialEntry); venda gera saída de estoque + conta a
// receber — reaproveitando o Financeiro compartilhado, como no
// módulo de mensalidade e na biblioteca por assinatura.
// ============================================================

model EduSupplyItem {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  code            String
  name            String
  category        String   @default("OUTRO")
  unit            String   @default("UN")
  minQuantity     Float    @default(0)
  currentQuantity Float    @default(0)
  salePrice       Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements     EduSupplyMovement[]
  purchaseItems EduPurchaseOrderItem[]
  saleItems     EduSaleItem[]

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
  @@index([tenantId])
  @@map("edu_supply_items")
}

model EduSupplyMovement {
  id            String        @id @default(cuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId      String
  itemId        String
  item          EduSupplyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          String        @default("ENTRADA")
  quantity      Float
  reason        String?
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime      @default(now())

  @@index([itemId])
  @@index([clinicId, type])
  @@map("edu_supply_movements")
}

model EduPurchaseOrder {
  id               String   @id @default(cuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId         String
  supplierName     String
  status           String   @default("RASCUNHO")
  totalAmount      Float    @default(0)
  notes            String?
  requestedById    String?
  approvedById     String?
  financialEntryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items EduPurchaseOrderItem[]

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_purchase_orders")
}

model EduPurchaseOrderItem {
  id          String           @id @default(cuid())
  orderId     String
  order       EduPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String?
  item        EduSupplyItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description String
  quantity    Float
  unitPrice   Float

  @@index([orderId])
  @@map("edu_purchase_order_items")
}

model EduSale {
  id               String      @id @default(cuid())
  clinicId         String
  clinic           Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId         String
  studentId        String?
  student          EduStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  buyerName        String
  totalAmount      Float       @default(0)
  paymentMethod    String?
  status           String      @default("CONCLUIDA")
  financialEntryId String?
  createdById      String?
  createdAt        DateTime    @default(now())

  items EduSaleItem[]

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_sales")
}

model EduSaleItem {
  id          String         @id @default(cuid())
  saleId      String
  sale        EduSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId      String?
  item        EduSupplyItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description String
  quantity    Float
  unitPrice   Float

  @@index([saleId])
  @@map("edu_sale_items")
}

// ============================================================
// EDUMASTER — GOVERNANÇA E REGULATÓRIO
// PDI (metas/indicadores/evidências), comissões (CPA, CIPA, NDE e
// outras) e vigilância regulatória (diários oficiais + atos do MEC)
// com triagem por IA via services/aiService.ts compartilhado.
// ============================================================

model EduCommittee {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId    String
  type        String   @default("OUTRA")
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members EduCommitteeMember[]

  @@index([clinicId, type, isActive])
  @@index([tenantId])
  @@map("edu_committees")
}

model EduCommitteeMember {
  id          String       @id @default(cuid())
  committeeId String
  committee   EduCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  userId      String?
  startDate   DateTime     @default(now())
  endDate     DateTime?
  createdAt   DateTime     @default(now())

  @@index([committeeId])
  @@map("edu_committee_members")
}

model EduPdiGoal {
  id                String    @id @default(cuid())
  clinicId          String
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId          String
  title             String
  description       String?
  indicator         String?
  targetValue       Float?
  currentValue      Float?
  responsibleUserId String?
  dueDate           DateTime?
  status            String    @default("PLANEJADA")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  evidences EduPdiEvidence[]

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_pdi_goals")
}

model EduPdiEvidence {
  id          String     @id @default(cuid())
  goalId      String
  goal        EduPdiGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  notes       String?
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([goalId])
  @@map("edu_pdi_evidences")
}

model EduRegulatoryWatch {
  id                String   @id @default(cuid())
  clinicId          String
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId          String
  source            String   @default("OUTRO")
  title             String
  publishedAt       DateTime @default(now())
  sourceUrl         String?
  rawExcerpt        String?
  aiRelevant        Boolean?
  aiSummary         String?
  relevance         String   @default("NAO_ANALISADO")
  status            String   @default("NOVO")
  responsibleUserId String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clinicId, status])
  @@index([clinicId, relevance])
  @@index([tenantId])
  @@map("edu_regulatory_watches")
}

// ============================================================
// EDUMASTER — CAPTAÇÃO E INGRESSO
// Vestibular/processo seletivo, inscrição do candidato (funil
// integrado ao REVAH via RevahContact, reaproveitado sem alterações)
// até a efetivação da matrícula.
// ============================================================

model EduAdmissionExam {
  id               String     @id @default(cuid())
  clinicId         String
  clinic           Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId         String
  programId        String
  program          EduProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name             String
  modality         String     @default("PRESENCIAL")
  examDate         DateTime?
  applicationStart DateTime
  applicationEnd   DateTime
  vacancies        Int        @default(0)
  status           String     @default("ABERTO")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  applications EduApplication[]

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_admission_exams")
}

model EduApplication {
  id                String           @id @default(cuid())
  clinicId          String
  clinic            Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId          String
  admissionExamId   String
  admissionExam     EduAdmissionExam @relation(fields: [admissionExamId], references: [id], onDelete: Cascade)
  candidateName     String
  candidateEmail    String
  candidatePhone    String?
  documentNumber    String?
  status            String           @default("INSCRITO")
  score             Float?
  revahContactId    String?
  enrolledStudentId String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([admissionExamId, candidateEmail])
  @@index([clinicId, status])
  @@index([admissionExamId, status])
  @@index([tenantId])
  @@map("edu_applications")
}

// ============================================================
// EDUMASTER — PESQUISA E EXTENSÃO
// Projetos de pesquisa/extensão com fomento (Fundação Araucária,
// FAPESP, CNPq, Finep etc.) e editais. Pós-graduação lato/stricto
// sensu já é coberta pelo Núcleo Acadêmico (EduProgram.level
// POS_LATO/POS_STRICTO) — aqui só o link opcional para o projeto
// quando ele é a pesquisa de uma dissertação/tese.
// ============================================================

model EduFundingAgency {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId  String
  name      String
  website   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  calls    EduFundingCall[]
  projects EduResearchProject[]

  @@unique([clinicId, name])
  @@index([tenantId])
  @@map("edu_funding_agencies")
}

model EduFundingCall {
  id                  String           @id @default(cuid())
  clinicId            String
  clinic              Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId            String
  agencyId            String
  agency              EduFundingAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  requirements        String?
  applicationDeadline DateTime
  resultDate          DateTime?
  sourceUrl           String?
  status              String           @default("ABERTO")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  projects EduResearchProject[]

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_funding_calls")
}

model EduResearchProject {
  id              String            @id @default(cuid())
  clinicId        String
  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  type            String            @default("PESQUISA")
  title           String
  description     String?
  coordinatorName String
  programId       String?
  program         EduProgram?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  fundingAgencyId String?
  fundingAgency   EduFundingAgency? @relation(fields: [fundingAgencyId], references: [id], onDelete: SetNull)
  fundingCallId   String?
  fundingCall     EduFundingCall?   @relation(fields: [fundingCallId], references: [id], onDelete: SetNull)
  status          String            @default("PROPOSTA")
  startDate       DateTime?
  endDate         DateTime?
  budgetAmount    Float?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  members EduResearchProjectMember[]

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_research_projects")
}

model EduResearchProjectMember {
  id        String             @id @default(cuid())
  projectId String
  project   EduResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  studentId String?
  student   EduStudent?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt DateTime           @default(now())

  @@index([projectId])
  @@map("edu_research_project_members")
}

// ============================================================
// EDUMASTER — JURÍDICO
// Conciliação administrativa de demandas com audiências internas.
// Prazos usam EduExpiringItem (relatedType="EduLegalCase") em vez de
// duplicar a regra de antecedência já implementada em Facilities.
// O sistema organiza prazos, documentos e fluxos — não substitui
// advogado nem dá parecer jurídico.
// ============================================================

model EduLegalCase {
  id                String      @id @default(cuid())
  clinicId          String
  clinic            Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId          String
  type              String      @default("ADMINISTRATIVO")
  title             String
  description       String?
  involvedName      String
  studentId         String?
  student           EduStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  status            String      @default("ABERTO")
  responsibleUserId String?
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  hearings  EduLegalHearing[]
  documents EduLegalDocument[]

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_legal_cases")
}

model EduLegalHearing {
  id           String       @id @default(cuid())
  caseId       String
  legalCase    EduLegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  location     String?
  mediatorName String?
  status       String       @default("AGENDADA")
  outcome      String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([caseId])
  @@map("edu_legal_hearings")
}

model EduLegalDocument {
  id           String       @id @default(cuid())
  caseId       String
  legalCase    EduLegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title        String
  url          String
  uploadedById String?
  createdAt    DateTime     @default(now())

  @@index([caseId])
  @@map("edu_legal_documents")
}

// ============================================================
// EDUMASTER — MOTOR DE FORMULÁRIOS E FLUXOS CONFIGURÁVEIS
// Último módulo, propositalmente genérico: cobre departamentos extras
// que não ganharam módulo dedicado. Campos do formulário e etapas do
// fluxo ficam em JSON, editáveis pela própria instituição sem precisar
// de deploy novo a cada departamento.
// ============================================================

model EduFormTemplate {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId      String
  name          String
  description   String?
  department    String   @default("GERAL")
  fields        Json
  workflowSteps Json     @default("[]")
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions EduFormSubmission[]

  @@index([clinicId, department, isActive])
  @@index([tenantId])
  @@map("edu_form_templates")
}

model EduFormSubmission {
  id                   String          @id @default(cuid())
  clinicId             String
  clinic               Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId             String
  templateId           String
  template             EduFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submittedByStudentId String?
  submittedByStudent   EduStudent?     @relation(fields: [submittedByStudentId], references: [id], onDelete: SetNull)
  submittedByUserId    String?
  submitterName        String?
  data                 Json
  currentStep          Int             @default(0)
  stepHistory          Json            @default("[]")
  status               String          @default("RECEBIDO")
  reviewedById         String?
  reviewNotes          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([clinicId, status])
  @@index([templateId])
  @@index([tenantId])
  @@map("edu_form_submissions")
}

// ============================================================
// EDUMASTER — EQUIVALÊNCIA E APROVEITAMENTO DE DISCIPLINAS
// Análise de disciplinas cursadas em outra instituição (aluno
// transferido) ou em outro curso/currículo interno, para dispensa
// de disciplina equivalente na matriz atual.
// ============================================================

model EduEquivalencyRequest {
  id                String     @id @default(cuid())
  clinicId          String
  clinic            Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId          String
  studentId         String
  student           EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId         String
  program           EduProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  originInstitution String
  status            String     @default("PENDENTE")
  notes             String?
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  items EduEquivalencyItem[]

  @@index([clinicId, status])
  @@index([studentId])
  @@index([tenantId])
  @@map("edu_equivalency_requests")
}

model EduEquivalencyItem {
  id                     String                @id @default(cuid())
  requestId              String
  request                EduEquivalencyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  originSubjectName      String
  originWorkloadHours    Int
  originGrade            Float?
  targetSubjectId        String?
  targetSubject          EduSubject?           @relation(fields: [targetSubjectId], references: [id], onDelete: SetNull)
  status                 String                @default("PENDENTE")
  approvedWorkloadHours  Int?
  analystNotes           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([requestId])
  @@index([targetSubjectId])
  @@map("edu_equivalency_items")
}
