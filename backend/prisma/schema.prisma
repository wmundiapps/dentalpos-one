// ============================================================
// EDUMASTER — PROVAS COM IA
// Banco de questões, montagem de provas, tentativas do aluno,
// correção instantânea de objetivas e correção de dissertativas
// por IA (services/aiService.ts compartilhado) com override manual.
// ============================================================

model EduQuestion {
  id          String      @id @default(cuid())
  clinicId    String
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId    String
  subjectId   String?
  subject     EduSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  type        String      @default("OBJETIVA_UNICA")
  statement   String
  difficulty  String      @default("MEDIA")
  tags        String[]    @default([])
  competency  String?
  rubric      String?
  isActive    Boolean     @default(true)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  options       EduQuestionOption[]
  examQuestions EduExamQuestion[]

  @@index([clinicId, subjectId, isActive])
  @@index([tenantId])
  @@map("edu_questions")
}

model EduQuestionOption {
  id         String      @id @default(cuid())
  questionId String
  question   EduQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean     @default(false)
  order      Int         @default(0)

  @@index([questionId])
  @@map("edu_question_options")
}

model EduExam {
  id              String      @id @default(cuid())
  clinicId        String
  clinic          Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  classId         String?
  class           EduClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  programId       String?
  program         EduProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  title           String
  instructions    String?
  type            String      @default("AVALIACAO")
  totalPoints     Float       @default(10)
  durationMinutes Int         @default(60)
  startAt         DateTime?
  endAt           DateTime?
  status          String      @default("RASCUNHO")
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  examQuestions EduExamQuestion[]
  attempts      EduExamAttempt[]

  @@index([clinicId, status])
  @@index([tenantId])
  @@map("edu_exams")
}

model EduExamQuestion {
  id         String      @id @default(cuid())
  examId     String
  exam       EduExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   EduQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int         @default(0)
  points     Float       @default(1)

  answers EduExamAnswer[]

  @@unique([examId, questionId])
  @@index([examId])
  @@map("edu_exam_questions")
}

model EduExamAttempt {
  id             String     @id @default(cuid())
  examId         String
  exam           EduExam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt      DateTime   @default(now())
  submittedAt    DateTime?
  status         String     @default("EM_ANDAMENTO")
  objectiveScore Float      @default(0)
  essayScore     Float?
  totalScore     Float?

  answers EduExamAnswer[]

  @@unique([examId, studentId])
  @@index([examId, status])
  @@index([studentId])
  @@map("edu_exam_attempts")
}

model EduExamAnswer {
  id                String          @id @default(cuid())
  attemptId         String
  attempt           EduExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestionId    String
  examQuestion      EduExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]        @default([])
  essayText         String?
  isCorrect         Boolean?
  pointsEarned      Float?
  aiScore           Float?
  aiFeedback        String?
  manualScore       Float?
  manualFeedback    String?
  gradedById        String?
  gradedAt          DateTime?

  @@unique([attemptId, examQuestionId])
  @@index([attemptId])
  @@map("edu_exam_answers")
}

// ============================================================
// EDUMASTER — CONTEÚDO E BIBLIOTECA
// Ambiente de aprendizagem (videoaulas, PDFs, apostilas, material
// complementar com progresso por aluno), flashcards com repetição
// espaçada SM-2, fóruns por turma/disciplina e biblioteca
// terceirizada por assinatura (institucional ou individual — a
// individual paga gera conta a receber no Financeiro compartilhado
// via FinancialEntry, sem alterar esse model).
// ============================================================

model EduContentItem {
  id              String      @id @default(cuid())
  clinicId        String
  clinic          Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tenantId        String
  subjectId       String?
  subject         EduSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classId         String?
  class           EduClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  type            String      @default("PDF")
  title           String
  description     String?
  url             String
  durationMinutes Int?
  order           Int         @default(0)
  isActive        Boolean     @default(true)
  sourceText      String?
  summary8020     String?
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  progress EduContentProgress[]

  @@index([clinicId, subjectId, isActive])
  @@index([clinicId, classId, isActive])
  @@index([tenantId])
  @@map("edu_content_items")
}

model EduContentProgress {
  id                  String         @id @default(cuid())
  contentItemId       String
  contentItem         EduContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  studentId           String
  student             EduStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              String         @default("NAO_INICIADO")
  progressPercent     Int            @default(0)
  lastPositionSeconds Int?
  completedAt         DateTime?
  updatedAt           DateTime       @updatedAt

  @@unique([contentItemId, studentId])
  @@index([studentId])
  @@map("edu_content_progress")
}

model EduFlashcardDeck {
