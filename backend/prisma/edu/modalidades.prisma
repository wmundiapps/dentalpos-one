// ============================================================
// EDUMASTER PRO — MODALIDADES (presencial, semipresencial, EAD, híbrido,
// polos, tutoria, engajamento no AVA, práticas/estágios e pós-graduação).
// Prefixo Mod. Referências externas = String ids sem @relation.
// ============================================================

enum ModModalidade {
  PRESENCIAL
  SEMIPRESENCIAL
  EAD
  HIBRIDO
}

// Parâmetros de regra por tenant (1 linha por instituição).
model ModConfig {
  id                          String   @id @default(uuid())
  tenantId                    String   @unique
  maxPctEadPresencial         Float    @default(40)   // % máx. de carga online em curso presencial (Port. MEC 2.117/2019)
  minPctPresencialSemi        Float    @default(40)   // % mín. presencial em semipresencial
  maxPctEadSemi               Float    @default(60)
  minEncontrosPresenciaisEad  Int      @default(1)    // por disciplina/período
  minAvaliacoesPresenciaisEad Int      @default(1)
  alunosPorTutorEad           Int      @default(50)
  alunosPorTutorSemi          Int      @default(80)
  slaRespostaHoras            Int      @default(48)
  slaUrgenteHoras             Int      @default(12)
  diasInatividadeAtencao      Int      @default(7)
  diasInatividadeCritico      Int      @default(14)
  presencaMinimaLivePct       Float    @default(75)
  cargaMinimaLato             Int      @default(360)
  prazoMaxMesesMestrado       Int      @default(24)
  prazoMaxMesesDoutorado      Int      @default(48)
  prazoMaxMesesLato           Int      @default(24)
  maxOrientandosPorDocente    Int      @default(8)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// Histórico das verificações de conformidade de modalidade por curso.
model ModVerificacao {
  id             String   @id @default(uuid())
  tenantId       String
  programId      String
  modalidade     ModModalidade
  conforme       Boolean
  percentualEad  Float
  resultado      Json
  executadoPorId String?
  createdAt      DateTime @default(now())

  @@index([tenantId, programId])
}

// ---------- Ofertas por disciplina ----------

model ModOferta {
  id              String   @id @default(uuid())
  tenantId        String
  disciplineId    String
  programId       String?
  termId          String?
  classSectionId  String?
  modalidade      ModModalidade
  cargaPresencial Int      @default(0)
  cargaOnline     Int      @default(0)
  diasEncontro    Json?        // ["SEG","QUA"] ou datas
  minEncontros    Int      @default(0)
  avaliacoesPresenciais Int @default(0)
  poloId          String?
  ativo           Boolean  @default(true)
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  encontros       ModEncontro[]
  lives           ModAulaLive[]

  @@index([tenantId, programId])
  @@index([tenantId, classSectionId])
}

enum ModEncontroTipo {
  ENCONTRO_PRESENCIAL
  PROVA_PRESENCIAL
  AULA_PRATICA
  DEFESA_TCC
  OUTRO
}

enum ModEncontroStatus {
  AGENDADO
  REALIZADO
  CANCELADO
}

model ModEncontro {
  id              String   @id @default(uuid())
  tenantId        String
  ofertaId        String
  tipo            ModEncontroTipo
  titulo          String
  inicio          DateTime
  fim             DateTime
  poloId          String?
  spaceId         String?
  calendarEventId String?      // evento do módulo calendario
  classSessionId  String?
  obrigatorio     Boolean  @default(true)
  status          ModEncontroStatus @default(AGENDADO)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  oferta          ModOferta @relation(fields: [ofertaId], references: [id], onDelete: Cascade)

  @@index([tenantId, inicio])
  @@index([ofertaId])
}

enum ModLiveStatus {
  AGENDADA
  AO_VIVO
  ENCERRADA
  CANCELADA
}

model ModAulaLive {
  id              String   @id @default(uuid())
  tenantId        String
  ofertaId        String?
  classSectionId  String?
  titulo          String
  professorUserId String?
  plataforma      String   @default("OUTRA")   // MEET, ZOOM, TEAMS, JITSI, OUTRA
  sala            String?
  linkUrl         String?
  inicio          DateTime
  fim             DateTime
  gravacaoUrl     String?
  gravacaoDisponivelEm DateTime?
  presencaMinimaPct Float  @default(75)
  status          ModLiveStatus @default(AGENDADA)
  iniciadaEm      DateTime?
  encerradaEm     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  oferta          ModOferta? @relation(fields: [ofertaId], references: [id], onDelete: SetNull)
  eventos         ModLiveEvento[]
  presencas       ModLivePresenca[]

  @@index([tenantId, inicio])
}

model ModLiveEvento {
  id        String   @id @default(uuid())
  tenantId  String
  liveId    String
  studentId String
  tipo      String        // ENTRADA | SAIDA
  em        DateTime
  createdAt DateTime @default(now())

  live      ModAulaLive @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@index([liveId, studentId])
  @@index([tenantId])
}

model ModLivePresenca {
  id        String   @id @default(uuid())
  tenantId  String
  liveId    String
  studentId String
  minutos   Float    @default(0)
  percentual Float   @default(0)
  presente  Boolean  @default(false)
  manual    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  live      ModAulaLive @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@unique([liveId, studentId])
  @@index([tenantId])
}

// ---------- Polos EAD ----------

enum ModPoloStatus {
  EM_CREDENCIAMENTO
  CREDENCIADO
  SUSPENSO
  DESCREDENCIADO
}

model ModPolo {
  id              String   @id @default(uuid())
  tenantId        String
  codigo          String
  nome            String
  spaceId         String?       // EduSpace (tipo POLO_EAD)
  campusId        String?
  responsavelNome String?
  responsavelEmail String?
  responsavelTelefone String?
  responsavelUserId String?
  cep             String?
  logradouro      String?
  numero          String?
  bairro          String?
  cidade          String?
  uf              String?
  statusCredenciamento ModPoloStatus @default(EM_CREDENCIAMENTO)
  atoNumero       String?
  atoData         DateTime?
  atoValidade     DateTime?
  capacidade      Int      @default(0)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  checklist       ModPoloChecklistItem[]
  ofertas         ModPoloOferta[]
  alunos          ModPoloAluno[]

  @@unique([tenantId, codigo])
  @@index([tenantId, statusCredenciamento])
}

model ModPoloChecklistItem {
  id          String   @id @default(uuid())
  tenantId    String
  poloId      String
  chave       String        // LAB_INFORMATICA, BIBLIOTECA, SALA_TUTORIA, ACESSIBILIDADE...
  titulo      String
  obrigatorio Boolean  @default(true)
  atendido    Boolean  @default(false)
  evidenciaUrl String?
  observacao  String?
  verificadoEm DateTime?
  verificadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  polo        ModPolo  @relation(fields: [poloId], references: [id], onDelete: Cascade)

  @@unique([poloId, chave])
  @@index([tenantId])
}

model ModPoloOferta {
  id        String   @id @default(uuid())
  tenantId  String
  poloId    String
  programId String
  termId    String?
  vagas     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  polo      ModPolo  @relation(fields: [poloId], references: [id], onDelete: Cascade)

  @@unique([poloId, programId, termId])
  @@index([tenantId, programId])
}

model ModPoloAluno {
  id        String   @id @default(uuid())
  tenantId  String
  poloId    String
  studentId String
  programId String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  polo      ModPolo  @relation(fields: [poloId], references: [id], onDelete: Cascade)

  @@unique([poloId, studentId])
  @@index([tenantId, studentId])
}

// ---------- Tutoria ----------

enum ModTutorTipo {
  PRESENCIAL
  DISTANCIA
}

model ModTutor {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  nome        String
  email       String?
  telefone    String?
  tipo        ModTutorTipo @default(DISTANCIA)
  poloId      String?
  capacidadeAlunos Int  @default(50)
  titulacao   String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  alocacoes   ModTutorAlocacao[]
  avaliacoes  ModTutorAvaliacao[]

  @@index([tenantId, ativo])
}

model ModTutorAlocacao {
  id             String   @id @default(uuid())
  tenantId       String
  tutorId        String
  classSectionId String?
  poloId         String?
  programId      String?
  termId         String?
  alunosPrevistos Int     @default(0)
  inicio         DateTime @default(now())
  fim            DateTime?
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())

  tutor          ModTutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tenantId, tutorId])
  @@index([tenantId, classSectionId])
}

enum ModAtendimentoStatus {
  ABERTO
  EM_ATENDIMENTO
  RESPONDIDO
  ENCERRADO
  ESCALADO
}

model ModAtendimento {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  tutorId     String?
  classSectionId String?
  canal       String   @default("AVA")   // AVA, WHATSAPP, EMAIL, PRESENCIAL, TELEFONE
  assunto     String
  prioridade  String   @default("NORMAL") // BAIXA, NORMAL, ALTA, URGENTE
  status      ModAtendimentoStatus @default(ABERTO)
  slaLimite   DateTime
  primeiraRespostaEm DateTime?
  slaCumprido Boolean?
  escalonadoEm DateTime?
  encerradoEm DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mensagens   ModAtendimentoMensagem[]

  @@index([tenantId, status, slaLimite])
  @@index([tenantId, tutorId])
  @@index([tenantId, studentId])
}

model ModAtendimentoMensagem {
  id            String   @id @default(uuid())
  tenantId      String
  atendimentoId String
  autorTipo     String        // ALUNO | TUTOR | SISTEMA
  autorId       String?
  texto         String
  createdAt     DateTime @default(now())

  atendimento   ModAtendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@index([atendimentoId])
}

model ModTutorAvaliacao {
  id            String   @id @default(uuid())
  tenantId      String
  tutorId       String
  studentId     String
  atendimentoId String?
  nota          Int           // 1..5
  comentario    String?
  createdAt     DateTime @default(now())

  tutor         ModTutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tenantId, tutorId])
}

// ---------- Engajamento no AVA ----------

enum ModEngajamentoTipo {
  LOGIN
  ACESSO_CONTEUDO
  VIDEO
  ATIVIDADE_ENTREGUE
  FORUM
  AVALIACAO
  LIVE
  OUTRO
}

model ModEngajamentoEvento {
  id            String   @id @default(uuid())
  tenantId      String
  studentId     String
  classSectionId String?
  disciplineId  String?
  tipo          ModEngajamentoTipo
  duracaoSeg    Int      @default(0)
  refType       String?
  refId         String?
  ocorridoEm    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([tenantId, studentId, ocorridoEm])
  @@index([tenantId, classSectionId, ocorridoEm])
}

model ModEngajamentoResumo {
  id             String   @id @default(uuid())
  tenantId       String
  studentId      String
  ultimoAcesso   DateTime?
  diasSemAcesso  Int      @default(0)
  horas30d       Float    @default(0)
  acessos30d     Int      @default(0)
  tarefas30d     Int      @default(0)
  score          Int      @default(0)     // risco 0-100
  nivel          String   @default("BAIXO") // BAIXO | MEDIO | ALTO | CRITICO
  fatores        Json?
  calculadoEm    DateTime @default(now())

  @@unique([tenantId, studentId])
  @@index([tenantId, nivel])
}

model ModAlertaInatividade {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  nivel       String          // ATENCAO | CRITICO
  diasSemAcesso Int
  status      String   @default("ABERTO") // ABERTO | RESOLVIDO
  resolvidoEm DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId, status])
  @@index([tenantId, studentId])
}

// ---------- Estágios e aulas práticas ----------

enum ModPraticaTipo {
  AULA_PRATICA
  LABORATORIO
  ESTAGIO_SUPERVISIONADO
  VISITA_TECNICA
}

model ModAgendaPratica {
  id             String   @id @default(uuid())
  tenantId       String
  tipo           ModPraticaTipo
  titulo         String
  programId      String?
  classSectionId String?
  classSessionId String?
  poloId         String?
  spaceId        String?
  inicio         DateTime
  fim            DateTime
  vagas          Int      @default(0)
  supervisorNome String?
  supervisorUserId String?
  status         String   @default("AGENDADA") // AGENDADA | REALIZADA | CANCELADA
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inscricoes     ModPraticaInscricao[]

  @@index([tenantId, inicio])
  @@index([tenantId, poloId])
}

model ModPraticaInscricao {
  id         String   @id @default(uuid())
  tenantId   String
  agendaId   String
  studentId  String
  status     String   @default("INSCRITO") // INSCRITO | PRESENTE | FALTOU | CANCELADO
  horas      Float    @default(0)
  createdAt  DateTime @default(now())

  agenda     ModAgendaPratica @relation(fields: [agendaId], references: [id], onDelete: Cascade)

  @@unique([agendaId, studentId])
  @@index([tenantId, studentId])
}

model ModEstagio {
  id            String   @id @default(uuid())
  tenantId      String
  studentId     String
  programId     String?
  concedente    String
  concedenteCnpj String?
  supervisorNome String?
  orientadorUserId String?
  horasExigidas Float
  horasCumpridas Float   @default(0)
  inicio        DateTime
  fim           DateTime?
  status        String   @default("EM_ANDAMENTO") // PLANEJADO | EM_ANDAMENTO | CONCLUIDO | CANCELADO
  termoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  horas         ModHoraPratica[]

  @@index([tenantId, studentId])
}

model ModHoraPratica {
  id          String   @id @default(uuid())
  tenantId    String
  estagioId   String?
  agendaId    String?
  studentId   String
  data        DateTime
  horas       Float
  descricao   String?
  status      String   @default("PENDENTE") // PENDENTE | VALIDADA | REJEITADA
  validadoPorId String?
  validadoEm  DateTime?
  createdAt   DateTime @default(now())

  estagio     ModEstagio? @relation(fields: [estagioId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId])
}

// ---------- PÓS-GRADUAÇÃO ----------

enum ModPosNivel {
  ESPECIALIZACAO
  MBA
  MESTRADO_ACADEMICO
  MESTRADO_PROFISSIONAL
  DOUTORADO
}

model ModPosPrograma {
  id              String   @id @default(uuid())
  tenantId        String
  codigo          String
  nome            String
  nivel           ModPosNivel
  modalidade      ModModalidade @default(PRESENCIAL)
  programId       String?       // AcademicProgram correspondente (opcional)
  coordenadorUserId String?
  coordenadorNome String?
  cargaHoraria    Int      @default(0)
  creditosMinimos Int      @default(0)
  prazoMaxMeses   Int?
  conceitoCapes   Int?
  portariaReconhecimento String?
  areaAvaliacao   String?
  exigeTcc        Boolean  @default(true)
  status          String   @default("ATIVO") // EM_ELABORACAO | ATIVO | SUSPENSO | ENCERRADO
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  areas           ModPosArea[]
  linhas          ModPosLinha[]
  modulos         ModPosModulo[]
  turmas          ModPosTurma[]
  docentes        ModPosDocente[]
  disciplinas     ModPosDisciplina[]
  alunos          ModPosAluno[]
  colegiado       ModPosColegiado[]
  ofertas         ModPosOferta[]

  @@unique([tenantId, codigo])
  @@index([tenantId, nivel])
}

model ModPosArea {
  id         String @id @default(uuid())
  tenantId   String
  posId      String
  nome       String
  descricao  String?
  createdAt  DateTime @default(now())

  pos        ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)
  linhas     ModPosLinha[]

  @@index([tenantId, posId])
}

model ModPosLinha {
  id         String @id @default(uuid())
  tenantId   String
  posId      String
  areaId     String?
  nome       String
  descricao  String?
  createdAt  DateTime @default(now())

  pos        ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)
  area       ModPosArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([tenantId, posId])
}

model ModPosModulo {
  id           String @id @default(uuid())
  tenantId     String
  posId        String
  ordem        Int    @default(1)
  nome         String
  cargaHoraria Int
  disciplineId String?
  docenteId    String?
  createdAt    DateTime @default(now())

  pos          ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@index([tenantId, posId])
}

model ModPosTurma {
  id         String   @id @default(uuid())
  tenantId   String
  posId      String
  codigo     String
  inicio     DateTime
  fim        DateTime?
  vagas      Int      @default(30)
  valorMensalidade Decimal? @db.Decimal(12,2)
  parcelas   Int?
  status     String   @default("PLANEJADA") // PLANEJADA | INSCRICOES | EM_ANDAMENTO | CONCLUIDA | CANCELADA
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pos        ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@unique([posId, codigo])
  @@index([tenantId])
}

model ModPosDocente {
  id         String   @id @default(uuid())
  tenantId   String
  posId      String
  userId     String?
  nome       String
  titulacao  String   @default("DOUTOR") // ESPECIALISTA | MESTRE | DOUTOR | POS_DOUTOR
  categoria  String   @default("PERMANENTE") // PERMANENTE | COLABORADOR | VISITANTE
  orientador Boolean  @default(false)
  capacidadeOrientandos Int @default(8)
  linhaId    String?
  lattes     String?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pos        ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@index([tenantId, posId])
}

model ModPosDisciplina {
  id           String @id @default(uuid())
  tenantId     String
  posId        String
  disciplineId String?
  codigo       String
  nome         String
  creditos     Int    @default(4)
  cargaHoraria Int    @default(60)
  obrigatoria  Boolean @default(false)
  areaId       String?
  createdAt    DateTime @default(now())

  pos          ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@unique([posId, codigo])
  @@index([tenantId])
}

model ModPosColegiado {
  id        String   @id @default(uuid())
  tenantId  String
  posId     String
  userId    String?
  nome      String
  papel     String   @default("MEMBRO") // COORDENADOR | VICE | MEMBRO | REPR_DISCENTE | SECRETARIO
  inicio    DateTime @default(now())
  fim       DateTime?
  createdAt DateTime @default(now())

  pos       ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@index([tenantId, posId])
}

enum ModPosAlunoStatus {
  MATRICULADO
  QUALIFICADO
  DEFENDIDO
  TITULADO
  TRANCADO
  DESLIGADO
}

model ModPosAluno {
  id            String   @id @default(uuid())
  tenantId      String
  posId         String
  turmaId       String?
  studentId     String
  orientadorId  String?          // ModPosDocente.id
  coorientadorId String?
  linhaId       String?
  status        ModPosAlunoStatus @default(MATRICULADO)
  ingressoEm    DateTime
  prazoQualificacao DateTime?
  prazoDefesa   DateTime?
  prazoDeposito DateTime?
  qualificadoEm DateTime?
  defendidoEm   DateTime?
  depositadoEm  DateTime?
  tituladoEm    DateTime?
  creditosCumpridos Int   @default(0)
  cargaCumprida Int      @default(0)
  tccTitulo     String?
  tccStatus     String   @default("NAO_INICIADO") // NAO_INICIADO | EM_ELABORACAO | ENTREGUE | APROVADO | REPROVADO
  certificadoEmitidoEm DateTime?
  certificadoCodigo String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pos           ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)
  bancas        ModPosBanca[]
  bolsas        ModPosBolsa[]

  @@unique([posId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, orientadorId])
}

model ModPosBanca {
  id        String   @id @default(uuid())
  tenantId  String
  alunoId   String
  tipo      String   // QUALIFICACAO | DEFESA | TCC
  dataHora  DateTime
  local     String?
  membros   Json?    // [{nome,instituicao,papel}]
  resultado String?  // APROVADO | APROVADO_COM_RESSALVAS | REPROVADO
  nota      Float?
  ataUrl    String?
  realizada Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aluno     ModPosAluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([tenantId, dataHora])
}

model ModPosBolsa {
  id        String   @id @default(uuid())
  tenantId  String
  alunoId   String
  agencia   String   // CAPES | CNPQ | FAPESP | FAP | INSTITUCIONAL | OUTRA
  modalidadeBolsa String?  // DS, PROSUC, PROSUP, taxa...
  valorMensal Decimal @db.Decimal(12,2)
  inicio    DateTime
  fim       DateTime
  status    String   @default("ATIVA") // ATIVA | SUSPENSA | ENCERRADA | CANCELADA
  observacao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aluno     ModPosAluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, fim])
}

// Oferta de curso/turma de pós para o módulo de admissões (por String id).
model ModPosOferta {
  id            String   @id @default(uuid())
  tenantId      String
  posId         String
  turmaId       String?
  titulo        String
  vagas         Int
  valor         Decimal? @db.Decimal(12,2)
  inscricoesDe  DateTime?
  inscricoesAte DateTime?
  requisitos    String?
  status        String   @default("RASCUNHO") // RASCUNHO | PUBLICADA | ENCERRADA
  admOfertaId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pos           ModPosPrograma @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}
