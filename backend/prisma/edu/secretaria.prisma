// ============================================================
// EDUMASTER PRO — SECRETARIA ACADÊMICA (prefixo Sec)
// Protocolo/requerimentos, documentos, conferência, certificados,
// diplomas/colação/livros, arquivo e temporalidade.
// ============================================================

enum SecProtocoloStatus {
  ABERTO
  EM_ANALISE
  PENDENTE_DOCUMENTO
  DEFERIDO
  INDEFERIDO
  CONCLUIDO
  CANCELADO
}

enum SecTaxaStatus {
  ISENTA
  PENDENTE
  PAGA
  CANCELADA
}

enum SecConferenciaStatus {
  EM_ANDAMENTO
  PENDENTE
  APROVADA
  REPROVADA
}

enum SecItemStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

enum SecCertificadoStatus {
  EMITIDO
  REVOGADO
  SUBSTITUIDO
}

enum SecDiplomaStatus {
  SOLICITADO
  CONFERENCIA
  PENDENCIA
  REGISTRO
  REGISTRADO
  ENTREGUE
  CANCELADO
}

enum SecColacaoStatus {
  PLANEJADA
  CONVOCADA
  REALIZADA
  ENCERRADA
  CANCELADA
}

enum SecFormandoStatus {
  INSCRITO
  APTO
  PENDENTE
  COLOU
  AUSENTE
  EXCLUIDO
}

enum SecArquivoStatus {
  ATIVO
  ELEGIVEL_DESCARTE
  DESCARTE_SOLICITADO
  DESCARTADO
  GUARDA_PERMANENTE
  SUSPENSO
}

enum SecDescarteStatus {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADO
  REJEITADO
  EXECUTADO
}

// Contador atômico por tenant/chave (protocolo ANO/SEQ, nº de certificado, registro de diploma...).
model SecContador {
  id        String   @id @default(uuid())
  tenantId  String
  chave     String
  valor     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chave])
}

// ---------- REQUERIMENTOS / PROTOCOLO ----------

model SecTipoRequerimento {
  id                String   @id @default(uuid())
  tenantId          String
  codigo            String
  nome              String
  descricao         String?
  categoria         String   @default("GERAL")   // ACADEMICO, DOCUMENTO, FINANCEIRO, DIPLOMA, GERAL
  slaDias           Int      @default(5)          // dias úteis
  taxa              Float    @default(0)
  geraDocumento     String?                       // tipo de documento emitido automaticamente ao concluir (DECLARACAO_MATRICULA...)
  abertoPeloAluno   Boolean  @default(true)
  exigeAnexo        Boolean  @default(false)
  checklistModeloId String?
  prazoReenvioDias  Int      @default(15)
  responsavelRole   String   @default("SECRETARY")
  camposExtras      Json?                         // [{chave,rotulo,obrigatorio}]
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  protocolos        SecProtocolo[]

  @@unique([tenantId, codigo])
  @@index([tenantId, ativo])
}

model SecProtocolo {
  id               String   @id @default(uuid())
  tenantId         String
  numero           String                         // ANO/SEQ  ex.: 2026/000123
  ano              Int
  seq              Int
  tipoId           String
  studentId        String?
  enrollmentId     String?
  solicitanteNome  String?
  assunto          String
  descricao        String?
  status           SecProtocoloStatus @default(ABERTO)
  prioridade       String   @default("NORMAL")    // BAIXA, NORMAL, ALTA, URGENTE
  canal            String   @default("PORTAL")    // PORTAL, BALCAO, EMAIL, TELEFONE
  abertoPorId      String?
  responsavelId    String?
  slaDias          Int      @default(5)
  prazoEm          DateTime
  pendenteDesde    DateTime?
  taxaValor        Float    @default(0)
  taxaStatus       SecTaxaStatus @default(ISENTA)
  receivableId     String?
  decisao          String?
  decisaoMotivo    String?
  decididoEm       DateTime?
  concluidoEm      DateTime?
  escalonadoEm     DateTime?
  dados            Json?
  documentoCodigo  String?                        // documento gerado na conclusão
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tipo             SecTipoRequerimento @relation(fields: [tipoId], references: [id])
  tramites         SecTramite[]
  anexos           SecAnexo[]

  @@unique([tenantId, ano, seq])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, prazoEm])
}

model SecTramite {
  id            String   @id @default(uuid())
  tenantId      String
  protocoloId   String
  acao          String                            // ABERTURA, STATUS, COMENTARIO, ANEXO, ATRIBUICAO, ESCALONAMENTO, TAXA...
  deStatus      String?
  paraStatus    String?
  usuarioId     String?
  usuarioNome   String?
  origem        String   @default("SECRETARIA")   // SECRETARIA, ALUNO, SISTEMA
  parecer       String?
  visivelAluno  Boolean  @default(true)
  createdAt     DateTime @default(now())

  protocolo     SecProtocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  @@index([tenantId, protocoloId, createdAt])
}

model SecAnexo {
  id              String   @id @default(uuid())
  tenantId        String
  protocoloId     String
  nome            String
  mime            String?
  tamanho         Int?
  url             String?
  dataUrl         String?
  descricao       String?
  enviadoPorId    String?
  enviadoPorAluno Boolean  @default(false)
  createdAt       DateTime @default(now())

  protocolo       SecProtocolo @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  @@index([tenantId, protocoloId])
}

// ---------- CHECKLISTS E CONFERÊNCIA DE DOCUMENTOS ----------

model SecChecklistModelo {
  id          String   @id @default(uuid())
  tenantId    String
  codigo      String
  nome        String
  processo    String                              // MATRICULA, TRANSFERENCIA, APROVEITAMENTO, ESTAGIO, DIPLOMA, COLACAO...
  descricao   String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens       SecChecklistItemModelo[]

  @@unique([tenantId, codigo])
  @@index([tenantId, processo])
}

model SecChecklistItemModelo {
  id           String   @id @default(uuid())
  tenantId     String
  modeloId     String
  ordem        Int      @default(0)
  titulo       String
  descricao    String?
  obrigatorio  Boolean  @default(true)
  validadeDias Int?                               // documento não pode ser mais antigo que N dias
  requisitos   String?                            // o que a IA/analista deve verificar
  createdAt    DateTime @default(now())

  modelo       SecChecklistModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@index([tenantId, modeloId])
}

model SecConferencia {
  id            String   @id @default(uuid())
  tenantId      String
  modeloId      String?
  processo      String
  titulo        String
  protocoloId   String?
  studentId     String?
  refType       String?
  refId         String?
  status        SecConferenciaStatus @default(EM_ANDAMENTO)
  concluidaEm   DateTime?
  criadoPorId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itens         SecConferenciaItem[]

  @@index([tenantId, status])
  @@index([tenantId, protocoloId])
  @@index([tenantId, studentId])
  @@index([tenantId, refType, refId])
}

model SecConferenciaItem {
  id                 String   @id @default(uuid())
  tenantId           String
  conferenciaId      String
  itemModeloId       String?
  ordem              Int      @default(0)
  titulo             String
  obrigatorio        Boolean  @default(true)
  validadeDias       Int?
  requisitos         String?
  status             SecItemStatus @default(PENDENTE)
  motivo             String?
  anexoId            String?
  arquivoNome        String?
  arquivoUrl         String?
  arquivoDataUrl     String?
  documentoTexto     String?                      // texto/descrição do documento (OCR, digitação)
  dataDocumento      DateTime?
  analiseIa          Json?
  analisadoPorId     String?
  analisadoEm        DateTime?
  reenvioSolicitadoEm DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conferencia        SecConferencia @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)

  @@index([tenantId, conferenciaId])
}

// ---------- DOCUMENTOS EMITIDOS (declarações, histórico) ----------

model SecDocumentoEmitido {
  id            String   @id @default(uuid())
  tenantId      String
  tipo          String                            // DECLARACAO_MATRICULA, DECLARACAO_VINCULO, HISTORICO_ESCOLAR...
  studentId     String?
  protocoloId   String?
  codigo        String   @unique                  // código de verificação
  hash          String                            // SHA-256 do HTML
  html          String
  validoAte     DateTime?
  emitidoPorId  String?
  cancelado     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([tenantId, tipo])
  @@index([tenantId, studentId])
}

// ---------- CERTIFICADOS ----------

model SecCertModelo {
  id           String   @id @default(uuid())
  tenantId     String
  codigo       String
  nome         String
  tipo         String                             // CURSO, EXTENSAO, EVENTO, POS_GRADUACAO, MONITORIA, PARTICIPACAO
  titulo       String   @default("CERTIFICADO")
  texto        String                             // com {{variaveis}}
  htmlCustom   String?                            // HTML completo opcional (com {{variaveis}} e {{CABECALHO}})
  orientacao   String   @default("landscape")
  assinaturas  Json?                              // [{nome,cargo,assetKind?}]
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  certificados SecCertificado[]
  lotes        SecCertLote[]

  @@unique([tenantId, codigo])
  @@index([tenantId, tipo])
}

model SecCertLote {
  id          String   @id @default(uuid())
  tenantId    String
  modeloId    String
  nome        String
  total       Int      @default(0)
  criadoPorId String?
  createdAt   DateTime @default(now())

  modelo      SecCertModelo @relation(fields: [modeloId], references: [id])
  certificados SecCertificado[]

  @@index([tenantId, modeloId])
}

model SecCertificado {
  id               String   @id @default(uuid())
  tenantId         String
  modeloId         String
  loteId           String?
  numero           String                         // ANO/SEQ
  codigo           String   @unique               // verificação pública
  hash             String
  status           SecCertificadoStatus @default(EMITIDO)
  destinatarioNome String
  destinatarioDoc  String?
  studentId        String?
  tituloEvento     String
  cargaHoraria     Int?
  periodo          String?
  dados            Json?
  html             String
  emitidoEm        DateTime @default(now())
  emitidoPorId     String?
  revogadoEm       DateTime?
  revogadoPorId    String?
  motivoRevogacao  String?
  substituidoPorId String?
  certificateId    String?                        // Certificate do núcleo (opcional)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  modelo           SecCertModelo @relation(fields: [modeloId], references: [id])
  lote             SecCertLote? @relation(fields: [loteId], references: [id])

  @@unique([tenantId, numero])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, modeloId])
}

// ---------- LIVROS, ATAS, DIPLOMAS E COLAÇÃO ----------

model SecLivro {
  id             String   @id @default(uuid())
  tenantId       String
  tipo           String                           // REGISTRO_DIPLOMA, ATAS_COLACAO, ATAS_GERAIS, REGISTRO_CERTIFICADO
  numero         Int
  titulo         String
  folhaAtual     Int      @default(1)
  registrosPorFolha Int   @default(2)
  proximoRegistro Int     @default(1)
  aberto         Boolean  @default(true)
  abertoEm       DateTime @default(now())
  encerradoEm    DateTime?
  termoAbertura  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  diplomas       SecDiploma[]
  atas           SecAta[]

  @@unique([tenantId, tipo, numero])
  @@index([tenantId, tipo, aberto])
}

model SecAta {
  id          String   @id @default(uuid())
  tenantId    String
  livroId     String?
  numero      Int?
  tipo        String   @default("GERAL")          // COLACAO, COLEGIADO, BANCA, REUNIAO, GERAL
  titulo      String
  data        DateTime
  conteudo    String                              // HTML/texto
  participantes Json?
  colacaoId   String?
  assinadaEm  DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  livro       SecLivro? @relation(fields: [livroId], references: [id])

  @@index([tenantId, tipo])
  @@index([tenantId, colacaoId])
}

model SecDiploma {
  id                 String   @id @default(uuid())
  tenantId           String
  studentId          String
  programId          String?
  enrollmentId       String?
  tipo               String   @default("DIPLOMA") // DIPLOMA, SEGUNDA_VIA
  status             SecDiplomaStatus @default(SOLICITADO)
  solicitadoEm       DateTime @default(now())
  conferenciaId      String?
  colacaoId          String?
  livroId            String?
  numeroRegistro     Int?
  folha              Int?
  dataRegistro       DateTime?
  dataConclusao      DateTime?
  dataColacao        DateTime?
  entregueEm         DateTime?
  retiradoPor        String?
  retiradoDoc        String?
  pendencias         Json?
  observacoes        String?
  protocoloId        String?
  codigoVerificacao  String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  livro              SecLivro? @relation(fields: [livroId], references: [id])

  @@unique([livroId, numeroRegistro])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, colacaoId])
}

model SecColacao {
  id            String   @id @default(uuid())
  tenantId      String
  nome          String
  data          DateTime
  local         String?
  programId     String?
  termId        String?
  status        SecColacaoStatus @default(PLANEJADA)
  prazoInscricaoEm DateTime?
  observacoes   String?
  ataId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  formandos     SecColacaoFormando[]

  @@index([tenantId, status, data])
}

model SecColacaoFormando {
  id           String   @id @default(uuid())
  tenantId     String
  colacaoId    String
  studentId    String
  nome         String
  status       SecFormandoStatus @default(INSCRITO)
  pendencias   Json?
  juramento    Boolean  @default(true)
  diplomaId    String?
  observacoes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  colacao      SecColacao @relation(fields: [colacaoId], references: [id], onDelete: Cascade)

  @@unique([colacaoId, studentId])
  @@index([tenantId, studentId])
}

// ---------- ARQUIVO / TEMPORALIDADE ----------

model SecTemporalidade {
  id                   String   @id @default(uuid())
  tenantId             String
  codigo               String
  tipoDocumento        String
  descricao            String?
  prazoCorrenteAnos    Int      @default(5)       // arquivo corrente
  prazoIntermediarioAnos Int    @default(0)       // arquivo intermediário
  destinacao           String   @default("ELIMINACAO")   // ELIMINACAO | GUARDA_PERMANENTE
  fundamento           String?
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, codigo])
}

model SecArquivoItem {
  id              String   @id @default(uuid())
  tenantId        String
  temporalidadeId String
  titulo          String
  descricao       String?
  studentId       String?
  refType         String?
  refId           String?
  predio          String?
  sala            String?
  estante         String?
  caixa           String?
  pasta           String?
  urlDigital      String?
  dataDocumento   DateTime?
  dataEncerramento DateTime                         // marco inicial dos prazos de guarda
  eliminarApos    DateTime?                        // calculado
  status          SecArquivoStatus @default(ATIVO)
  suspensoMotivo  String?
  descarteId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, eliminarApos])
  @@index([tenantId, studentId])
}

model SecDescarte {
  id            String   @id @default(uuid())
  tenantId      String
  numero        String
  justificativa String?
  status        SecDescarteStatus @default(RASCUNHO)
  itemIds       Json                                // string[]
  solicitadoPorId String?
  aprovadoPorId String?
  aprovadoEm    DateTime?
  motivoRejeicao String?
  executadoEm   DateTime?
  termoHtml     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, numero])
  @@index([tenantId, status])
}
