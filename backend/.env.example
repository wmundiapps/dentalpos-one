NODE_ENV=development
APP_ENV=development
RELEASE_CHANNEL=internal
PORT=3000
DATABASE_URL=postgresql://dentalpos:dentalpos@localhost:5432/dentalpos?schema=public

# Segurança da aplicação
JWT_SECRET=troque-por-uma-chave-aleatoria-com-48-ou-mais-caracteres
JWT_EXPIRES_IN=8h
TENANT_SECRET_MASTER_KEY=troque-por-uma-chave-longa-e-unica
CORS_ORIGIN=http://localhost:5173
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_DEMO_REGISTRATION=false
DEMO_DEFAULT_DAYS=30
DEMO_GRACE_DAYS=7
DEMO_DEFAULT_MODULES=agenda,patients
DEMO_TERMS_VERSION=2026-09-08
TRUST_PROXY=false
API_BODY_LIMIT=2mb
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=1200

# Provisionamento inicial - somente ambiente controlado
BOOTSTRAP_TENANT_ID=clinic-pilot
BOOTSTRAP_CLINIC_NAME=Clínica Piloto
BOOTSTRAP_CLINIC_CNPJ=00000000000000
BOOTSTRAP_ADMIN_EMAIL=admin@clinic.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha

# URL pública do FRONTEND (usada também nos links de redefinição de senha)
PUBLIC_APP_URL=https://www.wmundi.com/dentalposone

# Pagamentos / recebimentos - configure somente no ambiente seguro
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
BANK_PROVIDER=
BANK_API_BASE_URL=
BANK_CLIENT_ID=
BANK_CLIENT_SECRET=

# REVAH providers - configure somente no servidor
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
COMTELE_API_KEY=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
REVAH_DEFAULT_SIMULATION=true

# Backup - só marcar como true após configurar job e testar restauração
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=30
BACKUP_LAST_RESTORE_TEST_AT=
