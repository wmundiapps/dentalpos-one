      {
        "id": "taxa",
        "label": "Taxa de recuperação",
        "min": 10,
        "max": 60,
        "step": 1,
        "val": 34,
        "unit": "%"
      },
      {
        "id": "titulos",
        "label": "Títulos em atraso por mês",
        "min": 20,
        "max": 400,
        "step": 10,
        "val": 120,
        "unit": ""
      },
      {
        "id": "minutos",
        "label": "Minutos de cobrança manual por título",
        "min": 2,
        "max": 20,
        "step": 1,
        "val": 8,
        "unit": "min"
      }
    ],
    "outputs": [
      {
        "label": "Valor recuperado (exemplo)",
        "expr": "carteira*taxa/100",
        "fmt": "brl"
      },
      {
        "label": "Horas de trabalho manual evitadas (supondo 70% automatizado)",
        "expr": "titulos*minutos*0.7/60",
        "fmt": "dec1"
      },
      {
        "label": "Mensagens automáticas por ciclo (3 por título)",
        "expr": "titulos*3",
        "fmt": "int"
      }
    ]
  },
