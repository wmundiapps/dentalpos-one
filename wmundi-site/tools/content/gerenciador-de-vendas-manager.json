        "min": 20,
        "max": 500,
        "step": 10,
        "val": 120,
        "unit": ""
      },
      {
        "id": "conv",
        "label": "Leads que viram proposta",
        "min": 10,
        "max": 80,
        "step": 1,
        "val": 35,
        "unit": "%"
      },
      {
        "id": "fech",
        "label": "Propostas fechadas",
        "min": 5,
        "max": 60,
        "step": 1,
        "val": 25,
        "unit": "%"
      },
      {
        "id": "ticket",
        "label": "Ticket médio (R$)",
        "min": 1000,
        "max": 30000,
        "step": 500,
        "val": 9000,
        "unit": ""
      }
    ],
    "outputs": [
      {
        "label": "Propostas geradas",
        "expr": "Math.round(leads*conv/100)",
        "fmt": "int"
      },
      {
        "label": "Vendas fechadas (exemplo)",
        "expr": "leads*conv/100*fech/100",
        "fmt": "dec1"
      },
      {
        "label": "Receita estimada (exemplo)",
        "expr": "leads*conv/100*fech/100*ticket",
        "fmt": "brl"
      }
    ]
  },
