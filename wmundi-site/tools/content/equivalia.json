  "sim": {
    "title": "Simulador: aproveitamento de estudos",
    "intro": "Informe o volume de pedidos e o tempo de análise para estimar a carga de trabalho da secretaria.",
    "inputs": [
      {
        "id": "ped",
        "label": "Pedidos por mês",
        "min": 10,
        "max": 500,
        "step": 5,
        "val": 86,
        "unit": ""
      },
      {
        "id": "dis",
        "label": "Disciplinas por pedido",
        "min": 1,
        "max": 20,
        "step": 1,
        "val": 9,
        "unit": ""
      },
      {
        "id": "tmp",
        "label": "Minutos por disciplina",
        "min": 2,
        "max": 30,
        "step": 1,
        "val": 6,
        "unit": ""
      },
      {
        "id": "apr",
        "label": "Aproveitamento (%)",
        "min": 10,
        "max": 100,
        "step": 5,
        "val": 70,
        "unit": ""
      }
    ],
    "outputs": [
      {
        "label": "Disciplinas a analisar",
        "expr": "ped*dis",
        "fmt": "int"
      },
      {
        "label": "Horas de análise por mês",
        "expr": "ped*dis*tmp/60",
        "fmt": "dec1"
      },
      {
        "label": "Disciplinas aproveitadas",
        "expr": "Math.round(ped*dis*apr/100)",
        "fmt": "int"
      }
    ]
  },
