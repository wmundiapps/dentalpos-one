        "val": 128,
        "unit": ""
      },
      {
        "id": "ped",
        "label": "Pedidos por prestador no mês",
        "min": 1,
        "max": 10,
        "step": 1,
        "val": 3,
        "unit": ""
      },
      {
        "id": "ticket",
        "label": "Ticket médio",
        "min": 50,
        "max": 600,
        "step": 10,
        "val": 186,
        "unit": "R$"
      },
      {
        "id": "com",
        "label": "Comissão da plataforma",
        "min": 5,
        "max": 25,
        "step": 1,
        "val": 12,
        "unit": "%"
      }
    ],
    "outputs": [
      {
        "label": "Pedidos no mês",
        "expr": "prest*ped",
        "fmt": "int"
      },
      {
        "label": "Volume transacionado",
        "expr": "prest*ped*ticket",
        "fmt": "brl"
      },
      {
        "label": "Receita da plataforma",
        "expr": "prest*ped*ticket*com/100",
        "fmt": "brl"
      }
    ]
  },
