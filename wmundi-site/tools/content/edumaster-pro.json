      {
        "label": "Valor em atraso estimado",
        "expr": "alu*men*ina/100",
        "fmt": "brl"
      },
      {
        "label": "Receita líquida estimada",
        "expr": "alu*men*(1-ina/100)",
        "fmt": "brl"
      }
    ]
