        "min": 2,
        "max": 16,
        "step": 1,
        "val": 8,
        "unit": ""
      },
      {
        "id": "retorno",
        "label": "Empresas que respondem",
        "min": 5,
        "max": 40,
        "step": 1,
        "val": 15,
        "unit": "%"
      },
      {
        "id": "entrev",
        "label": "Respostas que viram entrevista",
        "min": 10,
        "max": 80,
        "step": 5,
        "val": 40,
        "unit": "%"
      }
    ],
    "outputs": [
      {
        "label": "Candidaturas no período",
        "expr": "cand*semanas",
        "fmt": "int"
      },
      {
        "label": "Respostas esperadas (exemplo)",
        "expr": "cand*semanas*retorno/100",
        "fmt": "dec1"
      },
      {
        "label": "Entrevistas estimadas (exemplo)",
        "expr": "cand*semanas*retorno/100*entrev/100",
        "fmt": "dec1"
      }
    ]
  },
