        "min": 10,
        "max": 200,
        "step": 5,
        "val": 40,
        "unit": ""
      },
      {
        "id": "ocu",
        "label": "Ocupação (%)",
        "min": 10,
        "max": 100,
        "step": 1,
        "val": 59,
        "unit": ""
      }
    ],
    "outputs": [
      {
        "label": "Horas disponíveis no mês",
        "expr": "sal*hdi",
        "fmt": "int"
      },
      {
        "label": "Horas reservadas",
        "expr": "Math.round(sal*hdi*ocu/100)",
        "fmt": "int"
      },
      {
        "label": "Receita estimada de locação",
        "expr": "Math.round(sal*hdi*ocu/100)*vh",
        "fmt": "brl"
      }
    ]
