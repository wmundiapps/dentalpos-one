      {"id": "lembrete", "label": "Faltas evitadas com lembretes", "min": 0, "max": 80, "step": 5, "val": 30, "unit": "%"}
    ],
    "outputs": [
      {"label": "Receita prevista (após faltas)", "expr": "pac*ticket*(1-falta/100)", "fmt": "brl"},
      {"label": "Consultas perdidas por faltas", "expr": "pac*falta/100", "fmt": "int"},
      {"label": "Consultas recuperadas com lembretes", "expr": "pac*falta/100*lembrete/100", "fmt": "dec1"},
      {"label": "Receita recuperada (ilustrativa)", "expr": "pac*falta/100*lembrete/100*ticket", "fmt": "brl"}
    ]
  },
