      {
        "id": "tkt",
        "label": "Ticket médio (R$)",
        "min": 20,
        "max": 300,
        "step": 5,
        "val": 75,
        "unit": ""
      }
    ],
    "outputs": [
      {
        "label": "Veículos por dia (capacidade)",
        "expr": "Math.floor(box*hor*60/tmp)",
        "fmt": "int"
      },
      {
        "label": "Faturamento diário na capacidade",
        "expr": "Math.floor(box*hor*60/tmp)*tkt",
        "fmt": "brl"
      },
      {
        "label": "Faturamento a 70% da capacidade, em 26 dias",
        "expr": "Math.floor(box*hor*60/tmp)*tkt*0.7*26",
        "fmt": "brl"
      }
    ]
