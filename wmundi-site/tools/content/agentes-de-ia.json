  "sim": {
    "title": "Simulador: atendimento automático",
    "intro": "Mude o volume de conversas e a parcela automática para ver um exemplo de horas liberadas.",
    "inputs": [
      {
        "id": "conv",
        "label": "Conversas por mês",
        "min": 200,
        "max": 5000,
        "step": 100,
        "val": 1800,
        "unit": ""
      },
      {
        "id": "auto",
        "label": "Resolvidas pelo agente",
        "min": 20,
        "max": 90,
        "step": 1,
        "val": 70,
        "unit": "%"
      },
      {
        "id": "minutos",
        "label": "Minutos por atendimento humano",
        "min": 2,
        "max": 15,
        "step": 1,
        "val": 6,
        "unit": "min"
      },
      {
        "id": "hora",
        "label": "Custo da hora de atendimento (R$)",
        "min": 10,
        "max": 80,
        "step": 1,
        "val": 25,
        "unit": ""
      }
    ],
    "outputs": [
      {
        "label": "Conversas resolvidas pelo agente",
        "expr": "Math.round(conv*auto/100)",
        "fmt": "int"
      },
      {
        "label": "Horas de atendimento liberadas (exemplo)",
        "expr": "conv*auto/100*minutos/60",
        "fmt": "dec1"
      },
      {
        "label": "Custo de atendimento evitado (exemplo)",
        "expr": "conv*auto/100*minutos/60*hora",
        "fmt": "brl"
      }
    ]
  },
