  "sim": {
    "title": "Simulador: arrecadação do rotativo",
    "intro": "Mexa no número de vagas, na ocupação, na tarifa e nas horas de operação para estimar uma arrecadação ilustrativa.",
    "inputs": [
      {
        "id": "vagas",
        "label": "Vagas rotativas",
        "min": 100,
        "max": 2000,
        "step": 50,
        "val": 600,
        "unit": ""
      },
      {
        "id": "ocup",
        "label": "Ocupação média",
        "min": 20,
        "max": 95,
        "step": 5,
        "val": 60,
        "unit": "%"
      },
      {
        "id": "tarifa",
        "label": "Tarifa por hora",
        "min": 1,
        "max": 8,
        "step": 0.5,
        "val": 3,
        "unit": "R$"
      },
      {
        "id": "horas",
        "label": "Horas de operação por dia",
        "min": 4,
        "max": 14,
        "step": 1,
        "val": 8,
        "unit": "h"
      }
    ],
    "outputs": [
      {
        "label": "Vagas ocupadas em média",
        "expr": "Math.round(vagas*ocup/100)",
        "fmt": "int"
      },
      {
        "label": "Arrecadação por dia útil",
        "expr": "vagas*ocup/100*horas*tarifa",
        "fmt": "brl"
      },
      {
        "label": "Arrecadação em 26 dias",
        "expr": "vagas*ocup/100*horas*tarifa*26",
        "fmt": "brl"
      }
    ]
  },
