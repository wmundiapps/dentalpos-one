# Copie para .env (local) ou cadastre na Vercel. NUNCA coloque valores reais neste arquivo nem no chat.
DATABASE_URL=postgresql://vendeu:vendeu@localhost:5432/vendeu
JWT_SECRET=                 # openssl rand -base64 48
DOCUMENT_ENCRYPTION_KEY=    # openssl rand -base64 32  (guarde uma cópia: sem ela os documentos não abrem)
HASH_PEPPER=                # openssl rand -base64 32
APP_URL=https://app.vendeu.app
ALLOWED_ORIGINS=https://app.vendeu.app
API_URL=https://app.vendeu.app
CRON_SECRET=                # openssl rand -base64 32
# Mercado Pago (marketplace). Sem isto o modo é "mock" e NÃO sobe em produção.
# Exige conta de marketplace com "Pagamentos Avançados" habilitado pelo Mercado Pago.
PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=           # token da conta do Vendeu (marketplace)
MP_CLIENT_ID=              # aplicativo (OAuth) para o vendedor conectar a conta dele
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# E-mail e SMS de verificação
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vendeu <nao-responda@vendeu.app>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Regras de negócio (opcionais)
FEE_CAP_CENTS=0             # teto da comissão em centavos (0 = sem teto)
REMOVAL_FEE_CENTS=1000      # taxa para retirar anúncio publicado sem vender
RETURN_DAYS=7               # prazo de devolução depois do recebimento
OFFER_HOURS=48
PAY_HOURS=24
SHIP_DAYS=5
AUTO_RECEIVE_DAYS=10
RETURN_CONFIRM_DAYS=10
FEE_DUE_DAYS=7
FEE_BLOCK_AFTER_DAYS=3
OUTROS_GROUP_MIN=5
# Dados da operadora (aparecem nos documentos)
COMPANY_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=
DPO_NAME=
