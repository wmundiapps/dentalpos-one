{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./server/node_modules/@types"
    ]
  },
  "include": [
    "api/**/*.ts",
    "server/src/**/*.ts",
    "shared/**/*.ts"
  ]
}
