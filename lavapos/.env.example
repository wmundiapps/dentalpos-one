# ===== Servidor (Vercel > Settings > Environment Variables). NUNCA coloque segredos em variáveis VITE_* =====
DATABASE_URL=postgresql://usuario:senha@host:5432/banco     # Supabase do projeto do LavaPos (sessão pooler)
DATABASE_SSL=true
JWT_SECRET=                      # 32+ caracteres aleatórios:  openssl rand -base64 48
LAVAPOS_ENCRYPTION_KEY=          # 32 bytes em base64:         openssl rand -base64 32   (GUARDE UMA CÓPIA: sem ela o CPF e as chaves cifradas não voltam)
APP_URL=https://app.lavapos.com.br
CORS_ORIGIN=https://app.lavapos.com.br,https://lavapos.com.br,capacitor://localhost,https://localhost
CRON_SECRET=                     # a Vercel envia como "Authorization: Bearer ..." na rotina /api/cron/tick
# Cobrança (Asaas) e comissão de 10%
PLATFORM_FEE_PCT=10
PLATFORM_ASAAS_WALLET_ID=        # carteira (walletId) da conta Asaas da plataforma que recebe a comissão
PLATFORM_ASAAS_API_KEY=          # conta Asaas da plataforma: mensalidade R$ 119 dos lava-rápidos
ASAAS_SANDBOX=true               # trocar para false só em produção
ASAAS_WEBHOOK_TOKEN=             # o mesmo token cadastrado no webhook do Asaas -> https://api.lavapos.com.br/api/webhooks/asaas
# Mensagens
SMTP_URL=                        # smtp://usuario:senha@host:587  (e-mail)
MAIL_FROM="LavaPos <nao-responda@lavapos.com.br>"
MESSAGING_WEBHOOK_URL=           # provedor de WhatsApp/SMS (ex.: Z-API, Twilio, Zenvia)
MESSAGING_WEBHOOK_TOKEN=
# Google (nota e avaliações na página do lava-rápido)
GOOGLE_PLACES_API_KEY=
# Nota fiscal (provedor fiscal escolhido)
INVOICE_PROVIDER_TOKEN=

# ===== Tela (web/.env.production) — só valores PÚBLICOS =====
# VITE_API_URL=https://api.lavapos.com.br      (obrigatório no build dos aplicativos Apple/Google)
