{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build && mkdir -p public && echo REVAH API > public/index.txt",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/cron/tick",
      "schedule": "* * * * *"
    }
  ],
  "outputDirectory": "public"
}
