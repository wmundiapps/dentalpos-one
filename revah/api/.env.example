# ======================================================================
# REVAH API — variáveis de ambiente
# Banco PRÓPRIO do REVAH (não use o banco do DentalPos One).
# ======================================================================
NODE_ENV=production
# Supabase: use a connection string do "Session pooler" (porta 5432) com ?connection_limit=1
DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?connection_limit=1

# Segurança
JWT_SECRET=gere-com-openssl-rand-hex-32
ENCRYPTION_KEY=64-caracteres-hex-gerados-com-openssl-rand-hex-32
CRON_SECRET=gere-com-openssl-rand-hex-24

# URLs
PUBLIC_API_URL=https://api.revah.com.br
APP_URL=https://app.revah.com.br
SITE_URL=https://revah.com.br
# Origens extras liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=

# Backoffice WMundi (e-mails com acesso ao /admin)
REVAH_SUPERADMIN_EMAILS=

# Stripe (cartão, boleto; adicione pix quando a conta tiver Pix recorrente)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_START=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_LEADS=
STRIPE_PAYMENT_METHODS=card,boleto

# IA (Claude) — chatbot, agente de voz e resumos de ligação
ANTHROPIC_API_KEY=
REVAH_AI_MODEL=claude-opus-5

# Meta (WhatsApp Cloud API, Instagram, Messenger, Lead Ads)
META_VERIFY_TOKEN=gere-um-token-qualquer
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# REVAH Leads (fontes internas — não divulgar)
GOOGLE_PLACES_API_KEY=
LEADS_TERMS_VERSION=2026-09-v1

# Integração DentalPos One (mesmo valor de REVAH_SHARED_SECRET no DentalPos)
DENTALPOS_SHARED_SECRET=

# E-mails do sistema (recuperação de senha, convites)
# vazio = usa RESEND_API_KEY (a mesma chave do DentalPos)
REVAH_SYSTEM_RESEND_KEY=
REVAH_SYSTEM_EMAIL_FROM=REVAH <contato@dentalpos.com.br>
REVAH_ADMIN_NOTIFY_EMAIL=contato@dentalpos.com.br

# Fila
WORKER_BATCH_SIZE=25
CAMPAIGN_THROTTLE_MS=1500
# PLAN_LIMITS_JSON={"START":{"monthlyMessages":10000}}
